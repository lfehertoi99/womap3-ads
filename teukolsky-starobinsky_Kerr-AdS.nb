Cell[TextData[{
 "We start introducing some elements of notation, and defining the Teukolsky \
radial ODE operator  (",
 Cell[BoxData[
 "RadTeuk"], "InlineCode",ExpressionUUID->
  "6adcd165-0fbe-4e43-aacd-0f67282f5f0f"],
 ") , and the D_0 and D^{\\dagger}_0 operators (",
 Cell[BoxData[
 "D0"], "InlineCode",ExpressionUUID->"ccc0dbe0-7a96-4cb0-a801-4e55bb1e77dd"],
 " and ",
 Cell[BoxData[
 "D0dag"], "InlineCode",ExpressionUUID->
  "a65b541b-c9ef-4679-a60c-fced11c3313e"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "respectively):"
}], "Text",
 CellChangeTimes->{{3.971353602695912*^9, 3.971353837889338*^9}, {
   3.971356592721985*^9, 3.97135659404453*^9}, 
   3.971862239399194*^9},ExpressionUUID->"d723b018-984c-441a-ab7e-\
9eb994979f78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalXi]", ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"a", "^", "2"}], 
     RowBox[{"k", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "^", "2"}], "+", 
       RowBox[{"a", "^", "2"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"r", "^", "2"}], "*", 
        RowBox[{"k", "^", "2"}]}]}], ")"}]}], "-", 
    RowBox[{"2", "M", "*", "r"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V1", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalXi]", "^", "2"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Omega]", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "^", "2"}]}], "-", 
      RowBox[{"I", "*", "s", "*", "\[CapitalXi]", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Omega]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
         RowBox[{"a", "*", "m"}]}], ")"}], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V2", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{
    "4", "I", "*", "s", "*", "\[Omega]", "*", "\[CapitalXi]", "*", "r"}], "+", 
    RowBox[{"2", "*", 
     RowBox[{"k", "^", "2"}], 
     RowBox[{"(", 
      RowBox[{"\[Mu]", "+", 
       RowBox[{"3", "s"}], "+", 
       RowBox[{"2", 
        RowBox[{"s", "^", "2"}]}]}], ")"}], 
     RowBox[{"r", "^", "2"}]}], "+", 
    RowBox[{"s", "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"a", "^", "2"}], 
        RowBox[{"k", "^", "2"}]}]}], ")"}]}], "-", "\[Lambda]", "+", 
    RowBox[{"2", 
     RowBox[{"\[CapitalXi]", "^", "2"}], "*", "a", "*", "m", "*", 
     "\[Omega]"}], "-", 
    RowBox[{
     RowBox[{"a", "^", "2"}], "*", 
     RowBox[{"\[CapitalXi]", "^", "2"}], "*", 
     RowBox[{"\[Omega]", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RadTeuk", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"-", "s"}], ")"}]}], "*", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "+", "s"}], ")"}]}], "*", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", "r"}], "]"}]}], ",", "r"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"V1", "[", "r", "]"}], "*", "f"}], "+", 
    RowBox[{
     RowBox[{"V2", "[", "r", "]"}], "*", "f"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", ":=", "1"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D0", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"#", ",", "r"}], "]"}], "-", 
      RowBox[{"I", "*", 
       RowBox[{"\[CapitalXi]", "/", 
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Omega]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
         RowBox[{"a", "*", "m"}]}], ")"}], "*", "#"}]}], ")"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D0dag", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"#", ",", "r"}], "]"}], "+", 
      RowBox[{"I", "*", 
       RowBox[{"\[CapitalXi]", "/", 
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Omega]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
         RowBox[{"a", "*", "m"}]}], ")"}], "*", "#"}]}], ")"}], "&"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.971353372409181*^9, 3.971353373695492*^9}, 
   3.971353699388638*^9, {3.971862969258121*^9, 3.971863020635838*^9}, 
   3.971863076775662*^9, {3.971863117522936*^9, 3.971863254850091*^9}, {
   3.971863321424574*^9, 3.971863621372486*^9}, {3.9718639855354958`*^9, 
   3.971864013919441*^9}, {3.971864180368187*^9, 3.971864200883959*^9}, 
   3.971864602287944*^9, {3.971864639219041*^9, 3.971864639920691*^9}, {
   3.972214292714679*^9, 3.972214300168709*^9}, {3.9722162094160023`*^9, 
   3.972216269680838*^9}, {3.974271275988721*^9, 3.974271285975918*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a177157d-7a74-4e44-92d8-7d2a5723b8e1"],

Cell[TextData[{
 "Just as a check, we ask to see what the ",
 Cell[BoxData[
 "RadTeuk"], "InlineCode",ExpressionUUID->
  "d2585636-9e59-4eb4-95bf-117a7f869368"],
 "  operator looks like when applied to a function of ",
 Cell[BoxData[
 "r"], "InlineCode",ExpressionUUID->"675c65ac-e3bd-42d0-b07c-ca49ffbbc615"],
 " (this should give the Teukolsky radial ODE):"
}], "Text",
 CellChangeTimes->{{3.971353857247075*^9, 3.9713538653713493`*^9}, {

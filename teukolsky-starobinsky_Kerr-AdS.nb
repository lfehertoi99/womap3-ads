Cell[CellGroupData[{

Cell["The angular Teukolsky-Starobinsky constants on Kerr-AdS", "Subsection",
 CellChangeTimes->{{3.9713547130579576`*^9, 3.971354742850404*^9}, 
   3.9713565886234694`*^9, {3.9722170482323236`*^9, 
   3.972217051726368*^9}},ExpressionUUID->"4bb26252-a0e8-449d-8ca6-\
d8bf7c984766"],

Cell[TextData[{
 "We start defining the Teukolsky angular ODE operator . In this case, we \
will need to treat separately the case with positive and negative spin, so we \
will have two different angular Teukolsky ODE operators ",
 Cell[BoxData[
 "RadTeukPOS"], "InlineCode",ExpressionUUID->
  "86670525-962b-444f-884f-72f8c668fc43"],
 " (for positive spin) and RadTeukNEG (for negative spin). We also introduce \
the and the L_0 and L^{\\dagger}_0 operators (",
 Cell[BoxData[
 "L0"], "InlineCode",ExpressionUUID->"9e764dac-8938-4777-9eba-6926ffb35d03"],
 " an ",
 Cell[BoxData[
 "L0dag"], "InlineCode",ExpressionUUID->
  "9e815c96-ee98-4626-9dd0-74dbbfe36606"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "respectively):"
}], "Text",
 CellChangeTimes->{{3.9717043299530067`*^9, 3.971704491807611*^9}, {
  3.9717045867397747`*^9, 
  3.971704595828903*^9}},ExpressionUUID->"6ca1e2b6-10f2-41c7-8e5c-\
d61ef3620d2d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]_", "]"}], ":=",
    " ", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "*", "k", "*", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "^", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]", ":=", "1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9722182514787207`*^9, 3.972218374160309*^9}, {
  3.973061372922728*^9, 3.9730613880890408`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"0bb7b521-e04b-41c8-9ea1-bd9e8c33f0f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DiffTerm", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"f", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "2"}], "}"}]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], "*", 
      RowBox[{"Cot", "[", "\[Theta]", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"f", ",", " ", "\[Theta]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], 
        ",", " ", "\[Theta]"}], "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"f", ",", " ", "\[Theta]"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V1angPOS", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"2", "*", 
    RowBox[{"(", 
     RowBox[{"\[CapitalXi]", "-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}], "*", 
    RowBox[{"(", 
     RowBox[{"\[Mu]", "+", 
      RowBox[{"2", "*", 
       RowBox[{"s", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalXi]", "^", "2"}], ")"}], "*", "m", "*", "a", "*", 
       RowBox[{"\[Omega]", "/", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
         "]"}]}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V2angPOS", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalXi]", "*", "m"}], "+", 
          RowBox[{"s", "*", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"\[CapitalXi]", "-", 
             RowBox[{"2", "*", 
              RowBox[{"(", 
               RowBox[{"\[CapitalXi]", "-", "1"}], ")"}], "*", 
              RowBox[{
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], 
            ")"}]}]}], ")"}], ")"}], "^", "2"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], "*", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], ")"}]}], "-", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[CapitalXi]", "*", "a", "*", "\[Omega]"}], ")"}], "^", "2"}],
      "*", "\[CapitalXi]", "*", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}], "/", 
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
       "]"}]}]}], "+", 
    RowBox[{"2", "*", "a", "*", "\[Omega]", "*", "s", "*", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[CapitalXi]", "^", "2"}], ")"}], "/", 
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
       "]"}]}]}], "-", "\[Lambda]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AngTeukPOS", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{"DiffTerm", "[", "f", "]"}], "-", 
     RowBox[{
      RowBox[{"V1angPOS", "[", "\[Theta]", "]"}], "*", "f"}], "-", 
     RowBox[{
      RowBox[{"V2angPOS", "[", "\[Theta]", "]"}], "*", "f"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V1angNEG", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"V1angPOS", "[", "\[Theta]", "]"}], "/.", 
    RowBox[{"s", "->", 
     RowBox[{"-", "s"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V2angNEG", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"V2angPOS", "[", "\[Theta]", "]"}], "/.", 
    RowBox[{"s", "->", 
     RowBox[{"-", "s"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AngTeukNEG", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{"DiffTerm", "[", "f", "]"}], "-", 
     RowBox[{
      RowBox[{"V1angNEG", "[", "\[Theta]", "]"}], "*", "f"}], "-", 
     RowBox[{
      RowBox[{"V2angNEG", "[", "\[Theta]", "]"}], "*", "f"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L0", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"#", ",", "\[Theta]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalXi]", "/", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
          "]"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "/", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ")"}], "-", 
         RowBox[{"a", "*", "\[Omega]", "*", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}], "*", "#"}]}], 
     ")"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L0dag", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"#", ",", "\[Theta]"}], "]"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalXi]", "/", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
          "]"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "/", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ")"}], "-", 
         RowBox[{"a", "*", "\[Omega]", "*", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}], "*", "#"}]}], 
     ")"}], "&"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.972218866191689*^9, 3.972218880756322*^9}, {
   3.972218919169855*^9, 3.972219051498394*^9}, {3.972219122824695*^9, 
   3.972219191900083*^9}, 3.972219285417561*^9, {3.9722194458255377`*^9, 

Cell[TextData[{
 "Now we create the corresponding rules to substitute second derivatives of \
the function ",
 Cell[BoxData[
  RowBox[{"AA", "[", "\[Theta]", "]"}]], "InlineCode",ExpressionUUID->
  "21dcce0c-0062-4284-8e55-b70ce629ea94"],
 " (which should be thought of the solution to the Teukolsky angularODE), by \
the expression given by the angular ODE. Once again, we will need different \
rules for the positive and negative spin cases, since the angular ODE \
operators are different too:"
}], "Text",
 CellChangeTimes->{{3.97170464098322*^9, 3.971704699359864*^9}, {
  3.971704799319388*^9, 
  3.971704877805954*^9}},ExpressionUUID->"b2245065-f021-4f72-a143-\
eba7a6fa61ea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"AngTeukPOSRule", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"AngTeukPOS", "[", 
         RowBox[{"AA", "[", "\[Theta]", "]"}], "]"}]}], "/", 
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}]}],
       "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", "0"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AngTeukNEGRule", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"AngTeukNEG", "[", 
         RowBox[{"AA", "[", "\[Theta]", "]"}], "]"}]}], "/", 
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}]}],
       "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", "0"}]}], 
     "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971679744317829*^9, 3.971679798963274*^9}, {
  3.971679841399482*^9, 3.971679858453887*^9}, {3.9716800622082977`*^9, 
  3.971680071026758*^9}, {3.971703494014624*^9, 3.971703514817629*^9}, {
  3.971703630604836*^9, 3.97170363498132*^9}, {3.971860734317412*^9, 
  3.9718607510672083`*^9}, {3.9718619205595217`*^9, 3.9718619210225277`*^9}, {
  3.974037024200053*^9, 3.974037028277639*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"f010254b-113d-4f70-ae59-4e9ec2737b17"],

Cell[TextData[{
 "With these rules at hand, we are ready to define a function that computes \
the angular Teukolsky-Starobinsky identity and thus should return a \
constant*the angular solution. This function takes as argument the spin value \
for which we want to compute the Teukolsky-Starobinsky constant. The spin \
here can have either sign, and indeed the Teukolsky-Starobinsky identity one \
needs to compute will change with the spin sign (the sequence of operators \
changes). It is a nice safety check that we obtain the same value for the \
constant for ",
 Cell[BoxData[
 "s"], "InlineCode",ExpressionUUID->"f559d8b7-3991-46d4-819e-a47dc2d8a86a"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "s"}]], "InlineCode",ExpressionUUID->
  "c6e6a8a1-a045-4336-be4e-1f8f99552a0c"],
 "."
}], "Text",
 CellChangeTimes->{
  3.971679990921682*^9, 3.971682337351342*^9, {3.9717049043959913`*^9, 
   3.971704956586442*^9}, {3.9718622956546583`*^9, 
   3.9718623159638166`*^9}},ExpressionUUID->"cc9470dd-ec38-4f18-a1fd-\
be1318c8b9b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TSangPrep", "[", "S_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"output", "=", 
      RowBox[{"AA", "[", "\[Theta]", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"S", ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", 
           RowBox[{"1", "<=", "i", "<=", 
            RowBox[{"2", "*", "S"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"output", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"L0", "[", "output", "]"}], "+", 
                  RowBox[{"S", "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cot", "[", "\[Theta]", "]"}], "+", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "*", "k"}], ")"}], "^", "2"}], "*", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
                    RowBox[{
                    RowBox[{"Sin", "[", "\[Theta]", "]"}], "/", 
                    RowBox[{
                    SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", 
                    "\[Theta]", "]"}]}]}]}], ")"}], "*", "output"}]}], ")"}], 
                "/", 
                RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ")"}], "/.", 
              "AngTeukPOSRule"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"output", " ", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
                "]"}], "]"}]}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", "*", "S"}], ")"}]}], "*", "output"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", 
           RowBox[{"1", "<=", "i", "<=", 
            RowBox[{"2", "*", "S"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"output", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"L0dag", "[", "output", "]"}], "+", 

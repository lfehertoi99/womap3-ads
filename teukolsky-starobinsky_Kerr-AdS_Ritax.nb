        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}]}], ")"}], "3"], " ", 
       SuperscriptBox["x", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"], " ", 
        SuperscriptBox["x", "2"]}]}]]}], ")"}], " ", 
   RowBox[{"g", "[", "x", "]"}]}], "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["a", "2"], " ", 
   SuperscriptBox["k", "2"], " ", "x", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["g", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}], "-", 
  RowBox[{"2", " ", "x", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["k", "2"], " ", 
      SuperscriptBox["x", "2"]}]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["g", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["k", "2"], " ", 
      SuperscriptBox["x", "2"]}]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["g", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}]}]], "Output",

Cell[CellGroupData[{

Cell["The angular Teukolsky-Starobinsky constants on Kerr-AdS", "Subsection",
 CellChangeTimes->{{3.9713547130579576`*^9, 3.971354742850404*^9}, 
   3.9713565886234694`*^9, {3.972217048232324*^9, 
   3.972217051726368*^9}},ExpressionUUID->"4bb26252-a0e8-449d-8ca6-\
d8bf7c984766"],

Cell[TextData[{
 "We start defining the Teukolsky angular ODE operator . In this case, we \
will need to treat separately the case with positive and negative spin, so we \
will have two different angular Teukolsky ODE operators ",
 Cell[BoxData[
 "RadTeukPOS"], "InlineCode",ExpressionUUID->
  "86670525-962b-444f-884f-72f8c668fc43"],
 " (for positive spin) and RadTeukNEG (for negative spin). We also introduce \
the and the L_0 and L^{\\dagger}_0 operators (",
 Cell[BoxData[
 "L0"], "InlineCode",ExpressionUUID->"9e764dac-8938-4777-9eba-6926ffb35d03"],
 " an ",
 Cell[BoxData[
 "L0dag"], "InlineCode",ExpressionUUID->
  "9e815c96-ee98-4626-9dd0-74dbbfe36606"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "respectively):"
}], "Text",
 CellChangeTimes->{{3.9717043299530067`*^9, 3.971704491807611*^9}, {
  3.9717045867397747`*^9, 
  3.971704595828903*^9}},ExpressionUUID->"6ca1e2b6-10f2-41c7-8e5c-\
d61ef3620d2d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalXi]", ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"a", "^", "2"}], 
     RowBox[{"k", "^", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Theta]", "[", "x_", "]"}], ":=", " ", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "*", "k", "*", "x"}], ")"}], "^", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"w", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"x", "^", "2"}]}], ")"}], " ", 
    RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wp", "[", "x_", "]"}], ":=", " ", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"w", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", ":=", "1"}], ";"}]}], "Code",
 CellChangeTimes->{{3.97221825147872*^9, 3.972218374160309*^9}, {
   3.973061372922728*^9, 3.9730613880890408`*^9}, {3.980250434518055*^9, 
   3.980250435479887*^9}, {3.9802508620579157`*^9, 3.9802508639367943`*^9}, 
   3.9802509786112547`*^9, {3.980324282944828*^9, 3.980324284664276*^9}, {
   3.980324405349165*^9, 3.9803244275531597`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"0bb7b521-e04b-41c8-9ea1-bd9e8c33f0f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DiffTerm", "[", "f_", "]"}], ":=", 
    RowBox[{"D", "[", 

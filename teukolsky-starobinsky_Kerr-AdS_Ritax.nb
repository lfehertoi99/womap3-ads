Cell[TextData[{
 "With these rules at hand, we are ready to define a function that computes \
the angular Teukolsky-Starobinsky identity and thus should return a \
constant*the angular solution. This function takes as argument the spin value \
for which we want to compute the Teukolsky-Starobinsky constant. The spin \
here can have either sign, and indeed the Teukolsky-Starobinsky identity one \
needs to compute will change with the spin sign (the sequence of operators \
changes). It is a nice safety check that we obtain the same value for the \
constant for ",
 Cell[BoxData[
 "s"], "InlineCode",ExpressionUUID->"f559d8b7-3991-46d4-819e-a47dc2d8a86a"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "s"}]], "InlineCode",ExpressionUUID->
  "c6e6a8a1-a045-4336-be4e-1f8f99552a0c"],
 "."
}], "Text",
 CellChangeTimes->{
  3.971679990921682*^9, 3.971682337351342*^9, {3.9717049043959913`*^9, 
   3.971704956586442*^9}, {3.9718622956546583`*^9, 
   3.9718623159638166`*^9}},ExpressionUUID->"cc9470dd-ec38-4f18-a1fd-\
be1318c8b9b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"TSangPrep", "[", "S_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"output", "=", 
         RowBox[{"AA", "[", "x", "]"}]}], ",", "rule"}], "}"}], ",", "\n", 
      RowBox[{
       RowBox[{"rule", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"S", " ", ">", " ", "0"}], ",", " ", 
          RowBox[{"AngTeukPOSRule", "[", "S", "]"}], ",", " ", 
          RowBox[{"AngTeukNEGRule", "[", 
           RowBox[{"Abs", "[", "S", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"S", ">", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"1", "<=", "i", "<=", 
              RowBox[{"2", "*", "S"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"output", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"L0", "[", "output", "]"}], "+", 
                    RowBox[{"S", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"x", "/", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "*", "k"}], ")"}], "^", "2"}], "*", "x", " ", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}], "/", 
                    RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}]}]}]}], 
                    ")"}], "*", "output"}]}], ")"}], "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], ")"}], "/.", 
                "rule"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"output", " ", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"1", "-", 
                   RowBox[{"x", "^", "2"}]}], "]"}], "*", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}], "]"}]}],
                 ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"2", "*", "S"}], ")"}]}], "*", "output"}], " ", "//", 
             "Simplify"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"1", "<=", "i", "<=", 
              RowBox[{"2", "*", "S"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"output", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"L0dag", "[", "output", "]"}], "+", 
                    RowBox[{"S", "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"x", "/", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "*", "k"}], ")"}], "^", "2"}], "*", "x", " ", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}], "/", 
                    RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}]}]}]}], 
                    ")"}], "*", "output"}]}], ")"}], "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], ")"}], "/.", 
                "rule"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"output", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}], "*", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}], 
                   "]"}]}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"2", "*", "S"}], ")"}]}], "*", "output"}], "/.", 
              RowBox[{"s", "->", "S"}]}], "//", "Simplify"}]}], ";"}], 
          "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"1", "<=", "i", "<=", 
              RowBox[{"2", "*", 
               RowBox[{"(", 
                RowBox[{"-", "S"}], ")"}]}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"output", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"L0dag", "[", "output", "]"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "S"}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"x", "/", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "*", "k"}], ")"}], "^", "2"}], "*", "x", " ", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}], "/", 
                    RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}]}]}]}], 
                    ")"}], "*", "output"}]}], ")"}], "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], ")"}], "/.", 
                "rule"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"output", " ", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"1", "-", 
                   RowBox[{"x", "^", "2"}]}], "]"}], "*", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}], "]"}]}],
                 ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"2", "*", 
                 RowBox[{"(", 
                  RowBox[{"-", "S"}], ")"}]}], ")"}]}], "*", "output"}], "//",
              "Simplify"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"1", "<=", "i", "<=", 
              RowBox[{"2", "*", 
               RowBox[{"(", 
                RowBox[{"-", "S"}], ")"}]}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"output", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"L0", "[", "output", "]"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "S"}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"x", "/", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "*", "k"}], ")"}], "^", "2"}], "*", "x", " ", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}], "/", 
                    RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}]}]}]}], 
                    ")"}], "*", "output"}]}], ")"}], "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}]}], ")"}], "/.", 
                "rule"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"output", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "-", 
                    RowBox[{"x", "^", "2"}]}], "]"}], "*", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}], 
                   "]"}]}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"2", "*", 
                  RowBox[{"(", 
                   RowBox[{"-", "S"}], ")"}]}], ")"}]}], "*", "output"}], "/.", 
              RowBox[{"s", "->", 
               RowBox[{"(", 
                RowBox[{"-", "S"}], ")"}]}]}], "//", "Simplify"}]}], ";"}], 
          "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Simplify", "[", "output", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Repeat", " ", "above", " ", "but", " ", "with", " ", 
    RowBox[{"`Do", "'"}], " ", "instead", " ", "of", " ", 
    RowBox[{"`For", "'"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TSangPrep", "[", "S_", "]"}], " ", ":=", " ", 

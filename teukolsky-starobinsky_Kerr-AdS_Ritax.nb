Cell[BoxData[
 RowBox[{"RadTeuk", "[", 
  RowBox[{"g", "[", "r", "]"}], "]"}]], "Code",
 CellChangeTimes->{{3.971343590617917*^9, 3.971343622575437*^9}, {

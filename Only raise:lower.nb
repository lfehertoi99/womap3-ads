Cell[BoxData[
 RowBox[{
  RowBox[{"TSradRaise", "[", 
   RowBox[{"S_", ",", "f_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"output", ",", 
      RowBox[{"Sp", "=", 
       RowBox[{"Abs", "[", "S", "]"}]}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"output", "=", "f"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"1", "<=", "i", "<=", 
        RowBox[{"2", "*", 
         RowBox[{"(", "Sp", ")"}]}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"output", "=", 
         RowBox[{
          RowBox[{"D0", "[", "output", "]"}], "/.", "RadTeukRule"}]}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 

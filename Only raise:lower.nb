Cell[CellGroupData[{

Cell["The angular Teukolsky-Starobinsky constants on Kerr-AdS", "Subsection",
 CellChangeTimes->{{3.9713547130579576`*^9, 3.971354742850404*^9}, 
   3.9713565886234694`*^9, {3.9722170482323236`*^9, 
   3.972217051726368*^9}},ExpressionUUID->"4bb26252-a0e8-449d-8ca6-\
d8bf7c984766"],

Cell[TextData[{
 "We start defining the Teukolsky angular ODE operator . In this case, we \
will need to treat separately the case with positive and negative spin, so we \
will have two different angular Teukolsky ODE operators ",
 Cell[BoxData[
 "RadTeukPOS"], "InlineCode",ExpressionUUID->
  "86670525-962b-444f-884f-72f8c668fc43"],
 " (for positive spin) and RadTeukNEG (for negative spin). We also introduce \
the and the L_0 and L^{\\dagger}_0 operators (",
 Cell[BoxData[
 "L0"], "InlineCode",ExpressionUUID->"9e764dac-8938-4777-9eba-6926ffb35d03"],
 " an ",
 Cell[BoxData[
 "L0dag"], "InlineCode",ExpressionUUID->
  "9e815c96-ee98-4626-9dd0-74dbbfe36606"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "respectively):"
}], "Text",
 CellChangeTimes->{{3.9717043299530067`*^9, 3.971704491807611*^9}, {
  3.9717045867397747`*^9, 
  3.971704595828903*^9}},ExpressionUUID->"6ca1e2b6-10f2-41c7-8e5c-\
d61ef3620d2d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]_", "]"}], ":=",
    " ", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "*", "k", "*", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "^", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]", ":=", "1"}], ";"}]}], "Code",
 CellChangeTimes->{{3.9722182514787207`*^9, 3.972218374160309*^9}, {
  3.973061372922728*^9, 3.9730613880890408`*^9}},
 CellLabel->
  "In[204]:=",ExpressionUUID->"0bb7b521-e04b-41c8-9ea1-bd9e8c33f0f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DiffTerm", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"f", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "2"}], "}"}]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], "*", 
      RowBox[{"Cot", "[", "\[Theta]", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"f", ",", " ", "\[Theta]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], 
        ",", " ", "\[Theta]"}], "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"f", ",", " ", "\[Theta]"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V1angPOS", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"2", "*", 
    RowBox[{"(", 
     RowBox[{"\[CapitalXi]", "-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}], "*", 
    RowBox[{"(", 
     RowBox[{"\[Mu]", "+", 
      RowBox[{"2", "*", 
       RowBox[{"s", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalXi]", "^", "2"}], ")"}], "*", "m", "*", "a", "*", 
       RowBox[{"\[Omega]", "/", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
         "]"}]}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V2angPOS", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalXi]", "*", "m"}], "+", 
          RowBox[{"s", "*", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"\[CapitalXi]", "-", 
             RowBox[{"2", "*", 
              RowBox[{"(", 
               RowBox[{"\[CapitalXi]", "-", "1"}], ")"}], "*", 
              RowBox[{
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], 
            ")"}]}]}], ")"}], ")"}], "^", "2"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}], "*", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], ")"}]}], "-", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[CapitalXi]", "*", "a", "*", "\[Omega]"}], ")"}], "^", "2"}],
      "*", "\[CapitalXi]", "*", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}], "/", 
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
       "]"}]}]}], "+", 
    RowBox[{"2", "*", "a", "*", "\[Omega]", "*", "s", "*", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[CapitalXi]", "^", "2"}], ")"}], "/", 
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
       "]"}]}]}], "-", "\[Lambda]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AngTeukPOS", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{"DiffTerm", "[", "f", "]"}], "-", 
     RowBox[{
      RowBox[{"V1angPOS", "[", "\[Theta]", "]"}], "*", "f"}], "-", 
     RowBox[{
      RowBox[{"V2angPOS", "[", "\[Theta]", "]"}], "*", "f"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V1angNEG", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"V1angPOS", "[", "\[Theta]", "]"}], "/.", 
    RowBox[{"s", "->", 
     RowBox[{"-", "s"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V2angNEG", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"V2angPOS", "[", "\[Theta]", "]"}], "/.", 
    RowBox[{"s", "->", 
     RowBox[{"-", "s"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AngTeukNEG", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{"DiffTerm", "[", "f", "]"}], "-", 
     RowBox[{
      RowBox[{"V1angNEG", "[", "\[Theta]", "]"}], "*", "f"}], "-", 
     RowBox[{
      RowBox[{"V2angNEG", "[", "\[Theta]", "]"}], "*", "f"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L0", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"#", ",", "\[Theta]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalXi]", "/", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
          "]"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "/", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ")"}], "-", 
         RowBox[{"a", "*", "\[Omega]", "*", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}], "*", "#"}]}], 
     ")"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L0dag", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"#", ",", "\[Theta]"}], "]"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalXi]", "/", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", 
          "]"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "/", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ")"}], "-", 
         RowBox[{"a", "*", "\[Omega]", "*", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}], "*", "#"}]}], 
     ")"}], "&"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.972218866191689*^9, 3.972218880756322*^9}, {
   3.972218919169855*^9, 3.972219051498394*^9}, {3.972219122824695*^9, 
   3.972219191900083*^9}, 3.972219285417561*^9, {3.9722194458255377`*^9, 
   3.972219490571251*^9}, {3.972221160135838*^9, 3.972221169319859*^9}, {
   3.972221202644225*^9, 3.972221203696348*^9}, {3.9722216173459597`*^9, 
   3.972221664954845*^9}, 3.973070900609171*^9, {3.973071654487401*^9, 
   3.9730716630973053`*^9}, {3.973071870963518*^9, 3.973071872687418*^9}, 
   3.9730851494352283`*^9, {3.973085373258032*^9, 3.97308537526702*^9}, {
   3.973846574341547*^9, 3.9738465824060707`*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"1b55f72d-9111-4645-9b88-f9f6e67bb03e"],

Cell[TextData[{
 "Now we create the corresponding rules to substitute second derivatives of \
the function ",
 Cell[BoxData[
  RowBox[{"AA", "[", "\[Theta]", "]"}]], "InlineCode",ExpressionUUID->
  "21dcce0c-0062-4284-8e55-b70ce629ea94"],
 " (which should be thought of the solution to the Teukolsky angularODE), by \
the expression given by the angular ODE. Once again, we will need different \
rules for the positive and negative spin cases, since the angular ODE \
operators are different too:"
}], "Text",
 CellChangeTimes->{{3.97170464098322*^9, 3.971704699359864*^9}, {
  3.971704799319388*^9, 
  3.971704877805954*^9}},ExpressionUUID->"b2245065-f021-4f72-a143-\
eba7a6fa61ea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"AngTeukPOSRule", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"AngTeukPOS", "[", 
         RowBox[{"AA", "[", "\[Theta]", "]"}], "]"}]}], "/", 
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}]}],
       "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", "0"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AngTeukNEGRule", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"AngTeukNEG", "[", 
         RowBox[{"AA", "[", "\[Theta]", "]"}], "]"}]}], "/", 
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "\[Theta]"], "[", "\[Theta]", "]"}]}],
       "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"AA", "''"}], "[", "\[Theta]", "]"}], "->", "0"}]}], 
     "]"}]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.971679744317829*^9, 3.971679798963274*^9}, {
  3.971679841399482*^9, 3.971679858453887*^9}, {3.9716800622082977`*^9, 
  3.971680071026758*^9}, {3.971703494014624*^9, 3.971703514817629*^9}, {
  3.971703630604836*^9, 3.97170363498132*^9}, {3.971860734317412*^9, 
  3.9718607510672083`*^9}, {3.9718619205595217`*^9, 3.9718619210225277`*^9}, {
  3.974037024200053*^9, 3.974037028277639*^9}},
 CellLabel->
  "In[215]:=",ExpressionUUID->"f010254b-113d-4f70-ae59-4e9ec2737b17"],

Cell[TextData[{
 "With these rules at hand, we are ready to define a function that computes \
the angular Teukolsky-Starobinsky identity and thus should return a \
constant*the angular solution. This function takes as argument the spin value \
for which we want to compute the Teukolsky-Starobinsky constant. The spin \
here can have either sign, and indeed the Teukolsky-Starobinsky identity one \
needs to compute will change with the spin sign (the sequence of operators \
changes). It is a nice safety check that we obtain the same value for the \
constant for ",
 Cell[BoxData[
 "s"], "InlineCode",ExpressionUUID->"f559d8b7-3991-46d4-819e-a47dc2d8a86a"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "s"}]], "InlineCode",ExpressionUUID->
  "c6e6a8a1-a045-4336-be4e-1f8f99552a0c"],
 "."
}], "Text",
 CellChangeTimes->{
  3.971679990921682*^9, 3.971682337351342*^9, {3.9717049043959913`*^9, 
   3.971704956586442*^9}, {3.9718622956546583`*^9, 
   3.9718623159638166`*^9}},ExpressionUUID->"cc9470dd-ec38-4f18-a1fd-\
be1318c8b9b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TSangPrep", "[", "S_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"output", "=", 
      RowBox[{"AA", "[", "\[Theta]", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"S", ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", 
           RowBox[{"1", "<=", "i", "<=", 
            RowBox[{"2", "*", "S"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{

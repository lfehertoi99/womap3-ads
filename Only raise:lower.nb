        SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}], " ", 
  RowBox[{"RR", "[", "r", "]"}]}]], "Output",
 CellChangeTimes->{
  3.9741391117661343`*^9, 3.9742712359266253`*^9, 3.974271302166545*^9, 

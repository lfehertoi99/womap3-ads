Cell["Radial spin raising and lowering operators", "Subsection",
 CellChangeTimes->{{3.971353478255114*^9, 3.971353513566207*^9}, {
   3.9713535441478643`*^9, 3.971353593205736*^9}, 3.971353876605164*^9, 

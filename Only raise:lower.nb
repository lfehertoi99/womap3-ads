       RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], ")"}]}], ")"}], "/.", 
   RowBox[{"s", "->", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",

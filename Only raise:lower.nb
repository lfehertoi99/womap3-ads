11b6e82d2480"],

Cell[TextData[{
 "We start introducing some elements of notation, and defining the Teukolsky \
radial ODE operator  (",
 Cell[BoxData[
 "RadTeuk"], "InlineCode",ExpressionUUID->
  "6adcd165-0fbe-4e43-aacd-0f67282f5f0f"],
 ") , and the D_0 and D^{\\dagger}_0 operators (",
 Cell[BoxData[
 "D0"], "InlineCode",ExpressionUUID->"ccc0dbe0-7a96-4cb0-a801-4e55bb1e77dd"],
 " and ",
 Cell[BoxData[
 "D0dag"], "InlineCode",ExpressionUUID->
  "a65b541b-c9ef-4679-a60c-fced11c3313e"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "respectively):"
}], "Text",
 CellChangeTimes->{{3.971353602695912*^9, 3.971353837889338*^9}, {
   3.971356592721985*^9, 3.97135659404453*^9}, 
   3.971862239399194*^9},ExpressionUUID->"d723b018-984c-441a-ab7e-\
9eb994979f78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalXi]", ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"a", "^", "2"}], 
     RowBox[{"k", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "^", "2"}], "+", 
       RowBox[{"a", "^", "2"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"r", "^", "2"}], "*", 
        RowBox[{"k", "^", "2"}]}]}], ")"}]}], "-", 
    RowBox[{"2", "M", "*", "r"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V1", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalXi]", "^", "2"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Omega]", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "^", "2"}]}], "-", 
      RowBox[{"I", "*", "s", "*", "\[CapitalXi]", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Omega]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
         RowBox[{"a", "*", "m"}]}], ")"}], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V2", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{
    "4", "I", "*", "s", "*", "\[Omega]", "*", "\[CapitalXi]", "*", "r"}], "+", 
    RowBox[{"2", "*", 
     RowBox[{"k", "^", "2"}], 
     RowBox[{"(", 
      RowBox[{"\[Mu]", "+", 
       RowBox[{"3", "s"}], "+", 
       RowBox[{"2", 
        RowBox[{"s", "^", "2"}]}]}], ")"}], 
     RowBox[{"r", "^", "2"}]}], "+", 
    RowBox[{"s", "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"a", "^", "2"}], 
        RowBox[{"k", "^", "2"}]}]}], ")"}]}], "-", "\[Lambda]", "+", 
    RowBox[{"2", 
     RowBox[{"\[CapitalXi]", "^", "2"}], "*", "a", "*", "m", "*", 
     "\[Omega]"}], "-", 
    RowBox[{
     RowBox[{"a", "^", "2"}], "*", 
     RowBox[{"\[CapitalXi]", "^", "2"}], "*", 
     RowBox[{"\[Omega]", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RadTeuk", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"-", "s"}], ")"}]}], "*", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "+", "s"}], ")"}]}], "*", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", "r"}], "]"}]}], ",", "r"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"V1", "[", "r", "]"}], "*", "f"}], "+", 
    RowBox[{
     RowBox[{"V2", "[", "r", "]"}], "*", "f"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", ":=", "1"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D0", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"#", ",", "r"}], "]"}], "-", 
       RowBox[{"I", "*", 
        RowBox[{"\[CapitalXi]", "/", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Omega]", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "*", "#"}]}], ")"}], "&"}]}], 
   ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"spin", "-", "raising"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D0dag", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"#", ",", "r"}], "]"}], "+", 
       RowBox[{"I", "*", 
        RowBox[{"\[CapitalXi]", "/", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Omega]", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "*", "#"}]}], ")"}], "&"}]}], 
   ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"spin", "-", "lowering"}], "*)"}]}]}], "Code",
 CellChangeTimes->{{3.971353372409181*^9, 3.971353373695492*^9}, 
   3.971353699388638*^9, {3.971862969258121*^9, 3.971863020635838*^9}, 
   3.971863076775662*^9, {3.971863117522936*^9, 3.971863254850091*^9}, {
   3.971863321424574*^9, 3.971863621372486*^9}, {3.9718639855354958`*^9, 
   3.971864013919441*^9}, {3.971864180368187*^9, 3.971864200883959*^9}, 
   3.971864602287944*^9, {3.971864639219041*^9, 3.971864639920691*^9}, {
   3.972214292714679*^9, 3.972214300168709*^9}, {3.9722162094160023`*^9, 
   3.972216269680838*^9}, {3.974271275988721*^9, 3.974271285975918*^9}, {
   3.981381018869237*^9, 3.9813810354411507`*^9}, {3.9813810748925467`*^9, 
   3.981381086750263*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a177157d-7a74-4e44-92d8-7d2a5723b8e1"],

Cell[TextData[{
 "We introduce now the operators that \[OpenCurlyDoubleQuote]flip\
\[CloseCurlyDoubleQuote] the spin: for a solution to the radial ODE with spin \
s>0, apply ",
 Cell[BoxData[
 "TSradLower"], "InlineCode",ExpressionUUID->
  "8caca894-22cc-47fc-a0a2-d2f302ead080"],
 " to obtain a solution to the radial ODE with spin -s<0; for a solution to \
the radial ODE with spin s<0, apply ",
 Cell[BoxData[
 "TSradRaise"], "InlineCode",ExpressionUUID->
  "951c089f-a3a6-4d11-afac-93a3b2f9c5c5"],
 " to obtain a solution to the radial ODE with spin -s>0. The arguments of \
these functions are spin value and the function over which we want to apply \
the operators. "
}], "Text",
 CellChangeTimes->{{3.981388972952211*^9, 3.9813891687847137`*^9}, {
  3.981389746177356*^9, 
  3.981389778621207*^9}},ExpressionUUID->"d7e9c461-de22-45ab-aecd-\
93f14f5e8df2"],

Cell["\<\
As a sanity check, we  would like to compute the TS constants applying both \
operators one after the other (in the appropriate order according to the spin \
value) and imposing that the function to which we are applying the operators \
satisfies the radial ODE, which we can do using the following rule: \
\>", "Text",
 CellChangeTimes->{{3.981389775944343*^9, 
  3.981389819446978*^9}},ExpressionUUID->"08201edb-4606-4ad1-9652-\
387b693b3bae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RadTeukRule", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RR", "''"}], "[", "r", "]"}], "->", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"RadTeuk", "[", 
         RowBox[{"RR", "[", "r", "]"}], "]"}]}], "/", 
       RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"RR", "''"}], "[", "r", "]"}], "->", "0"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[199]:=",ExpressionUUID->"d0197664-d1e8-4c79-83b9-59cf74f425e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TSradLower", "[", 
   RowBox[{"S_", ",", "f_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"output", ",", 
      RowBox[{"Sp", "=", 
       RowBox[{"Abs", "[", "S", "]"}]}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"output", "=", "f"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"1", "<=", "i", "<=", 
        RowBox[{"2", "*", "Sp"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"output", "=", 
         RowBox[{
          RowBox[{"D0dag", "[", "output", "]"}], "/.", "RadTeukRule"}]}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"output", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}], "^", "Sp"}], "*", 
       "output"}]}], ";", "\n", 
     RowBox[{"Simplify", "[", "output", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.9713436696698914`*^9, 3.971343735678232*^9}, 

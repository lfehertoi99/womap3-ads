Cell[CellGroupData[{
Cell["Angular ODE: spin raising/lowering 2s times at x=1", "Title",
 CellChangeTimes->{{3.9847984490535145`*^9, 3.984798499850605*^9}, {
  3.9850785784669304`*^9, 3.985078608580473*^9}, {3.985159840252798*^9, 
  3.9851598423989353`*^9}},ExpressionUUID->"f2b915b8-3954-3242-8366-\
576f899d4312"],

Cell[CellGroupData[{

Cell["Expansion of spin raising /lowering operators", "Section",
 CellChangeTimes->{{3.985078526441988*^9, 3.985078540540991*^9}, {
  3.985159845483364*^9, 
  3.9851598531906223`*^9}},ExpressionUUID->"5751f222-8dc9-df44-ac71-\
2c4ad64b7751"],

Cell["Firstly, recall that the operators look like this:  ", "Text",
 CellChangeTimes->{{3.9850648662688026`*^9, 3.9850650053084774`*^9}, {
  3.985065220018097*^9, 
  3.9850652324101276`*^9}},ExpressionUUID->"d25f8d9c-97a0-2a46-bfbe-\
59d4be5e7a69"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}], "\n", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}]}], "Text",
 CellChangeTimes->{{3.981783547808112*^9, 3.981783676409051*^9}, {
  3.981786079998436*^9, 3.981786082213542*^9}, {3.981797064465685*^9, 
  3.981797067385528*^9}},ExpressionUUID->"554007c3-5607-bb43-a9db-\
eb24a8307f68"]], "Text",
 CellChangeTimes->{{3.9850652373558865`*^9, 
  3.9850652409425697`*^9}},ExpressionUUID->"712580d9-17f0-1f47-a595-\
08580e4bfa6e"],

Cell["Since what we want to apply repeatedly is ", "Text",
 CellChangeTimes->{{3.9850652463759193`*^9, 
  3.9850652494589977`*^9}},ExpressionUUID->"93953d00-76b9-eb40-853a-\
b7432a59de93"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  FractionBox["Lplus", 
   RowBox[{"Sin", "[", "\[Theta]", "]"}]], "=", 
  RowBox[{
   RowBox[{
    FractionBox["Lplus", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]], "        ", "or", "         ", 
    FractionBox["Lminus", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]]}], "=", 
   FractionBox["Lminus", 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["x", "2"]}]]]}]}]], "Text",
 CellChangeTimes->{{3.9817837581531963`*^9, 
  3.98178382239657*^9}},ExpressionUUID->"4f2247bd-b5ff-dd49-80f4-\
9a2ca805161d"]], "Text",
 CellChangeTimes->{{3.985065254686611*^9, 
  3.9850652579892826`*^9}},ExpressionUUID->"78655297-84b6-fa40-b091-\
fea63576295a"],

Cell["\<\
We will work (computationally) with the renormalised operators. where we now \
include the derivative term:\
\>", "Text",
 CellChangeTimes->{{3.9850652623266983`*^9, 
  3.985065264986702*^9}},ExpressionUUID->"212d032a-241c-3b4f-93c0-\
7a7ee100a414"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}]}], "Text",
 CellChangeTimes->{{3.9817839028112392`*^9, 3.9817839285593576`*^9}, {
  3.981786261883848*^9, 3.9817862639400682`*^9}, {3.981797077438373*^9, 
  3.981797096430489*^9}},ExpressionUUID->"29a17e8b-7b20-3e4d-899a-\
5935a073b4bf"]], "Text",
 CellChangeTimes->{{3.985065270280943*^9, 
  3.9850652737887745`*^9}},ExpressionUUID->"ba475202-7d35-dd4a-a1dc-\
0f6b3223f811"],

Cell["\<\
NOTE THAT THE MINUS OPERATOR RAISES THE SPIN AND THE PLUS OPERATOR LOWERS THE \
SPIN.\
\>", "Text",
 CellChangeTimes->{{3.985156188971203*^9, 
  3.985156205030262*^9}},ExpressionUUID->"9229f763-2bb9-ad48-a803-\
f4a8c6659cc6"],

Cell["\<\
Now, we want to compute the expansions of these operators near x=1 and x=-1. \
Since the derivative term is of 0th order in x, as far as the expansions are \
concerned, we only need to consider \
\>", "Text",
 CellChangeTimes->{
  3.9850652780954456`*^9},ExpressionUUID->"06c0cf14-79cf-0a41-acda-\
7b1658122b06"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"Lplus", ",", "Lminus"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lplus", "[", 
    RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"]}]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"n", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminus", "[", 
    RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"n", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.981783946242859*^9, 3.981783975318748*^9}, {
  3.981785464292274*^9, 3.981785508449151*^9}, {3.981786268601119*^9, 
  3.981786270435828*^9}, {3.9817864510815077`*^9, 3.981786479650158*^9}, {
  3.981788690484048*^9, 3.981788696319776*^9}, {3.981797099419589*^9, 
  3.98179710264193*^9}, {3.98199039390654*^9, 3.9819904244803867`*^9}, {
  3.98199045539818*^9, 3.9819904565252533`*^9}, {3.9859443904049644`*^9, 
  3.985944410636242*^9}, {3.985946724114273*^9, 3.985946726798132*^9}, {
  3.985946797047308*^9, 3.9859468073324375`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"f24befff-e17f-0d4f-ab00-2c3797693fe7"],

Cell["which we expand using the following module:", "Text",
 CellChangeTimes->{{3.985065022328207*^9, 3.9850650296938744`*^9}, {
  3.98594612303673*^9, 
  3.9859461317535095`*^9}},ExpressionUUID->"fd3084e8-f3c7-7444-a4ce-\
4085ecc0db96"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "OperatorCoefficientList", "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "a", " ", "function", " ", "that", " ", "extracts", " ", "the", " ", 
     "coefficients", " ", "in", " ", "the", " ", "expansion", " ", "of", " ", 
     "the", " ", "spin", " ", "raising", " ", "and", " ", "lowering", " ", 
     "operators"}], ",", " ", 
    RowBox[{
     RowBox[{
     "and", " ", "flips", " ", "the", " ", "sign", " ", "for", " ", "x"}], "=",
      "1"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"OperatorCoefficientList", "[", 
   RowBox[{"F_", ",", " ", "x_", ",", " ", "x0_", ",", " ", "max_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "i", "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x0", " ", "==", " ", "1"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", "i"}], ",", " ", "1"}], "]"}], 
        " ", "*", " ", 
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{"F", ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "x0", ",", " ", "i"}], "}"}]}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "max"}], "}"}]}], "\n", "  ", "]"}], 
     "]"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9859443438359184`*^9, 3.9859443851887665`*^9}, {
   3.985944422186575*^9, 3.985944442455391*^9}, {3.9859445483058815`*^9, 
   3.985944548473675*^9}, {3.9859445863577785`*^9, 3.9859445879064445`*^9}, {
   3.9859446228265953`*^9, 3.985944635607939*^9}, {3.9859446946161957`*^9, 
   3.9859447114420223`*^9}, {3.9859447523787575`*^9, 
   3.9859447758753567`*^9}, {3.985945065983959*^9, 3.985945074500412*^9}, {
   3.9859453895038357`*^9, 3.985945623610239*^9}, 3.9859456995131245`*^9, {
   3.9859459420995197`*^9, 3.9859459706312733`*^9}, {3.9859461040030785`*^9, 
   3.9859461088189125`*^9}, {3.985946286621483*^9, 3.9859463348067493`*^9}, {
   3.985946412024767*^9, 3.985946466275549*^9}, {3.98594674374498*^9, 
   3.9859467682476215`*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"94ce3d0f-6932-ad46-82e1-56d3f28c579f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "compute", " ", "these", " ", "to", " ", "check", " ", "that", " ", "they",
     " ", "make", " ", "sense"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lplus", "[", 
       RowBox[{"x", ",", "n"}], "]"}], ",", "x", ",", " ", "1", ",", "2"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lminus", "[", 
       RowBox[{"x", ",", "n"}], "]"}], ",", "x", ",", " ", "1", ",", "2"}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9859455400909824`*^9, 3.985945549276245*^9}, {
  3.985945628911381*^9, 3.985945651477564*^9}, {3.985945705861429*^9, 
  3.9859457423296432`*^9}, {3.9859459826492157`*^9, 3.98594598451581*^9}, {
  3.985946047834099*^9, 3.985946052968748*^9}, {3.9859466759798107`*^9, 

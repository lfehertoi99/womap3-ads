Cell[CellGroupData[{

Cell["Raising the spin from -s to +s", "Section",
 CellChangeTimes->{{3.9847985608526745`*^9, 3.984798578165249*^9}, {
  3.985065849820223*^9, 3.985065855944498*^9}, {3.9850678191945686`*^9, 
  3.9850678386297264`*^9}},ExpressionUUID->"22d1354d-3a71-4849-8513-\
ae946990bc34"],

Cell[CellGroupData[{

Cell["Applying the spin raising operator ONCE", "Subsection",
 CellChangeTimes->{
  3.985065847440489*^9, {3.985079653441633*^9, 
   3.9850796539334335`*^9}},ExpressionUUID->"4fa329f6-4485-d143-9733-\
4d993f3543d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ApplyRaisingOperator", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ApplyRaisingOperator", "[", 
   RowBox[{"coeffs_", ",", "sigma_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "c0", ",", "c1", ",", "derCoeffs", ",", "singCoeffs", ",", "regCoeffs", ",",
       "newC0", ",", "newC1", ",", "newSigma"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"c0", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"c1", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"effect", " ", "of"}], " ", "-", 
       RowBox[{"d", "/", "dx"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"derCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "sigma"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"sigma", "+", "1"}], ")"}]}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "singular", " ", "term"}], " ", 
      "*)"}], "\n", "\t", 
     RowBox[{"singCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"RSingCoeff", "[", "n", "]"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"RSingCoeff", "[", "n", "]"}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "regular", " ", "term"}], " ", "*)"}],
      "\n", "\t", 
     RowBox[{"regCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"R0Coeff", "[", "n", "]"}], "*", "c0"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "exponent"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"newSigma", "=", 
      RowBox[{"sigma", "-", "1"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "coefficient"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"newC0", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"new", " ", "sub"}], "-", 
       RowBox[{"leading", " ", "coefficient"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"newC1", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"regCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"newC0", ",", "newC1"}], "}"}], ",", "newSigma"}], "}"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.9847978411479263`*^9, 3.984797984043974*^9}, {
   3.9847983847333813`*^9, 3.9847983889050465`*^9}, {3.9848005424235687`*^9, 
   3.984800554767416*^9}, 3.985065466848425*^9, {3.985065548066326*^9, 
   3.9850655787271385`*^9}, {3.9850656144923744`*^9, 3.985065619239092*^9}, {
   3.985067826118387*^9, 3.9850678523175583`*^9}, {3.9850795679918747`*^9, 
   3.985079570186735*^9}, {3.985159280518669*^9, 
   3.9851593084103565`*^9}},ExpressionUUID->"e467c630-1cf2-5447-9bf9-\
b5685c594087"]

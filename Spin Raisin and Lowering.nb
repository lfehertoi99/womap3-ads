Notebook[{

Cell[CellGroupData[{
Cell["Angular ODE: spin raising/lowering 2s times at x=1", "Title",
 CellChangeTimes->{{3.9847984490535145`*^9, 3.984798499850605*^9}, {
  3.9850785784669304`*^9, 3.985078608580473*^9}, {3.985159840252798*^9, 
  3.9851598423989353`*^9}},ExpressionUUID->"f2b915b8-3954-3242-8366-\
576f899d4312"],

Cell[CellGroupData[{

Cell["Expansion of spin raising /lowering operators", "Section",
 CellChangeTimes->{{3.985078526441988*^9, 3.985078540540991*^9}, {
  3.985159845483364*^9, 
  3.9851598531906223`*^9}},ExpressionUUID->"5751f222-8dc9-df44-ac71-\
2c4ad64b7751"],

Cell["Firstly, recall that the operators look like this:  ", "Text",
 CellChangeTimes->{{3.9850648662688026`*^9, 3.9850650053084774`*^9}, {
  3.985065220018097*^9, 
  3.9850652324101276`*^9}},ExpressionUUID->"d25f8d9c-97a0-2a46-bfbe-\
59d4be5e7a69"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}], "\n", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}]}], "Text",
 CellChangeTimes->{{3.981783547808112*^9, 3.981783676409051*^9}, {
  3.981786079998436*^9, 3.981786082213542*^9}, {3.981797064465685*^9, 
  3.981797067385528*^9}},ExpressionUUID->"554007c3-5607-bb43-a9db-\
eb24a8307f68"]], "Text",
 CellChangeTimes->{{3.9850652373558865`*^9, 
  3.9850652409425697`*^9}},ExpressionUUID->"712580d9-17f0-1f47-a595-\
08580e4bfa6e"],

Cell["Since what we want to apply repeatedly is ", "Text",
 CellChangeTimes->{{3.9850652463759193`*^9, 
  3.9850652494589977`*^9}},ExpressionUUID->"93953d00-76b9-eb40-853a-\
b7432a59de93"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  FractionBox["Lplus", 
   RowBox[{"Sin", "[", "\[Theta]", "]"}]], "=", 
  RowBox[{
   RowBox[{
    FractionBox["Lplus", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]], "        ", "or", "         ", 
    FractionBox["Lminus", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]]}], "=", 
   FractionBox["Lminus", 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["x", "2"]}]]]}]}]], "Text",
 CellChangeTimes->{{3.9817837581531963`*^9, 
  3.98178382239657*^9}},ExpressionUUID->"4f2247bd-b5ff-dd49-80f4-\
9a2ca805161d"]], "Text",
 CellChangeTimes->{{3.985065254686611*^9, 
  3.9850652579892826`*^9}},ExpressionUUID->"78655297-84b6-fa40-b091-\
fea63576295a"],

Cell["\<\
We will work (computationally) with the renormalised operators. where we now \
include the derivative term:\
\>", "Text",
 CellChangeTimes->{{3.9850652623266983`*^9, 
  3.985065264986702*^9}},ExpressionUUID->"212d032a-241c-3b4f-93c0-\
7a7ee100a414"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}]}], "Text",
 CellChangeTimes->{{3.9817839028112392`*^9, 3.9817839285593576`*^9}, {
  3.981786261883848*^9, 3.9817862639400682`*^9}, {3.981797077438373*^9, 
  3.981797096430489*^9}},ExpressionUUID->"29a17e8b-7b20-3e4d-899a-\
5935a073b4bf"]], "Text",
 CellChangeTimes->{{3.985065270280943*^9, 
  3.9850652737887745`*^9}},ExpressionUUID->"ba475202-7d35-dd4a-a1dc-\
0f6b3223f811"],

Cell["\<\
NOTE THAT THE MINUS OPERATOR RAISES THE SPIN AND THE PLUS OPERATOR LOWERS THE \
SPIN.\
\>", "Text",
 CellChangeTimes->{{3.985156188971203*^9, 
  3.985156205030262*^9}},ExpressionUUID->"9229f763-2bb9-ad48-a803-\
f4a8c6659cc6"],

Cell["\<\
Now, we want to compute the expansions of these operators near x=1 and x=-1. \
Since the derivative term is of 0th order in x, as far as the expansions are \
concerned, we only need to consider \
\>", "Text",
 CellChangeTimes->{
  3.9850652780954456`*^9},ExpressionUUID->"06c0cf14-79cf-0a41-acda-\
7b1658122b06"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"Lplus", ",", "Lminus"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lplus", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"]}]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"n", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminus", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"n", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.981783946242859*^9, 3.981783975318748*^9}, {
  3.981785464292274*^9, 3.981785508449151*^9}, {3.981786268601119*^9, 
  3.981786270435828*^9}, {3.9817864510815077`*^9, 3.981786479650158*^9}, {
  3.981788690484048*^9, 3.981788696319776*^9}, {3.981797099419589*^9, 
  3.98179710264193*^9}, {3.98199039390654*^9, 3.9819904244803867`*^9}, {
  3.98199045539818*^9, 3.9819904565252533`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f24befff-e17f-0d4f-ab00-2c3797693fe7"],

Cell["which we expand near x=1:", "Text",
 CellChangeTimes->{{3.985065022328207*^9, 
  3.9850650296938744`*^9}},ExpressionUUID->"fd3084e8-f3c7-7444-a4ce-\
4085ecc0db96"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"Lplus", "[", 
      RowBox[{"n", ",", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "1"}], "}"}]}], "]"}], " ", "//", " ", 
   "FullSimplify"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"expansion", " ", "of", " ", "Lplus", " ", "at", " ", "x"}], "=", 
    "1"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"Lminus", "[", 
     RowBox[{"n", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1", ",", "1"}], "}"}]}], "]"}], " ", "//", " ", 
  "FullSimplify", " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"expansion", " ", "of", " ", "Lminus", " ", "at", " ", "x"}], "=",
     "1"}], "*)"}]}]}], "Code",
 CellChangeTimes->{{3.985065050318468*^9, 3.9850650505070534`*^9}, {
   3.9850654044275703`*^9, 3.9850654060567265`*^9}, 3.985234653011673*^9, {
   3.985342440334156*^9, 3.9853424573863144`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"8b6fcaf4-ea67-e340-9af6-f421d80e6f24"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", "m"}], "-", "n"}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}]}]], "+", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"5", " ", 
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"m", "-", "n"}], ")"}]}], 
      RowBox[{
       RowBox[{"-", "4"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"]}]}]], "-", "\[Nu]"}], ")"}], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}], "-", 
          RowBox[{"17", " ", 
           SuperscriptBox["a", "4"], " ", 
           SuperscriptBox["k", "4"]}]}], ")"}], " ", "m"}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"3", " ", 
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"]}]}], ")"}], "2"], " ", "n"}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}]}], ")"}], " ", "\[Nu]"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], "2"]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"x", "-", "1"}], "]"}], "2"],
    SeriesData[$CellContext`x, 1, {}, -1, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 1, {
   Rational[1, 
      2] (-$CellContext`m - $CellContext`n), (-4 + 
       4 $CellContext`a^2 $CellContext`k^2)^(-1) (-1 + 
      5 $CellContext`a^2 $CellContext`k^2) ($CellContext`m - $CellContext`n) - \
$CellContext`\[Nu], 
    Rational[1, 
      8] (-1 + $CellContext`a^2 $CellContext`k^2)^(-2) ((-1 + 
       2 $CellContext`a^2 $CellContext`k^2 - 
       17 $CellContext`a^4 $CellContext`k^4) $CellContext`m + (1 + 
        3 $CellContext`a^2 $CellContext`k^2)^2 $CellContext`n + 
     16 $CellContext`a^2 $CellContext`k^2 (-1 + $CellContext`a^2 \
$CellContext`k^2) $CellContext`\[Nu])}, -1, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.985347377735714*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"956d8671-921a-2543-b309-cf7acf50844e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{"m", "-", "n"}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}]}]], "+", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"5", " ", 
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"m", "+", "n"}], ")"}]}], 
      RowBox[{"4", "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"]}]}]], "+", "\[Nu]"}], ")"}], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}], "+", 
          RowBox[{"17", " ", 
           SuperscriptBox["a", "4"], " ", 
           SuperscriptBox["k", "4"]}]}], ")"}], " ", "m"}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"3", " ", 
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"]}]}], ")"}], "2"], " ", "n"}], "-", 
       RowBox[{"16", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}]}], ")"}], " ", "\[Nu]"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], "2"]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"x", "-", "1"}], "]"}], "2"],
    SeriesData[$CellContext`x, 1, {}, -1, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 1, {
   Rational[1, 
      2] ($CellContext`m - $CellContext`n), (4 - 
       4 $CellContext`a^2 $CellContext`k^2)^(-1) (-1 + 
      5 $CellContext`a^2 $CellContext`k^2) ($CellContext`m + $CellContext`n) + \
$CellContext`\[Nu], 
    Rational[1, 
      8] (-1 + $CellContext`a^2 $CellContext`k^2)^(-2) ((1 - 
       2 $CellContext`a^2 $CellContext`k^2 + 
       17 $CellContext`a^4 $CellContext`k^4) $CellContext`m + (1 + 
        3 $CellContext`a^2 $CellContext`k^2)^2 $CellContext`n - 
     16 $CellContext`a^2 $CellContext`k^2 (-1 + $CellContext`a^2 \
$CellContext`k^2) $CellContext`\[Nu])}, -1, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.985347377939369*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"8566ae78-fce8-374a-bba0-3e8b4f18ad59"]
}, Open  ]],

Cell["\<\
Therefore, we may initialize the coefficients of order -1 and 0 AFTER \
CHANGING SIGN so that they are expressed w.r.t (1-x):\
\>", "Text",
 CellChangeTimes->{{3.98506506250906*^9, 3.985065118425167*^9}, {
  3.9850652944976273`*^9, 3.985065294763239*^9}, {3.985345761657875*^9, 
  3.9853457905821857`*^9}},ExpressionUUID->"c1d9953b-bd3b-8149-96cd-\
372f286f259a"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "RSing", ",", " ", "LSing", ",", " ", "R0", ",", " ", "L0", ",", " ", "R1", 
   ",", " ", "L1"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RSing", "[", "n_", "]"}], ":=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"m", "-", "n"}], ")"}], "2"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R0", "[", "n_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "+", "n"}], ")"}]}], 
     RowBox[{"4", "-", 
      RowBox[{"4", " ", 
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["k", "2"]}]}]], "+", "\[Nu]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R1", "[", "n_", "]"}], ":=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}], "+", 
          RowBox[{"17", " ", 
           SuperscriptBox["a", "4"], " ", 
           SuperscriptBox["k", "4"]}]}], ")"}], " ", "m"}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"3", " ", 
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"]}]}], ")"}], "2"], " ", "n"}], "-", 
       RowBox[{"16", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}]}], ")"}], " ", "\[Nu]"}]}], ")"}], 
     RowBox[{"8", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], "2"]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LSing", "[", "n_", "]"}], ":=", 
   FractionBox[
    RowBox[{"m", "+", "n"}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"L0", "[", "n_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", "n"}], ")"}]}], 
     RowBox[{
      RowBox[{"-", "4"}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["k", "2"]}]}]], "-", "\[Nu]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"L1", "[", "n_", "]"}], ":=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}], "-", 
          RowBox[{"17", " ", 
           SuperscriptBox["a", "4"], " ", 
           SuperscriptBox["k", "4"]}]}], ")"}], " ", "m"}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"3", " ", 
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"]}]}], ")"}], "2"], " ", "n"}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}]}], ")"}], " ", "\[Nu]"}]}], ")"}], 
     RowBox[{"8", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], "2"]}]]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9847977223962708`*^9, 3.9847978245693817`*^9}, {
   3.984798362246132*^9, 3.9847983756079216`*^9}, {3.9848004331557026`*^9, 

Cell[CellGroupData[{

Cell["Applying the spin raising operator 2s times", "Subsection",
 CellChangeTimes->{{3.9847993953345356`*^9, 3.984799404257143*^9}, {
  3.985079291484747*^9, 
  3.9850792920161953`*^9}},ExpressionUUID->"a4d6e812-74e0-dd4c-aeff-\
2d40cb904f6c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "s", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"s", " ", "=", " ", 
    RowBox[{"1", "/", "2"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"or", " ", "1"}], ",", " ", 
    RowBox[{"3", "/", "2"}], ",", " ", 
    RowBox[{"etc", "."}]}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{"ClearAll", "[", "Phi", "]"}], "\n", 
 RowBox[{
  RowBox[{"Phi", "[", "0", "]"}], " ", ":=", " ", 
  RowBox[{"{", 
   RowBox[{"coeffs0", ",", " ", "sigma0"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Phi", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Phi", "[", "j", "]"}], " ", "=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "n"}], "}"}], ",",
       "\n", "  ", 
      RowBox[{
       RowBox[{"prevCoeffs", " ", "=", " ", 
        RowBox[{
         RowBox[{"Phi", "[", 
          RowBox[{"j", "-", "1"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"prevSigma", " ", "=", " ", 
        RowBox[{
         RowBox[{"Phi", "[", 
          RowBox[{"j", "-", "1"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"s", " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", "-", "1"}], ")"}], "/", "2"}]}]}], ";", "\n", "  ", 
       RowBox[{"ApplyRaisingOperator", "[", 
        RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "n"}], 
        "]"}]}]}], "\n", "]"}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Rstarobinsky", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", 
       RowBox[{"2", "*", "s"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "constant", " ", "if", " ", "there", " ", "is", " ", "NO", " ",
     "cancellation"}], " ", "*)"}]}], "\n", 
 RowBox[{"RsigmaFinal", " ", "=", " ", 
  RowBox[{
   RowBox[{"Phi", "[", 
    RowBox[{"2", "*", "s"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "check", " ", "that", " ", "the", " ", "final", " ", "exponent", " ", "is",
     " ", "the", " ", "same", " ", "with", " ", "the", " ", "sign", " ", "of",
     " ", "s", " ", "flipped"}], " ", "*)"}]}]}], "Code",
 CellChangeTimes->{
  3.984799391490553*^9, {3.984799446037113*^9, 3.9847994645052204`*^9}, {
   3.9847996515593243`*^9, 3.9847996772974453`*^9}, {3.984799889608652*^9, 

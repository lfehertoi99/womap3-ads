Cell[CellGroupData[{

Cell["Lowering the spin from +s to -s", "Section",
 CellChangeTimes->{{3.9847985608526745`*^9, 3.984798578165249*^9}, {
  3.985065849820223*^9, 
  3.985065855944498*^9}},ExpressionUUID->"0256d0de-7480-4341-832b-\
e1cf0da8bf6b"],

Cell[CellGroupData[{

Cell["Applying the spin lowering operator ONCE", "Subsection",
 CellChangeTimes->{
  3.985065847440489*^9},ExpressionUUID->"f4e2fe46-2c99-054a-9c82-\
18c0dec48d7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ApplyLoweringOperator", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ApplyLoweringOperator", "[", 
   RowBox[{"coeffs_", ",", "sigma_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "c0", ",", "c1", ",", "derCoeffs", ",", "singCoeffs", ",", "regCoeffs", ",",
       "newC0", ",", "newC1", ",", "newSigma"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"c0", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"leading", " ", "coefficient"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"c1", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"sub", "-", 
       RowBox[{"leading", " ", "coefficient"}]}], " ", "*)"}], "\n", "\t", 
     "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"effect", " ", "of"}], " ", "-", 
       RowBox[{"d", "/", 
        RowBox[{"dx", " ", ":", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"sigma", "+", "k"}], ")"}]}], "c_k", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "1"}], ")"}], "^", 
           RowBox[{"{", 
            RowBox[{"sigma", "+", "k", "-", "1"}], "}"}]}]}]}]}]}], " ", 
      "*)"}], "\n", "\t", 
     RowBox[{"derCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "sigma"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"sigma", "+", "1"}], ")"}]}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "singular", " ", 
       RowBox[{"term", " ", ":", " ", 
        RowBox[{"Lsing", " ", "c_k", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "^", 
          RowBox[{"{", 
           RowBox[{"sigma", "+", "k", "-", "1"}], "}"}]}]}]}]}], " ", "*)"}], 
     "\n", "\t", 
     RowBox[{"singCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"LSing", "[", "n", "]"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"LSing", "[", "n", "]"}], "*", "c1"}]}], "}"}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "constant", " ", 
       RowBox[{"term", " ", ":", " ", 
        RowBox[{"L0", " ", "c_k", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "^", 
          RowBox[{"{", 
           RowBox[{"sigma", "+", "k"}], "}"}]}]}]}]}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"regCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"L0", "[", "n", "]"}], "*", "c0"}]}], "}"}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "exponent"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"newSigma", "=", 
      RowBox[{"sigma", "-", "1"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "coefficient"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"newC0", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"new", " ", "sub"}], "-", 
       RowBox[{"leading", " ", "coefficient"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"newC1", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"regCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"newC0", ",", "newC1"}], "}"}], ",", "newSigma"}], "}"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.9847978411479263`*^9, 3.984797984043974*^9}, {
   3.9847983847333813`*^9, 3.9847983889050465`*^9}, {3.9848005424235687`*^9, 
   3.984800554767416*^9}, 3.985065466848425*^9, {3.985065548066326*^9, 
   3.9850655787271385`*^9}, {3.9850656144923744`*^9, 3.985065619239092*^9}, {
   3.9851592204067287`*^9, 3.9851592574043636`*^9}, {3.9851605385070114`*^9, 
   3.985160546254814*^9}, {3.9852324724932613`*^9, 3.9852326305345154`*^9}, {
   3.9852329454921417`*^9, 3.985232962495573*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"936e13e8-725c-9640-b7ae-440b1a8b7668"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applying the spin lowering operator 2s times", "Subsection",
 CellChangeTimes->{{3.9847993953345356`*^9, 
  3.984799404257143*^9}},ExpressionUUID->"590cab4e-28cf-864f-8c73-\
8bbd808d7600"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "s", "]"}], "\n", 
 RowBox[{
  RowBox[{"Lowering2sTimes", "[", 
   RowBox[{"coeffs_", ",", " ", "sigma_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Phi", ",", " ", "div", ",", " ", "LoweringCoeffs", ",", " ", 
      "LoweringSigma", ",", " ", "LoweringConstants"}], "}"}], ",", "\n", 
    "\t", "\n", "\t", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "initial", " ", "solution"}], " ", "*)"}], "\n", 
    "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", "0", "]"}], " ", ":=", " ", 
      RowBox[{"{", 
       RowBox[{"coeffs", ",", " ", "sigma"}], "}"}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "coefficient", " ", "that", " ", "we", " ", "have", " ", 
        "to", " ", "divide", " ", "by", " ", "IF", " ", "there", " ", "is", " ",
         "cancellation"}], ",", " ", 
       RowBox[{
       "which", " ", "we", " ", "save", " ", "before", " ", "assigning", " ", 
        "s"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"div", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Phi", "[", "0", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/.", 
       RowBox[{"s", "->", 
        RowBox[{"-", "s"}]}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "recursive", " ", "application", " ", "of", " ", "the", " ", "lowering",
        " ", "operator", " ", "2", "s", " ", "times"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{
      RowBox[{"Phi", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Phi", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{"Module", "[", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"prevCoeffs", ",", " ", "prevSigma"}], "}"}], ",", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{
          RowBox[{"prevCoeffs", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"prevSigma", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"ApplyLoweringOperator", "[", 
           RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "n"}], 
           "]"}]}]}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "always", " ", "apply", " ", "the", " ", "same", " ", "operator"}], 
         " ", "*)"}], "\n", "\t", "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"s", " ", "=", " ", "n"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"spin", " ", "value"}], " ", "*)"}], "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "final", " ", "coefficients", " ", "after", " ", "2", "m", " ", 
       "applications"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"LoweringCoeffs", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Phi", "[", 
         RowBox[{"2", "*", "n"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "final", " ", "exponent", " ", "sigma", " ", "after", " ", "2", "m", " ",
        "applications"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"LoweringSigma", " ", "=", " ", 
      RowBox[{
       RowBox[{"Phi", "[", 
        RowBox[{"2", "*", "n"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "TS", " ", "constant", " ", "computed", " ", "using", " ", "both", " ", 
       RowBox[{"coefficients", " ", "--"}], " ", "values", " ", "shouls", " ",
        "be", " ", "equal"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"LoweringConstants", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Phi", "[", 
            RowBox[{"2", "*", "n"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"2", "*", "n"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "div"]}], "}"}], "]"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<coefficients\>\"", "->", " ", "LoweringCoeffs"}], ",", 
        " ", 
        RowBox[{"\"\<sigma\>\"", "->", " ", "LoweringSigma"}], ",", " ", 
        RowBox[{"\"\<TS constant\>\"", "->", " ", "LoweringConstants"}]}], 
       "|>"}], "}"}]}]}], "\n", "\t", "]"}]}]}], "Code",
 CellChangeTimes->{
  3.984799391490553*^9, {3.984799446037113*^9, 3.9847994645052204`*^9}, {
   3.9847996515593243`*^9, 3.9847996772974453`*^9}, {3.984799889608652*^9, 
   3.9847999014057293`*^9}, 3.984799934429199*^9, 3.984800092633152*^9, {
   3.984800176238388*^9, 3.9848001910733223`*^9}, {3.9848002752642384`*^9, 
   3.984800279503107*^9}, {3.984800584893856*^9, 3.984800585112627*^9}, {
   3.9848007077349987`*^9, 3.984800710907036*^9}, {3.9848008163177032`*^9, 
   3.9848008306869164`*^9}, {3.984801812855448*^9, 3.9848018132774067`*^9}, {
   3.9850644241532936`*^9, 3.985064443084978*^9}, {3.9850646674890556`*^9, 
   3.985064685589178*^9}, {3.9850656411061287`*^9, 3.985065691341587*^9}, {
   3.9850658146473866`*^9, 3.9850658147713394`*^9}, {3.985078026013735*^9, 

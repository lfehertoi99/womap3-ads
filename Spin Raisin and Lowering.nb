Cell[CellGroupData[{

Cell["Initialisation of solutions S1, S2, S3, S4", "Section",
 CellChangeTimes->{{3.984798512038782*^9, 3.984798514695101*^9}, {
  3.98515981445916*^9, 
  3.985159822009365*^9}},ExpressionUUID->"3bf06a57-73a0-6848-a93f-\
90f0f044b24f"],

Cell["\<\
NOTE THAT is suffices to consider the first solution (result1 in \
master_frobenius) to extract two linearly independent branches and hence a \
basis of solutions at the regular point x=1. Then, switching s with -s, we \
obtain the other couple of solutions.\
\>", "Text",
 CellChangeTimes->{{3.985077583144577*^9, 3.98507761444042*^9}, {
  3.9851594945808926`*^9, 
  3.985159514354103*^9}},ExpressionUUID->"5aa9a080-b238-474c-a96c-\
1cca45a18bcc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "s", ",", " ", "sigmaplus", ",", " ", "coeffsplus", ",", " ", "sigmaminus",
     ",", " ", "coeffsminus"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"extract", " ", "branch", " ", "m"}], "+", 
    RowBox[{"s", " ", "/", "2"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", ">", "0"}], ",", " ", 
     RowBox[{"m", ">=", 
      RowBox[{"-", "s"}]}], ",", " ", 
     RowBox[{"k", ">", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaplus", " ", "=", " ", 
   RowBox[{"sigma1plus", " ", "//", "FullSimplify"}]}], " "}], "\n", 
 RowBox[{
  RowBox[{"coeffsplus", " ", "=", " ", 
   RowBox[{"AA1plusCoeffs", " ", "//", "FullSimplify"}]}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"extract", " ", "branch"}], " ", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"m", "+", "s"}], ")"}], " ", "/", "2"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", ">", "0"}], ",", " ", 
     RowBox[{"m", "<=", 
      RowBox[{"-", "s"}]}], ",", " ", 
     RowBox[{"k", ">", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaminus", " ", "=", " ", 
   RowBox[{"sigma1plus", " ", "//", "FullSimplify"}]}], " "}], "\n", 
 RowBox[{"coeffsminus", " ", "=", " ", 
  RowBox[{"AA1plusCoeffs", " ", "//", "FullSimplify"}]}]}], "Code",
 CellChangeTimes->{{3.985159601217783*^9, 3.9851596180429516`*^9}, {
  3.9851596910860634`*^9, 3.985159736902237*^9}, {3.985159873030815*^9, 

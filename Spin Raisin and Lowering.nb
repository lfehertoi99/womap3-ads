     ",", " ", "coeffsminus"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"extract", " ", "branch", " ", "m"}], "+", 
    RowBox[{"s", " ", "/", "2"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", ">", "0"}], ",", " ", 
     RowBox[{"m", ">=", 
      RowBox[{"-", "s"}]}], ",", " ", 
     RowBox[{"k", ">", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaplus", " ", "=", " ", 
   RowBox[{"sigma1plus", " ", "//", "FullSimplify"}]}], " "}], "\n", 
 RowBox[{
  RowBox[{"coeffsplus", " ", "=", " ", 

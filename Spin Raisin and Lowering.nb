Cell["Firstly, recall that the operators look like this:  ", "Text",
 CellChangeTimes->{{3.9850648662688026`*^9, 3.9850650053084774`*^9}, {
  3.985065220018097*^9, 
  3.9850652324101276`*^9}},ExpressionUUID->"d25f8d9c-97a0-2a46-bfbe-\
59d4be5e7a69"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}], "\n", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}]}], "Text",
 CellChangeTimes->{{3.981783547808112*^9, 3.981783676409051*^9}, {
  3.981786079998436*^9, 3.981786082213542*^9}, {3.981797064465685*^9, 
  3.981797067385528*^9}},ExpressionUUID->"554007c3-5607-bb43-a9db-\
eb24a8307f68"]], "Text",

  3.9850652579892826`*^9}},ExpressionUUID->"78655297-84b6-fa40-b091-\
fea63576295a"],

Cell["\<\
We will work (computationally) with the renormalised operators. where we now \
include the derivative term:\
\>", "Text",
 CellChangeTimes->{{3.9850652623266983`*^9, 
  3.985065264986702*^9}},ExpressionUUID->"212d032a-241c-3b4f-93c0-\
7a7ee100a414"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}]}], "Text",
 CellChangeTimes->{{3.9817839028112392`*^9, 3.9817839285593576`*^9}, {
  3.981786261883848*^9, 3.9817862639400682`*^9}, {3.981797077438373*^9, 
  3.981797096430489*^9}},ExpressionUUID->"29a17e8b-7b20-3e4d-899a-\
5935a073b4bf"]], "Text",
 CellChangeTimes->{{3.985065270280943*^9, 
  3.9850652737887745`*^9}},ExpressionUUID->"ba475202-7d35-dd4a-a1dc-\
0f6b3223f811"],

Cell["\<\
NOTE THAT THE MINUS OPERATOR RAISES THE SPIN AND THE PLUS OPERATOR LOWERS THE \
SPIN.\
\>", "Text",
 CellChangeTimes->{{3.985156188971203*^9, 
  3.985156205030262*^9}},ExpressionUUID->"9229f763-2bb9-ad48-a803-\
f4a8c6659cc6"],

Cell["\<\
Now, we want to compute the expansions of these operators near x=1 and x=-1. \
Since the derivative term is of 0th order in x, as far as the expansions are \
concerned, we only need to consider \
\>", "Text",
 CellChangeTimes->{
  3.9850652780954456`*^9},ExpressionUUID->"06c0cf14-79cf-0a41-acda-\
7b1658122b06"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"Lplus", ",", "Lminus"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lplus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"]}]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"s", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"s", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.981783946242859*^9, 3.981783975318748*^9}, {
  3.981785464292274*^9, 3.981785508449151*^9}, {3.981786268601119*^9, 
  3.981786270435828*^9}, {3.9817864510815077`*^9, 3.981786479650158*^9}, {
  3.981788690484048*^9, 3.981788696319776*^9}, {3.981797099419589*^9, 

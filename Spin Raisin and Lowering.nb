Cell[CellGroupData[{

Cell["Applying the spin lowering operator ONCE", "Subsection",
 CellChangeTimes->{
  3.985065847440489*^9},ExpressionUUID->"f4e2fe46-2c99-054a-9c82-\
18c0dec48d7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ApplyLoweringOperator", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ApplyLoweringOperator", "[", 
   RowBox[{"coeffs_", ",", "sigma_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "c0", ",", "c1", ",", "derCoeffs", ",", "singCoeffs", ",", "regCoeffs", ",",
       "newC0", ",", "newC1", ",", "newSigma"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"c0", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"c1", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"effect", " ", "of"}], " ", "-", 
       RowBox[{"d", "/", "dx"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"derCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "sigma"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"sigma", "+", "1"}], ")"}]}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "singular", " ", "term"}], " ", 
      "*)"}], "\n", "\t", 
     RowBox[{"singCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"LSingCoeff", "[", "n", "]"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"LSingCoeff", "[", "n", "]"}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "constant", " ", "term"}], " ", 
      "*)"}], "\n", "\t", 
     RowBox[{"regCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"L0Coeff", "[", "n", "]"}], "*", "c0"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "exponent"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"newSigma", "=", 
      RowBox[{"sigma", "-", "1"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "coefficient"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"newC0", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"new", " ", "sub"}], "-", 
       RowBox[{"leading", " ", "coefficient"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"newC1", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"regCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"newC0", ",", "newC1"}], "}"}], ",", "newSigma"}], "}"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.9847978411479263`*^9, 3.984797984043974*^9}, {
   3.9847983847333813`*^9, 3.9847983889050465`*^9}, {3.9848005424235687`*^9, 
   3.984800554767416*^9}, 3.985065466848425*^9, {3.985065548066326*^9, 
   3.9850655787271385`*^9}, {3.9850656144923744`*^9, 3.985065619239092*^9}, {
   3.9851592204067287`*^9, 
   3.9851592574043636`*^9}},ExpressionUUID->"936e13e8-725c-9640-b7ae-\
440b1a8b7668"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applying the spin lowering operator 2s times", "Subsection",
 CellChangeTimes->{{3.9847993953345356`*^9, 
  3.984799404257143*^9}},ExpressionUUID->"590cab4e-28cf-864f-8c73-\
8bbd808d7600"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Lowering2sTimes", "[", 
   RowBox[{"coeffs_", ",", " ", "sigma_", ",", " ", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", " ", "Phi", ",", " ", "div", ",", " ", "LoweringCoeffs", ",", 
      " ", "LoweringSigma", ",", " ", "LoweringConstants"}], "}"}], ",", "\n",
     "\t", "\n", "\t", 
    RowBox[{
     RowBox[{"s", " ", "=", " ", "m"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"spin", " ", "value"}], " ", "*)"}], "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "initial", " ", "solution"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{
      RowBox[{"Phi", "[", "0", "]"}], " ", ":=", " ", 
      RowBox[{"{", 
       RowBox[{"coeffs", ",", " ", "sigma"}], "}"}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "the", " ", "coefficient", " ", "that", " ", "we", " ", "have", " ", 
       "to", " ", "divide", " ", "by", " ", "IF", " ", "there", " ", "is", " ",
        "cancellation"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"div", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Phi", "[", "0", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/.", 
       RowBox[{"s", "->", 
        RowBox[{"-", "s"}]}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "recursive", " ", "application", " ", "of", " ", "the", " ", "lowering",
        " ", "operator", " ", "2", "s", " ", "times"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{
      RowBox[{"Phi", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Phi", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{"Module", "[", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "n"}], "}"}],
          ",", "\n", "\t\t", "\n", "\t\t", 
         RowBox[{
          RowBox[{"prevCoeffs", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"prevSigma", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"ApplyLoweringOperator", "[", 
           RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "s"}], 
           "]"}]}]}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "always", " ", "apply", " ", "the", " ", "operator", " ", "with", " ",
            "n"}], "=", "s"}], " ", "*)"}], "\n", "\t", "]"}]}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"final", " ", "coefficients"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"LoweringCoeffs", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Phi", "[", 
         RowBox[{"2", "*", "s"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"final", " ", "exponent", " ", "sigma"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"LoweringSigma", " ", "=", " ", 
      RowBox[{
       RowBox[{"Phi", "[", 
        RowBox[{"2", "*", "s"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "TS", " ", "constant", " ", "computed", " ", "using", " ", "both", " ", 
       RowBox[{"coefficients", " ", "--"}], " ", "values", " ", "shouls", " ",
        "be", " ", "equal"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"LoweringConstants", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Phi", "[", 
            RowBox[{"2", "*", "s"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"2", "*", "s"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "div"]}], "}"}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<coefficients\>\"", "->", " ", "LoweringCoeffs"}], ",", 
        " ", 
        RowBox[{"\"\<sigma\>\"", "->", " ", "LoweringSigma"}], ",", " ", 
        RowBox[{"\"\<TS constant\>\"", "->", " ", "LoweringConstants"}]}], 
       "|>"}], "}"}]}]}], "\n", "\t", "]"}]}]], "Code",
 CellChangeTimes->{
  3.984799391490553*^9, {3.984799446037113*^9, 3.9847994645052204`*^9}, {
   3.9847996515593243`*^9, 3.9847996772974453`*^9}, {3.984799889608652*^9, 

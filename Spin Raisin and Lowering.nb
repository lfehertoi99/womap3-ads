Notebook[{

Cell[CellGroupData[{
Cell["Angular ODE: spin raising/lowering 2s times", "Title",
 CellChangeTimes->{{3.9847984490535145`*^9, 3.984798499850605*^9}, {
  3.9850785784669304`*^9, 
  3.985078608580473*^9}},ExpressionUUID->"f2b915b8-3954-3242-8366-\
576f899d4312"],

Cell[CellGroupData[{

Cell["\<\
Expansion of spin raising and spin lowering operators near x=1\
\>", "Section",
 CellChangeTimes->{{3.985078526441988*^9, 
  3.985078540540991*^9}},ExpressionUUID->"5751f222-8dc9-df44-ac71-\
2c4ad64b7751"],

Cell["Firstly, recall that the operators look like this:  ", "Text",
 CellChangeTimes->{{3.9850648662688026`*^9, 3.9850650053084774`*^9}, {
  3.985065220018097*^9, 
  3.9850652324101276`*^9}},ExpressionUUID->"d25f8d9c-97a0-2a46-bfbe-\
59d4be5e7a69"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}], "\n", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}]}], "Text",
 CellChangeTimes->{{3.981783547808112*^9, 3.981783676409051*^9}, {
  3.981786079998436*^9, 3.981786082213542*^9}, {3.981797064465685*^9, 
  3.981797067385528*^9}},ExpressionUUID->"554007c3-5607-bb43-a9db-\
eb24a8307f68"]], "Text",
 CellChangeTimes->{{3.9850652373558865`*^9, 
  3.9850652409425697`*^9}},ExpressionUUID->"712580d9-17f0-1f47-a595-\
08580e4bfa6e"],

Cell["Since what we want to apply repeatedly is ", "Text",
 CellChangeTimes->{{3.9850652463759193`*^9, 
  3.9850652494589977`*^9}},ExpressionUUID->"93953d00-76b9-eb40-853a-\
b7432a59de93"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  FractionBox["Lplus", 
   RowBox[{"Sin", "[", "\[Theta]", "]"}]], "=", 
  RowBox[{
   RowBox[{
    FractionBox["Lplus", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]], "        ", "or", "         ", 
    FractionBox["Lminus", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]]}], "=", 
   FractionBox["Lminus", 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["x", "2"]}]]]}]}]], "Text",
 CellChangeTimes->{{3.9817837581531963`*^9, 
  3.98178382239657*^9}},ExpressionUUID->"4f2247bd-b5ff-dd49-80f4-\
9a2ca805161d"]], "Text",
 CellChangeTimes->{{3.985065254686611*^9, 
  3.9850652579892826`*^9}},ExpressionUUID->"78655297-84b6-fa40-b091-\
fea63576295a"],

Cell["\<\
We will work (computationally) with the renormalised operators. where we now \
include the derivative term:\
\>", "Text",
 CellChangeTimes->{{3.9850652623266983`*^9, 
  3.985065264986702*^9}},ExpressionUUID->"212d032a-241c-3b4f-93c0-\
7a7ee100a414"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}]}], "Text",
 CellChangeTimes->{{3.9817839028112392`*^9, 3.9817839285593576`*^9}, {
  3.981786261883848*^9, 3.9817862639400682`*^9}, {3.981797077438373*^9, 
  3.981797096430489*^9}},ExpressionUUID->"29a17e8b-7b20-3e4d-899a-\
5935a073b4bf"]], "Text",
 CellChangeTimes->{{3.985065270280943*^9, 
  3.9850652737887745`*^9}},ExpressionUUID->"ba475202-7d35-dd4a-a1dc-\
0f6b3223f811"],

Cell["\<\
Now, we want to compute the expansions of these operators near x=1 and x=-1. \
Since the derivative term is of 0th order in x, as far as the expansions are \
concerned, we only need to consider \
\>", "Text",
 CellChangeTimes->{
  3.9850652780954456`*^9},ExpressionUUID->"06c0cf14-79cf-0a41-acda-\
7b1658122b06"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"Lplus", ",", "Lminus"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lplus", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"]}]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"n", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminus", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"n", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.981783946242859*^9, 3.981783975318748*^9}, {
  3.981785464292274*^9, 3.981785508449151*^9}, {3.981786268601119*^9, 
  3.981786270435828*^9}, {3.9817864510815077`*^9, 3.981786479650158*^9}, {
  3.981788690484048*^9, 3.981788696319776*^9}, {3.981797099419589*^9, 
  3.98179710264193*^9}, {3.98199039390654*^9, 3.9819904244803867`*^9}, {
  3.98199045539818*^9, 3.9819904565252533`*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"f24befff-e17f-0d4f-ab00-2c3797693fe7"],

Cell["which we expand near x=1:", "Text",
 CellChangeTimes->{{3.985065022328207*^9, 
  3.9850650296938744`*^9}},ExpressionUUID->"fd3084e8-f3c7-7444-a4ce-\
4085ecc0db96"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"Lplus", "[", 
      RowBox[{"n", ",", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "0"}], "}"}]}], "]"}], " ", "//", " ", 
   "FullSimplify"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"expansion", " ", "of", " ", "Lplus", " ", "at", " ", "x"}], "=", 
    "1"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"Lminus", "[", 
     RowBox[{"n", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1", ",", "0"}], "}"}]}], "]"}], " ", "//", " ", 
  "FullSimplify", " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"expansion", " ", "of", " ", "Lminus", " ", "at", " ", "x"}], "=",
     "1"}], "*)"}]}]}], "Code",
 CellChangeTimes->{{3.985065050318468*^9, 3.9850650505070534`*^9}, {
  3.9850654044275703`*^9, 3.9850654060567265`*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"8b6fcaf4-ea67-e340-9af6-f421d80e6f24"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", "m"}], "-", "n"}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}]}]], "+", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"5", " ", 
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"m", "-", "n"}], ")"}]}], 
      RowBox[{
       RowBox[{"-", "4"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"]}]}]], "-", "\[Nu]"}], ")"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"x", "-", "1"}], "]"}], "1"],
    SeriesData[$CellContext`x, 1, {}, -1, 1, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 1, {
   Rational[1, 
      2] (-$CellContext`m - $CellContext`n), (-4 + 
       4 $CellContext`a^2 $CellContext`k^2)^(-1) (-1 + 
      5 $CellContext`a^2 $CellContext`k^2) ($CellContext`m - $CellContext`n) - \
$CellContext`\[Nu]}, -1, 1, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.985065052277878*^9, 3.985065406510811*^9, 
  3.9850779975145187`*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"38ef037e-bf67-3642-98a4-08f44366c3cc"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{"m", "-", "n"}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}]}]], "+", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"5", " ", 
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"m", "+", "n"}], ")"}]}], 
      RowBox[{"4", "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["k", "2"]}]}]], "+", "\[Nu]"}], ")"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"x", "-", "1"}], "]"}], "1"],
    SeriesData[$CellContext`x, 1, {}, -1, 1, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 1, {
   Rational[1, 
      2] ($CellContext`m - $CellContext`n), (4 - 
       4 $CellContext`a^2 $CellContext`k^2)^(-1) (-1 + 
      5 $CellContext`a^2 $CellContext`k^2) ($CellContext`m + $CellContext`n) + \
$CellContext`\[Nu]}, -1, 1, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.985065052277878*^9, 3.985065406510811*^9, 
  3.985077997633257*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"40ecd276-e4a7-b04d-98be-dc61847a2a81"]
}, Open  ]],

Cell["\<\
Therefore, we may initialize the coefficients of order -1 and 0:\
\>", "Text",
 CellChangeTimes->{{3.98506506250906*^9, 3.985065118425167*^9}, {
  3.9850652944976273`*^9, 
  3.985065294763239*^9}},ExpressionUUID->"c1d9953b-bd3b-8149-96cd-\
372f286f259a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "RSingCoeff", ",", " ", "LSingCoeff", ",", " ", "R0Coeff", ",", " ", 
    "L0Coeff"}], "]"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "coefficients", " ", "in", " ", "the", " ", "expansion", " ",
       "of", " ", "Lminus", " ", "near", " ", "x"}], "=", 
     RowBox[{"1", " ", "up", " ", "to", " ", "order", " ", "1"}]}], ",", " ", 
    RowBox[{"derivative", " ", "excluded"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RSingCoeff", "[", "n_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "m"}], "-", "n"}], ")"}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R0Coeff", "[", "n_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", "n"}], ")"}]}], 
     RowBox[{
      RowBox[{"-", "4"}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["k", "2"]}]}]], "-", "\[Nu]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LSingCoeff", "[", "n_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"m", "-", "n"}], ")"}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"L0Coeff", "[", "n_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "+", "n"}], ")"}]}], 
     RowBox[{"4", "-", 
      RowBox[{"4", " ", 
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["k", "2"]}]}]], "+", "\[Nu]"}]}], ";"}], "\n"}], "Code",
 CellChangeTimes->{{3.9847977223962708`*^9, 3.9847978245693817`*^9}, {
  3.984798362246132*^9, 3.9847983756079216`*^9}, {3.9848004331557026`*^9, 

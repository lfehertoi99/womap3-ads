         SuperscriptBox["k", "2"]}], "-", 
        RowBox[{"17", " ", 
         SuperscriptBox["a", "4"], " ", 
         SuperscriptBox["k", "4"]}]}], ")"}], " ", "m"}], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"3", " ", 
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], "2"], " ", "s"}], "+", 
     RowBox[{"16", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["k", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], " ", "\[Nu]"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], "2"]}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"3", " ", 
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}], "+", 
          RowBox[{"13", " ", 
           SuperscriptBox["a", "4"], " ", 
           SuperscriptBox["k", "4"]}], "+", 
          RowBox[{"49", " ", 
           SuperscriptBox["a", "6"], " ", 
           SuperscriptBox["k", "6"]}]}], ")"}], " ", "m"}], ")"}]}], "+", "s",
      "-", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["k", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"45", " ", 
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"]}], "+", 
           RowBox[{"17", " ", 
            SuperscriptBox["a", "4"], " ", 
            SuperscriptBox["k", "4"]}]}], ")"}], " ", "s"}], "+", 
        RowBox[{"16", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", 
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"]}], "-", 
           RowBox[{"3", " ", 
            SuperscriptBox["a", "4"], " ", 
            SuperscriptBox["k", "4"]}]}], ")"}], " ", "\[Nu]"}]}], ")"}]}]}], 
    RowBox[{"16", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], "3"]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.9860223162482567`*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"75e8192a-4c95-8f4c-b53c-929eca3d2703"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "and", " ", "store", " ", "the", " ", "operator", " ", 
    "coefficient", " ", "lists", " ", "as", " ", "functions", " ", "of", " ", 
    "n"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"RCoeff", ",", "LCoeff"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"LCoeff", ":=", 
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lplus", "[", "x", "]"}], ",", "x", ",", "1", ",", "2"}], 
     "]"}]}], "\n", 
   RowBox[{"RCoeff", ":=", 
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lminus", "[", "x", "]"}], ",", "x", ",", "1", ",", "2"}], 
     "]"}]}]}]}]], "Code",
 CellChangeTimes->{{3.9859468754586983`*^9, 3.985946909416916*^9}, {

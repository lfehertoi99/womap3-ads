Cell[CellGroupData[{

Cell["Applying the spin raising operator 2s times", "Subsection",
 CellChangeTimes->{{3.9847993953345356`*^9, 3.984799404257143*^9}, {
  3.985079291484747*^9, 
  3.9850792920161953`*^9}},ExpressionUUID->"a4d6e812-74e0-dd4c-aeff-\
2d40cb904f6c"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "s", "]"}], "\n", 
 RowBox[{
  RowBox[{"Raising2sTimes", "[", 
   RowBox[{"coeffs_", ",", " ", "sigma_", ",", " ", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Phi", ",", " ", "div", ",", " ", "RaisingCoeffs", ",", " ", 
      "RaisingSigma", ",", " ", "RaisingConstants"}], "}"}], ",", "\n", "\t", 
    "\n", "\t", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "initial", " ", "solution"}], " ", "*)"}], "\n", 
    "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", "0", "]"}], " ", ":=", " ", 
      RowBox[{"{", 
       RowBox[{"coeffs", ",", " ", "sigma"}], "}"}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "the", " ", "coefficient", " ", "that", " ", "we", " ", "have", " ", 
       "to", " ", "divide", " ", "by", " ", "IF", " ", "there", " ", "is", " ",
        "cancellation"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "we", " ", "need", " ", "to", " ", "save", " ", "it", " ", "BEFORE", " ",
        "assigning", " ", "a", " ", "value", " ", "to", " ", "s"}], " ", 
      "*)"}], "\n", "\t", 
     RowBox[{"div", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Phi", "[", "0", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/.", 
       RowBox[{"s", "->", 
        RowBox[{"-", "s"}]}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"s", " ", "=", " ", "m"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"spin", " ", "value"}], " ", "*)"}], "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "recursive", " ", "application", " ", "of", " ", "the", " ", "lowering",
        " ", "operator", " ", "m", " ", "times"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"Phi", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Phi", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{"Module", "[", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"prevCoeffs", ",", " ", "prevSigma"}], "}"}], ",", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{
          RowBox[{"prevCoeffs", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"prevSigma", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"ApplyRaisingOperator", "[", 
           RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "m"}], 
           "]"}]}]}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "always", " ", "apply", " ", "the", " ", "operator", " ", "with", " ",
            "n"}], "=", "s"}], " ", "*)"}], "\n", "\t", "]"}]}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"final", " ", "coefficients"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"RaisingCoeffs", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Phi", "[", 
         RowBox[{"2", "*", "m"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"final", " ", "exponent", " ", "sigma"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"RaisingSigma", " ", "=", " ", 
      RowBox[{
       RowBox[{"Phi", "[", 
        RowBox[{"2", "*", "m"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "TS", " ", "constant", " ", "computed", " ", "using", " ", "both", " ", 
       RowBox[{"coefficients", " ", "--"}], " ", "values", " ", "shouls", " ",
        "be", " ", "equal"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"RaisingConstants", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Phi", "[", 
            RowBox[{"2", "*", "m"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"2", "*", "m"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "div"]}], "}"}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<coefficients\>\"", "->", " ", "RaisingCoeffs"}], ",", 
        " ", 
        RowBox[{"\"\<sigma\>\"", "->", " ", "RaisingSigma"}], ",", " ", 
        RowBox[{"\"\<TS constant\>\"", "->", " ", "RaisingConstants"}]}], 
       "|>"}], "}"}]}]}], "\n", "\t", "]"}]}]}], "Code",
 CellChangeTimes->{

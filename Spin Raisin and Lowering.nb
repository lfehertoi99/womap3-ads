Cell[CellGroupData[{

Cell["Lowering + Raising", "Section",
 CellChangeTimes->{{3.9854077965379333`*^9, 
  3.9854078089895573`*^9}},ExpressionUUID->"98010f53-dffa-7244-ba36-\
11f23f257eee"],

Cell["\<\
To spin lower and spin raise we use the above modules. We also have to \
multiply by the factor\
\>", "Text",
 CellChangeTimes->{{3.985407816039095*^9, 3.9854078476008453`*^9}, {
  3.9854079412630615`*^9, 
  3.9854079415925694`*^9}},ExpressionUUID->"f5501522-5ce6-8e4f-9b5d-\
a4207906a097"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox[
         SqrtBox[
          SubscriptBox["\[CapitalDelta]", "\[Theta]"]], 
         RowBox[{"2", 
           StyleBox["s", "TI"]}]], 
        SuperscriptBox[
         SqrtBox[
          RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], 
         RowBox[{"2", 
           StyleBox["s", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
    "input" -> "{\\sqrt{\\Delta_{\\theta}}^{2s}{\\sqrt{1-x^2}}^{2s}", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"9409f3fd-f8c5-af49-8be5-737669c7e6de"]], \
"Text",
 CellChangeTimes->{
  3.9854078537699795`*^9},ExpressionUUID->"7d66ae15-c226-8943-bb5c-\
5998ec2ec461"],

Cell["\<\
at the right time. Since we are at the regular singular point x=1, \
multiplication by the above factor is equivalent to multiplication by\
\>", "Text",
 CellChangeTimes->{{3.985407898399849*^9, 
  3.98540796712315*^9}},ExpressionUUID->"2337a20a-9ef6-f74c-b878-\
cb864717f6c2"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox["\[CapitalXi]", 
         StyleBox["s", "TI"]], 
        SuperscriptBox["2", 
         StyleBox["s", "TI"]], 
        SuperscriptBox[
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["x", "TI"]}], ")"}], 
         StyleBox["s", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
    "{\\Xi}^{s}2^{s}{(1-x)}^{s}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"0cae4f63-122d-b34b-a728-cb4a5c608f14"]], \
"Text",
 CellChangeTimes->{{3.9854079758321514`*^9, 
  3.9854080002880707`*^9}},ExpressionUUID->"f199071f-375d-6449-82ab-\
ac885efe9b21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LoweringRaising", "[", 
   RowBox[{
   "coeff0_", ",", " ", "sigma0_", ",", " ", "spin_", ",", " ", "maxOrder_"}],
    "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sigmaL", ",", " ", "coeffsL", ",", " ", "sigmaLfactor", ",", " ", 
      "coeffsLfactor", ",", " ", "result"}], "}"}], ",", "\n", "  ", "\n", 
    "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Step", " ", "1"}], ":", " ", 
      RowBox[{
      "Lower", " ", "2", "spin", " ", "times", " ", "using", " ", 
       "LCoeff"}]}], " ", "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sigmaL", ",", " ", "coeffsL"}], "}"}], " ", "=", " ", 
      RowBox[{"ApplyOperator", "[", 
       RowBox[{
       "LCoeff", ",", " ", "coeff0", ",", " ", "sigma0", ",", " ", "spin", ",",
         " ", "maxOrder"}], "]"}]}], ";", "\n", "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Step", " ", "2"}], ":", " ", 
       RowBox[{"Multiply", " ", "by", " ", 
        RowBox[{"Xi", "^", "spin"}], " ", "*", " ", 
        RowBox[{"2", "^", "spin"}], " ", "*", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "x"}], ")"}], "^", "spin"}], " ", "factor"}]}], 
      " ", "*)"}], "\n", "  ", 
     RowBox[{"sigmaLfactor", "   ", "=", " ", 
      RowBox[{"sigmaL", " ", "+", " ", "spin"}]}], ";", "\n", "  ", 
     RowBox[{"coeffsLfactor", "  ", "=", " ", 
      RowBox[{
       RowBox[{"2", "^", "spin"}], " ", "*", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"a", "^", "2"}], " ", 
           RowBox[{"k", "^", "2"}]}]}], ")"}], "^", "spin"}], " ", "*", " ", 
       "coeffsL"}]}], ";", "\n", "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Step", " ", "3"}], ":", " ", 
       RowBox[{
       "Raise", " ", "2", " ", "spin", " ", "times", " ", "using", " ", 
        "RCoeff"}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sigmaR", ",", " ", "coeffsR"}], "}"}], " ", "=", " ", 
      RowBox[{"ApplyOperator", "[", 
       RowBox[{
       "RCoeff", ",", " ", "coeffsLfactor", ",", " ", "sigmaLfactor", ",", 
        " ", "spin", ",", " ", "maxOrder"}], "]"}]}], ";", "\n", "  ", "\n", 
     "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Step", " ", "4"}], ":", " ", 
       RowBox[{"Multiply", " ", "by", " ", 
        RowBox[{"Xi", "^", "spin"}], " ", "*", " ", 
        RowBox[{"2", "^", "spin"}], " ", "*", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "x"}], ")"}], "^", "spin"}], " ", "factor", " ", 
        "again"}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<final sigma\>\"", " ", "->", " ", 
          RowBox[{"sigmaR", " ", "+", " ", "spin"}]}], " ", "/.", " ", 
         RowBox[{"s", "->", "spin"}]}], "|>"}], ",", " ", "\n", "   ", 
       RowBox[{"<|", 
        RowBox[{"\"\<final coefficients\>\"", " ", "->", " ", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "^", "spin"}], " ", "*", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", 
               RowBox[{
                RowBox[{"a", "^", "2"}], " ", 
                RowBox[{"k", "^", "2"}]}]}], ")"}], "^", "spin"}], " ", "*", 
            " ", "coeffsR"}], "  ", "/.", " ", 
           RowBox[{"s", "->", "spin"}]}], "]"}]}], "|>"}]}], "}"}]}]}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.9854083286611423`*^9, 3.985408440926449*^9}, {
  3.985408478422676*^9, 3.9854088175622253`*^9}, {3.985408868295431*^9, 
  3.9854090003689613`*^9}, {3.985409144008524*^9, 3.9854091475954285`*^9}, {

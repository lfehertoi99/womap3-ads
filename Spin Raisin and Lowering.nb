     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["3", "16"]}], ",", 
       FractionBox[
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "41"}], "-", 
           RowBox[{"4", " ", "m", " ", 
            RowBox[{"(", 
             RowBox[{"13", "+", "m"}], ")"}]}], "-", 
           RowBox[{"56", " ", "\[Lambda]"}], "+", 
           RowBox[{"248", " ", "\[Nu]"}], "+", 
           RowBox[{"128", " ", "m", " ", "\[Nu]"}], "+", 
           RowBox[{"56", " ", 
            SuperscriptBox["a", "4"], " ", 
            SuperscriptBox["k", "4"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "m"}], "-", "\[Nu]"}], ")"}], " ", "\[Nu]"}], 
           "-", 
           RowBox[{"56", " ", 
            SuperscriptBox["\[Nu]", "2"]}], "+", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"37", "-", 
              RowBox[{"248", " ", "\[Nu]"}], "+", 
              RowBox[{"4", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"5", " ", "m", " ", 
                  RowBox[{"(", 
                   RowBox[{"13", "+", "m"}], ")"}]}], "-", 
                 RowBox[{"60", " ", "m", " ", "\[Nu]"}], "+", 
                 RowBox[{"28", " ", 
                  SuperscriptBox["\[Nu]", "2"]}]}], ")"}]}]}], ")"}]}]}], 
          ")"}]}], 
        RowBox[{"16", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"4", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "m"}], ")"}], " ", "m"}], "-", 
           RowBox[{"8", " ", "\[Lambda]"}], "+", 
           RowBox[{"8", " ", 
            SuperscriptBox["a", "4"], " ", 
            SuperscriptBox["k", "4"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "m"}], "-", "\[Nu]"}], ")"}], " ", "\[Nu]"}], 
           "-", 
           RowBox[{"8", " ", 
            RowBox[{"(", 

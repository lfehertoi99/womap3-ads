Cell[CellGroupData[{

Cell["Applying the spin lowering operator ONCE", "Subsection",
 CellChangeTimes->{
  3.985065847440489*^9},ExpressionUUID->"f4e2fe46-2c99-054a-9c82-\
18c0dec48d7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ApplyLoweringOperator", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ApplyLoweringOperator", "[", 
   RowBox[{"coeffs_", ",", "sigma_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "c0", ",", "c1", ",", "derCoeffs", ",", "singCoeffs", ",", "regCoeffs", ",",
       "newC0", ",", "newC1", ",", "newSigma"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"c0", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"c1", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Piece", " ", "1"}], ":", 
        RowBox[{"derivative", "-", 
         RowBox[{"d", "/", "dx"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"shifts", " ", "exponent", " ", "by"}], "-", "1"}]}], "*)"}], 
     "\n", "\t", 
     RowBox[{"derCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "sigma"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"sigma", "+", "1"}], ")"}]}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Piece", " ", "2"}], ":", 
       RowBox[{"singular", " ", "term", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "-", "n"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"(", 
            RowBox[{"x", "-", "1"}], ")"}]}], ")"}]}], " ", "multiplied", " ",
         "into", " ", "current", " ", "series"}]}], "*)"}], "\n", "\t", 
     RowBox[{"singCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"LSingCoeff", "[", "n", "]"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"LSingCoeff", "[", "n", "]"}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Piece", " ", "3"}], ":", 
       RowBox[{
       "regular", " ", "terms", " ", "B0", " ", "multiplied", " ", "into", " ",
         "current", " ", "series"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"regCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"L0Coeff", "[", "n", "]"}], "*", "c0"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "exponent"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"newSigma", "=", 
      RowBox[{"sigma", "-", "1"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "coefficient"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"newC0", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"new", " ", "sub"}], "-", 
       RowBox[{"leading", " ", "coefficient"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"newC1", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"regCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"newC0", ",", "newC1"}], "}"}], ",", "newSigma"}], "}"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.9847978411479263`*^9, 3.984797984043974*^9}, {
   3.9847983847333813`*^9, 3.9847983889050465`*^9}, {3.9848005424235687`*^9, 

 CellLabel->"In[96]:=",ExpressionUUID->"15264a7a-69a3-934c-ac23-485e6961bb76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "and", " ", "store", " ", "the", " ", "operator", " ", 
    "coefficient", " ", "lists", " ", "as", " ", "functions", " ", "of", " ", 
    "n"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"RCoeff", ",", "LCoeff"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LCoeff", "[", "n_", "]"}], ":=", 
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lplus", "[", 
       RowBox[{"x", ",", "n"}], "]"}], ",", "x", ",", "1", ",", "2"}], 
     "]"}]}], "\n", 
   RowBox[{
    RowBox[{"RCoeff", "[", "n_", "]"}], ":=", 
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{

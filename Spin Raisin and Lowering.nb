Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "RSingCoeff", ",", " ", "LSingCoeff", ",", " ", "R0Coeff", ",", " ", 
    "L0Coeff"}], "]"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "coefficients", " ", "in", " ", "the", " ", "expansion", " ",
       "of", " ", "Lminus", " ", "near", " ", "x"}], "=", 
     RowBox[{"1", " ", "up", " ", "to", " ", "order", " ", "1"}]}], ",", " ", 
    RowBox[{"derivative", " ", "excluded"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RSingCoeff", "[", "n_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "m"}], "-", "n"}], ")"}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R0Coeff", "[", "n_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["k", "2"]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", "n"}], ")"}]}], 
     RowBox[{
      RowBox[{"-", "4"}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["k", "2"]}]}]], "-", "\[Nu]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LSingCoeff", "[", "n_", "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"m", "-", "n"}], ")"}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"L0Coeff", "[", "n_", "]"}], ":=", 

     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"\[Lambda]", "+", 
        SuperscriptBox["\[Nu]", "2"]}], ")"}]}]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 

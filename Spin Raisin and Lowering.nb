Cell[BoxData[{
 RowBox[{"ClearAll", "[", "SpinRaising", "]"}], "\n", 
 RowBox[{
  RowBox[{"SpinRaising", "[", 
   RowBox[{"coeff0_", ",", " ", "sigma0_", ",", " ", "n_"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sigma", ",", " ", "C0", ",", " ", "C1", ",", " ", "C2"}], "}"}],
     ",", "\n", "    ", "\n", "    ", 
    RowBox[{"(*", " ", 
     RowBox[{"Base", " ", "cases"}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"sigma", "[", "0", "]"}], " ", "=", " ", "sigma0"}], ";", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"C0", "[", "0", "]"}], " ", "=", " ", 
      RowBox[{"coeff0", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "    ", 
     RowBox[{
      RowBox[{"C1", "[", "0", "]"}], " ", "=", " ", 
      RowBox[{"coeff0", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", "\n", "    ", 
     RowBox[{
      RowBox[{"C2", "[", "0", "]"}], " ", "=", " ", 
      RowBox[{"coeff0", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "sigma"}], " ", 
      "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"sigma", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "-", " ", "1"}]}]}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "C0"}], " ", 
      "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"C0", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"C0", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"sigma", "[", 
           RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", 
          RowBox[{"RSing", "[", "n", "]"}]}], ")"}], " ", "*", " ", 
        RowBox[{"C0", "[", 
         RowBox[{"j", " ", "-", " ", "1"}], "]"}]}]}]}], ";", "\n", "\n", 
     "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "C1"}], " ", 
      "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"C1", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"C1", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"C1", "[", 
          RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sigma", "[", 
            RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", "1", " ",
            "+", " ", 
           RowBox[{"RSing", "[", "n", "]"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"R0", "[", "n", "]"}], " ", "*", " ", 
         RowBox[{"C0", "[", 
          RowBox[{"j", " ", "-", " ", "1"}], "]"}]}]}]}]}], ";", "\n", "\n", 
     "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "C2"}], " ", 

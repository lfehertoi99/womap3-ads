           RowBox[{"[", "2", "]"}], "]"}], "div"]}], "}"}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<coefficients\>\"", "->", " ", "RaisingCoeffs"}], ",", 
        " ", 
        RowBox[{"\"\<sigma\>\"", "->", " ", "RaisingSigma"}], ",", " ", 
        RowBox[{"\"\<TS constant\>\"", "->", " ", "RaisingConstants"}]}], 

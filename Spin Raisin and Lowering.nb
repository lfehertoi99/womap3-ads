Cell[CellGroupData[{

Cell["Applying the spin raising operator 2s times", "Subsection",
 CellChangeTimes->{{3.9847993953345356`*^9, 3.984799404257143*^9}, {
  3.985079291484747*^9, 
  3.9850792920161953`*^9}},ExpressionUUID->"a4d6e812-74e0-dd4c-aeff-\
2d40cb904f6c"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "s", "]"}], "\n", 
 RowBox[{
  RowBox[{"Raising2sTimes", "[", 
   RowBox[{"coeffs_", ",", " ", "sigma_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Phi", ",", " ", "div", ",", " ", "RaisingCoeffs", ",", " ", 
      "RaisingSigma", ",", " ", "RaisingConstants"}], "}"}], ",", "\n", "\t", 
    "\n", "\t", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "initial", " ", "solution"}], " ", "*)"}], "\n", 
    "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", "0", "]"}], " ", ":=", " ", 
      RowBox[{"{", 
       RowBox[{"coeffs", ",", " ", "sigma"}], "}"}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "coefficient", " ", "that", " ", "we", " ", "have", " ", 
        "to", " ", "divide", " ", "by", " ", "IF", " ", "there", " ", "is", " ",
         "cancellation"}], ",", " ", 
       RowBox[{
       "which", " ", "we", " ", "save", " ", "before", " ", "assigning", " ", 
        "s"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"div", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Phi", "[", "0", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/.", 
       RowBox[{"s", "->", 
        RowBox[{"-", "s"}]}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "recursive", " ", "application", " ", "of", " ", "the", " ", "lowering",
        " ", "operator", " ", "m", " ", "times"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"Phi", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Phi", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{"Module", "[", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"prevCoeffs", ",", " ", "prevSigma"}], "}"}], ",", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{
          RowBox[{"prevCoeffs", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"prevSigma", " ", "=", " ", 
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"j", "-", "1"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t\t", 
          RowBox[{"ApplyRaisingOperator", "[", 
           RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "n"}], 
           "]"}]}]}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "apply", " ", "the", " ", "same", " ", "operator", " ", "at", " ", 
          "every", " ", "step"}], " ", "*)"}], "\n", "\t", "]"}]}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"s", " ", "=", " ", "n"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"spin", " ", "value"}], " ", "*)"}], "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "final", " ", "coefficients", " ", "after", " ", "2", "m", " ", 
       "applications"}], " ", "*)"}], "\n", "\t", 
     RowBox[{"RaisingCoeffs", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 

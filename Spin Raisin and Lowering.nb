Cell[CellGroupData[{

Cell["Lowering the spin from +s to -s", "Section",
 CellChangeTimes->{{3.9847985608526745`*^9, 3.984798578165249*^9}, {
  3.985065849820223*^9, 
  3.985065855944498*^9}},ExpressionUUID->"0256d0de-7480-4341-832b-\
e1cf0da8bf6b"],

Cell[CellGroupData[{

Cell["\<\
Recursive computation of the first 3 coefficients after n application of the \
spin lowering operator \
\>", "Subsection",
 CellChangeTimes->{{3.985345581317379*^9, 3.9853455952572136`*^9}, {
  3.9853459235201206`*^9, 3.9853459539919624`*^9}, {3.9854019339996567`*^9, 
  3.9854019341245594`*^9}},ExpressionUUID->"3ffc90a3-dd13-c044-88c1-\
6a489f105e53"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "SpinLowering", "]"}], "\n", 
 RowBox[{
  RowBox[{"SpinLowering", "[", 
   RowBox[{"coeff0_", ",", " ", "sigma0_", ",", " ", "n_"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sigma", ",", " ", "C0", ",", " ", "C1", ",", " ", "C2"}], "}"}],
     ",", "\n", "    ", "\n", "    ", 
    RowBox[{"(*", " ", 
     RowBox[{"Base", " ", "cases"}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"sigma", "[", "0", "]"}], " ", "=", " ", "sigma0"}], ";", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"C0", "[", "0", "]"}], " ", "=", " ", 
      RowBox[{"coeff0", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "    ", 
     RowBox[{
      RowBox[{"C1", "[", "0", "]"}], " ", "=", " ", 
      RowBox[{"coeff0", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", "\n", "    ", 
     RowBox[{
      RowBox[{"C2", "[", "0", "]"}], " ", "=", " ", 
      RowBox[{"coeff0", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", " ", "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "sigma"}], " ", 
      "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"sigma", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "-", " ", "1"}]}]}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "C0"}], " ", 
      "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"C0", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"C0", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"sigma", "[", 
           RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", 
          RowBox[{"LSing", "[", "n", "]"}]}], ")"}], " ", "*", " ", 
        RowBox[{"C0", "[", 
         RowBox[{"j", " ", "-", " ", "1"}], "]"}]}]}]}], ";", "\n", "\n", 
     "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "C1"}], " ", 
      "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"C1", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"C1", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"C1", "[", 
          RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sigma", "[", 
            RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", "1", " ",
            "+", " ", 
           RowBox[{"LSing", "[", "n", "]"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"L0", "[", "n", "]"}], " ", "*", " ", 
         RowBox[{"C0", "[", 
          RowBox[{"j", " ", "-", " ", "1"}], "]"}]}]}]}]}], ";", "\n", "\n", 
     "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursive", " ", "relation", " ", "for", " ", "C2"}], " ", 
      "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"C2", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"C2", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"C2", "[", 
          RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sigma", "[", 
            RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", "2", " ",
            "+", " ", 
           RowBox[{"LSing", "[", "n", "]"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"L0", "[", "n", "]"}], " ", "*", " ", 
         RowBox[{"C1", "[", 
          RowBox[{"j", " ", "-", " ", "1"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"L1", "[", "n", "]"}], " ", "*", " ", 

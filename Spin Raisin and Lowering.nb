   3.985090352450033*^9, 3.9850903615637646`*^9}, {3.9851438448436775`*^9, 
   3.9851438692967453`*^9}, {3.985144574309952*^9, 3.9851445808738003`*^9}, {
   3.9851450835102615`*^9, 3.9851450850732765`*^9}, {3.98515323486166*^9, 

Cell[CellGroupData[{

Cell["Lowering the spin from +s to -s", "Section",
 CellChangeTimes->{{3.9847985608526745`*^9, 3.984798578165249*^9}, {
  3.985065849820223*^9, 
  3.985065855944498*^9}},ExpressionUUID->"0256d0de-7480-4341-832b-\
e1cf0da8bf6b"],

Cell[CellGroupData[{

Cell["Applying the spin lowering operator ONCE", "Subsection",
 CellChangeTimes->{
  3.985065847440489*^9},ExpressionUUID->"f4e2fe46-2c99-054a-9c82-\
18c0dec48d7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ApplyLoweringOperator", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ApplyLoweringOperator", "[", 
   RowBox[{"coeffs_", ",", "sigma_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "c0", ",", "c1", ",", "derCoeffs", ",", "singCoeffs", ",", "regCoeffs", ",",
       "newC0", ",", "newC1", ",", "newSigma"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"c0", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"c1", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Piece", " ", "1"}], ":", 
        RowBox[{"derivative", "-", 
         RowBox[{"d", "/", "dx"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"shifts", " ", "exponent", " ", "by"}], "-", "1"}]}], "*)"}], 
     "\n", "\t", 
     RowBox[{"derCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "sigma"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"sigma", "+", "1"}], ")"}]}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Piece", " ", "2"}], ":", 
       RowBox[{"singular", " ", "term", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "-", "n"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"(", 
            RowBox[{"x", "-", "1"}], ")"}]}], ")"}]}], " ", "multiplied", " ",
         "into", " ", "current", " ", "series"}]}], "*)"}], "\n", "\t", 
     RowBox[{"singCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"LSingCoeff", "[", "n", "]"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"LSingCoeff", "[", "n", "]"}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Piece", " ", "3"}], ":", 
       RowBox[{
       "regular", " ", "terms", " ", "B0", " ", "multiplied", " ", "into", " ",
         "current", " ", "series"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"regCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"L0Coeff", "[", "n", "]"}], "*", "c0"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "exponent"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"newSigma", "=", 
      RowBox[{"sigma", "-", "1"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "coefficient"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"newC0", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"new", " ", "sub"}], "-", 
       RowBox[{"leading", " ", "coefficient"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"newC1", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"regCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"newC0", ",", "newC1"}], "}"}], ",", "newSigma"}], "}"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.9847978411479263`*^9, 3.984797984043974*^9}, {
   3.9847983847333813`*^9, 3.9847983889050465`*^9}, {3.9848005424235687`*^9, 
   3.984800554767416*^9}, 3.985065466848425*^9, {3.985065548066326*^9, 
   3.9850655787271385`*^9}, {3.9850656144923744`*^9, 3.985065619239092*^9}},
 CellLabel->
  "In[226]:=",ExpressionUUID->"936e13e8-725c-9640-b7ae-440b1a8b7668"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applying the spin lowering operator 2s times", "Subsection",
 CellChangeTimes->{{3.9847993953345356`*^9, 
  3.984799404257143*^9}},ExpressionUUID->"590cab4e-28cf-864f-8c73-\
8bbd808d7600"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "s", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"s", " ", "=", " ", "1"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"or", " ", "1"}], ",", " ", 
    RowBox[{"3", "/", "2"}], ",", " ", 
    RowBox[{"etc", "."}]}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{"ClearAll", "[", "Phi", "]"}], "\n", 
 RowBox[{
  RowBox[{"Phi", "[", "0", "]"}], " ", ":=", " ", 
  RowBox[{"{", 
   RowBox[{"coeffs0", ",", " ", "sigma0"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Phi", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Phi", "[", "j", "]"}], " ", "=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "n"}], "}"}], ",",
       "\n", "  ", 
      RowBox[{
       RowBox[{"prevCoeffs", " ", "=", " ", 
        RowBox[{
         RowBox[{"Phi", "[", 
          RowBox[{"j", "-", "1"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"prevSigma", " ", "=", " ", 
        RowBox[{
         RowBox[{"Phi", "[", 
          RowBox[{"j", "-", "1"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"s", " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", "-", "1"}], ")"}], "/", "2"}]}]}], ";", "\n", "  ", 
       RowBox[{"ApplyLoweringOperator", "[", 
        RowBox[{"prevCoeffs", ",", " ", "prevSigma", ",", " ", "n"}], 
        "]"}]}]}], "\n", "]"}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"LoweringStarobinsky", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", 
       RowBox[{"2", "*", "s"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "constant", " ", "if", " ", "there", " ", "is", " ", "NO", " ",
     "cancellation"}], " ", "*)"}]}], "\n", 
 RowBox[{"LoweringSigmaFinal", " ", "=", " ", 
  RowBox[{
   RowBox[{"Phi", "[", 
    RowBox[{"2", "*", "s"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "check", " ", "that", " ", "the", " ", "final", " ", "exponent", " ", "is",
     " ", "the", " ", "same", " ", "with", " ", "the", " ", "sign", " ", "of",
     " ", "s", " ", "flipped"}], " ", "*)"}]}]}], "Code",
 CellChangeTimes->{
  3.984799391490553*^9, {3.984799446037113*^9, 3.9847994645052204`*^9}, {
   3.9847996515593243`*^9, 3.9847996772974453`*^9}, {3.984799889608652*^9, 
   3.9847999014057293`*^9}, 3.984799934429199*^9, 3.984800092633152*^9, {

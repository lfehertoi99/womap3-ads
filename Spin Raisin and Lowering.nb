Cell[CellGroupData[{

Cell["Spin Raising or Spin Lowering multiple times", "Section",
 CellChangeTimes->{{3.9859486914009266`*^9, 3.9859487015987225`*^9}, {
  3.9859488197036724`*^9, 
  3.9859488219867992`*^9}},ExpressionUUID->"74f918da-99d5-fc4f-aea2-\
74f91e33c938"],

Cell["\<\
Due to the similarities between the structure of the two operators, we write \
a single piece of code to implement their repeated application. Note that to \
compute the first N elements in the final series expansion, we need the first \
N coefficients of the initial solution and the first N-1 coefficients in the \
operator expansion -- the code should tell us if the objects have the \
appropriate length.

We need: 
1. \[OpenCurlyDoubleQuote]operator\[CloseCurlyDoubleQuote] = list of \
coefficients in the power series expansion of the operator;
2. \[OpenCurlyDoubleQuote]coeffs0\[CloseCurlyDoubleQuote] = list of \
coefficients of the initial solution;
3. \[OpenCurlyDoubleQuote]sigma0\[CloseCurlyDoubleQuote] = the initial \
exponent;
4. \[OpenCurlyDoubleQuote]spin\[CloseCurlyDoubleQuote] = the spin value, \
which use to determine the number of applications (2 spin) and plug-in at the \
very end;
5. \[OpenCurlyDoubleQuote]maxOrder\[CloseCurlyDoubleQuote] = maximum order of \
the expansion.\
\>", "Text",
 CellChangeTimes->{{3.985948826968508*^9, 3.9859489238956776`*^9}, {
  3.9859489887370815`*^9, 3.9859490114253273`*^9}, {3.9860039900974464`*^9, 
  3.986004097044258*^9}, {3.9860041841521797`*^9, 3.986004251451576*^9}, {
  3.9860051349779453`*^9, 
  3.9860051353382206`*^9}},ExpressionUUID->"1f87c431-b356-8a49-853c-\
e1b3be2a9aa7"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "ApplyOperator", "]"}], "\n", 
 RowBox[{
  RowBox[{"ApplyOperator", "[", 
   RowBox[{
   "operator_", ",", " ", "coeffs0_", ",", " ", "sigma0_", ",", " ", "spin_", 
    ",", " ", "maxOrder_"}], "]"}], " ", ":=", " ", "\n", "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sigma", ",", " ", "c", ",", " ", "dq"}], "}"}], ",", "\n", "\n",
     "    ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Operator", " ", 
       RowBox[{"coefficients", ":", " ", 
        RowBox[{"dq", "[", "q", "]"}]}]}], " ", "=", " ", 
      RowBox[{
      "coefficient", " ", "of", " ", "order", " ", "q", " ", "in", " ", "the",
        " ", "expansion"}]}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"dq", "[", "q_", "]"}], " ", ":=", " ", 
      RowBox[{"operator", "[", 
       RowBox[{"[", 
        RowBox[{"q", " ", "+", " ", "2"}], "]"}], "]"}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"shift", ":", " ", 
        RowBox[{"index", " ", "1"}]}], " ", "=", " ", 
       RowBox[{"power", " ", "-", "1"}]}], " ", "*)"}], "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Base", " ", "cases"}], " ", "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "0", "]"}], " ", "=", " ", "sigma0"}], ";", "\n", 
     "    ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"k", ",", " ", "0"}], "]"}], " ", "=", " ", 
        RowBox[{"coeffs0", "[", 
         RowBox[{"[", 
          RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursion", " ", "for", " ", "sigma"}], " ", "*)"}], "\n", 
     "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"sigma", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "-", " ", "1"}]}]}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursion", " ", "for", " ", "coefficients"}], " ", "*)"}], 
     "\n", "    ", 
     RowBox[{
      RowBox[{"c", "[", 
       RowBox[{"k_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"k", ",", " ", "j"}], "]"}], " ", "=", " ", 
       RowBox[{"FullSimplify", "[", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"j", " ", "-", " ", "1"}]}], "]"}], " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", "k", 
            " ", "+", " ", 
            RowBox[{"dq", "[", 
             RowBox[{"-", "1"}], "]"}]}], ")"}]}], " ", "+", "\n", "      ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"p", ",", " ", 
              RowBox[{"j", " ", "-", " ", "1"}]}], "]"}], " ", "*", " ", 
            RowBox[{"dq", "[", 
             RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "p"}], "]"}]}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", 
             RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "\n", 
        "    ", "]"}]}]}], ";", "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Return", " ", "result", " ", 
       RowBox[{"after", " ", "'"}], "2", " ", 
       RowBox[{"spin", "'"}], " ", "applications"}], " ", "*)"}], "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"2", "*", "spin"}], "]"}], " ", "/.", 
        RowBox[{"s", "->", "spin"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"2", "*", "spin"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}],
         "/.", " ", 
        RowBox[{"s", "->", "spin"}]}]}], "}"}]}]}], "\n", "  ", 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.98594871368099*^9, 3.985948771582941*^9}, {
  3.9860039717644997`*^9, 3.986003980630707*^9}, {3.9860041050661507`*^9, 
  3.98600413244442*^9}, {3.9860041695070477`*^9, 3.9860041701476116`*^9}, {
  3.98600473979735*^9, 3.9860047484090137`*^9}, {3.9860050296265507`*^9, 
  3.9860050297047024`*^9}, {3.9860054445063725`*^9, 3.9860054445735188`*^9}, {
  3.9860054787745132`*^9, 3.986005543871521*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"b9cec0e8-58ab-0b42-a496-33e47ee6f588"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ApplyOperator", "[", 
  RowBox[{"LCoeff", ",", " ", "coeffs1", ",", " ", "sigma1", ",", " ", 
   RowBox[{"1", "/", "2"}], ",", " ", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.9860048274463024`*^9, 3.986004840147663*^9}, {
  3.9860049049755096`*^9, 3.986004928360449*^9}, {3.986004975558527*^9, 
  3.986004991430889*^9}, {3.986005036435566*^9, 3.986005058446903*^9}, {
  3.986005427642601*^9, 3.986005428239464*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"90e57caf-76e0-7b49-9961-fcf883c3ce9c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "+", "m"}], ")"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], "+", "m"}], ",", 
     FractionBox[
      RowBox[{
       FractionBox["1", "4"], "-", 
       RowBox[{"m", " ", 
        RowBox[{"(", 
         RowBox[{"2", "+", "m"}], ")"}]}], "-", 
       RowBox[{"2", " ", "\[Nu]"}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["a", "4"], " ", "\[Nu]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{

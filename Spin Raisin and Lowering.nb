Cell[CellGroupData[{

Cell["Spin Raising or Spin Lowering multiple times", "Section",
 CellChangeTimes->{{3.9859486914009266`*^9, 3.9859487015987225`*^9}, {
  3.9859488197036724`*^9, 
  3.9859488219867992`*^9}},ExpressionUUID->"74f918da-99d5-fc4f-aea2-\
74f91e33c938"],

Cell["\<\
Due to the similarities between the structure of the two operators, we write \
a single piece of code to implement the repeated application of each operator.
NOTE THAT to compute the first N elements in the final series expansion, we \
need the first N coefficients of the initial solution and the first N-1 \
coefficients in the operator expansion.\
\>", "Text",
 CellChangeTimes->{{3.985948826968508*^9, 3.9859489238956776`*^9}, {
  3.9859489887370815`*^9, 
  3.9859490114253273`*^9}},ExpressionUUID->"1f87c431-b356-8a49-853c-\
e1b3be2a9aa7"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "ApplyOperator", "]"}], "\n", 
 RowBox[{
  RowBox[{"ApplyOperator", "[", 
   RowBox[{
   "operator_", ",", " ", "coeffs0_", ",", " ", "sigma0_", ",", " ", "steps_",
     ",", " ", "maxOrder_"}], "]"}], " ", ":=", " ", "\n", "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sigma", ",", " ", "c", ",", " ", "dq"}], "}"}], ",", "\n", "\n",
     "    ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Operator", " ", 
       RowBox[{"coefficients", ":", " ", 
        RowBox[{"dq", "[", "q", "]"}]}]}], " ", "=", " ", 
      RowBox[{
      "coefficient", " ", "of", " ", "order", " ", "q", " ", "in", " ", "the",
        " ", "expansion"}]}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"dq", "[", "q_", "]"}], " ", ":=", " ", 
      RowBox[{"operator", "[", 
       RowBox[{"[", 
        RowBox[{"q", " ", "+", " ", "2"}], "]"}], "]"}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"shift", ":", " ", 
        RowBox[{"index", " ", "1"}]}], " ", "=", " ", 
       RowBox[{"power", " ", "-", "1"}]}], " ", "*)"}], "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Base", " ", "cases"}], " ", "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "0", "]"}], " ", "=", " ", "sigma0"}], ";", "\n", 
     "    ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"k", ",", " ", "0"}], "]"}], " ", "=", " ", 
        RowBox[{"coeffs0", "[", 
         RowBox[{"[", 
          RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursion", " ", "for", " ", "sigma"}], " ", "*)"}], "\n", 
     "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"sigma", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "-", " ", "1"}]}]}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursion", " ", "for", " ", "coefficients"}], " ", "*)"}], 
     "\n", "    ", 
     RowBox[{
      RowBox[{"c", "[", 
       RowBox[{"k_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"k", ",", " ", "j"}], "]"}], " ", "=", " ", 
       RowBox[{"FullSimplify", "[", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"j", " ", "-", " ", "1"}]}], "]"}], " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", "k", 
            " ", "+", " ", 
            RowBox[{"dq", "[", 
             RowBox[{"-", "1"}], "]"}]}], ")"}]}], " ", "+", "\n", "      ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"p", ",", " ", 
              RowBox[{"j", " ", "-", " ", "1"}]}], "]"}], " ", "*", " ", 
            RowBox[{"dq", "[", 
             RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "p"}], "]"}]}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", 
             RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "\n", 
        "    ", "]"}]}]}], ";", "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Return", " ", "result", " ", 
       RowBox[{"after", " ", "'"}], 
       RowBox[{"steps", "'"}], " ", "applications"}], " ", "*)"}], "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sigma", "[", "steps", "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"k", ",", " ", "steps"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], 
        "]"}]}], "}"}]}]}], "\n", "  ", "]"}]}]}], "Code",
 CellChangeTimes->{{3.98594871368099*^9, 3.985948771582941*^9}},
 CellLabel->
  "In[190]:=",ExpressionUUID->"b9cec0e8-58ab-0b42-a496-33e47ee6f588"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Lowering + Raising", "Section",
 CellChangeTimes->{{3.9854077965379333`*^9, 
  3.9854078089895573`*^9}},ExpressionUUID->"98010f53-dffa-7244-ba36-\
11f23f257eee"],

Cell["\<\
To spin lower and spin raise we use the above modules. We also have to \
multiply by the factor\
\>", "Text",
 CellChangeTimes->{{3.985407816039095*^9, 3.9854078476008453`*^9}, {
  3.9854079412630615`*^9, 
  3.9854079415925694`*^9}},ExpressionUUID->"f5501522-5ce6-8e4f-9b5d-\
a4207906a097"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox[
         SqrtBox[
          SubscriptBox["\[CapitalDelta]", "\[Theta]"]], 
         RowBox[{"2", 
           StyleBox["s", "TI"]}]], 
        SuperscriptBox[
         SqrtBox[
          RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], 
         RowBox[{"2", 
           StyleBox["s", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
    "input" -> "{\\sqrt{\\Delta_{\\theta}}^{2s}{\\sqrt{1-x^2}}^{2s}", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"9409f3fd-f8c5-af49-8be5-737669c7e6de"]], \
"Text",
 CellChangeTimes->{
  3.9854078537699795`*^9},ExpressionUUID->"7d66ae15-c226-8943-bb5c-\
5998ec2ec461"],

Cell["\<\
at the right time. Since we are at the regular singular point x=1, \
multiplication by the above factor is equivalent to multiplication by\
\>", "Text",
 CellChangeTimes->{{3.985407898399849*^9, 
  3.98540796712315*^9}},ExpressionUUID->"2337a20a-9ef6-f74c-b878-\
cb864717f6c2"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox["\[CapitalXi]", 
         StyleBox["s", "TI"]], 
        SuperscriptBox["2", 
         StyleBox["s", "TI"]], 
        SuperscriptBox[
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["x", "TI"]}], ")"}], 
         StyleBox["s", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
    "{\\Xi}^{s}2^{s}{(1-x)}^{s}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"0cae4f63-122d-b34b-a728-cb4a5c608f14"]], \
"Text",
 CellChangeTimes->{{3.9854079758321514`*^9, 
  3.9854080002880707`*^9}},ExpressionUUID->"f199071f-375d-6449-82ab-\
ac885efe9b21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LoweringRaising", "[", 
   RowBox[{"coeff0_", ",", "sigma0_", ",", "n_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sigmalow", ",", " ", "coeffslow", ",", " ", "sigmaL", ",", " ", 
      "coeffsL", ",", " ", "sigmaLfactor", ",", " ", "coeffsLfactor", ",", 
      " ", "sigmarais", ",", " ", "coeffsrais", ",", " ", "sigmaR", ",", " ", 
      "coeffsR", ",", " ", "sigmaRfactor", ",", " ", "coeffsRfactor"}], "}"}],
     ",", "\n", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sigmalow", ",", " ", "coeffslow"}], "}"}], " ", "=", " ", 
      RowBox[{"SpinLowering", "[", 
       RowBox[{"coeff0", ",", " ", "sigma0", ",", " ", "n"}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"sigmaL", " ", "=", " ", 
      RowBox[{"sigmalow", "[", "\"\<sigma\>\"", "]"}]}], ";", "\n", "\t", 
     RowBox[{"coeffsL", " ", "=", " ", 
      RowBox[{"coeffslow", "[", "\"\<coeffs\>\"", "]"}]}], ";", "\n", "\t", 
     "\n", "\t", 
     RowBox[{"sigmaLfactor", " ", "=", " ", 
      RowBox[{"sigmaL", " ", "+", " ", "n"}]}], ";", "\n", "\t", 
     RowBox[{"coeffsLfactor", " ", "=", " ", 
      RowBox[{
       SuperscriptBox["2", "n"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           SuperscriptBox["a", "2"], 
           SuperscriptBox["k", "2"]}]}], ")"}], "n"], "*", "coeffsL"}]}], ";",
      "\n", "\t", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sigmarais", ",", " ", "coeffsrais"}], "}"}], " ", "=", " ", 
      RowBox[{"SpinRaising", "[", 
       RowBox[{"coeffsLfactor", ",", " ", "sigmaLfactor", ",", " ", "n"}], 
       "]"}]}], ";", "\n", "\t", 
     RowBox[{"sigmaR", " ", "=", " ", 
      RowBox[{"sigmarais", "[", "\"\<sigma\>\"", "]"}]}], ";", "\n", "\t", 
     RowBox[{"coeffsR", " ", "=", " ", 
      RowBox[{"coeffsrais", "[", "\"\<coeffs\>\"", "]"}]}], ";", "\n", "\t", 
     "\n", "\t", 
     RowBox[{"sigmaRfactor", " ", "=", " ", 
      RowBox[{"sigmaR", " ", "+", " ", "n"}]}], ";", "\n", "\t", 
     RowBox[{"coeffsRfactor", " ", "=", " ", 
      RowBox[{
       SuperscriptBox["2", "n"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           SuperscriptBox["a", "2"], 
           SuperscriptBox["k", "2"]}]}], ")"}], "n"], "*", "coeffsR"}]}], ";",
      "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{"\"\<final sigma\>\"", "->", " ", "sigmaRfactor"}], "|>"}], ",",
        "\n", "\t", 
       RowBox[{"<|", 
        RowBox[{"\"\<final coefficients\>\"", " ", "->", " ", 

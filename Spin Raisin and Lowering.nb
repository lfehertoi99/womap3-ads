Cell[CellGroupData[{

Cell["Applying the spin raising operator ONCE", "Subsection",
 CellChangeTimes->{
  3.985065847440489*^9, {3.985079653441633*^9, 
   3.9850796539334335`*^9}},ExpressionUUID->"4fa329f6-4485-d143-9733-\
4d993f3543d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ApplyRaisingOperator", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ApplyRaisingOperator", "[", 
   RowBox[{"coeffs_", ",", "sigma_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "c0", ",", "c1", ",", "derCoeffs", ",", "singCoeffs", ",", "regCoeffs", ",",
       "newC0", ",", "newC1", ",", "newSigma"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"c0", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"leading", " ", "coeff"}], " ", "*)"}], "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"c1", "=", 
      RowBox[{"coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"sub", "-", 
       RowBox[{"leading", " ", "coeff"}]}], " ", "*)"}], "\n", "\t", "\n", 
     "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"effect", " ", "of"}], " ", "-", 
       RowBox[{"d", "/", 
        RowBox[{"dx", " ", ":", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"sigma", "+", "k"}], ")"}]}], "c_k", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "1"}], ")"}], "^", 
           RowBox[{"{", 
            RowBox[{"sigma", "+", "k", "-", "1"}], "}"}]}]}]}]}]}], " ", 
      "*)"}], "\n", "\t", 
     RowBox[{"derCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "sigma"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"sigma", "+", "1"}], ")"}]}], "*", "c1"}]}], "}"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "singular", " ", 
       RowBox[{"term", " ", ":", " ", 
        RowBox[{"Rsing", " ", "c_k", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "^", 
          RowBox[{"{", 
           RowBox[{"sigma", "+", "k", "-", "1"}], "}"}]}]}]}]}], " ", "*)"}], 
     "\n", "\t", 
     RowBox[{"singCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"RSing", "[", "n", "]"}], "*", "c0"}], ",", 
        RowBox[{
         RowBox[{"RSing", "[", "n", "]"}], "*", "c1"}]}], "}"}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"effect", " ", "of", " ", "constant", " ", 
       RowBox[{"term", " ", ":", " ", 
        RowBox[{"R0", " ", "c_k", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "^", 
          RowBox[{"{", 
           RowBox[{"sigma", "+", "k"}], "}"}]}]}]}]}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"regCoeffs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"R0", "[", "n", "]"}], "*", "c0"}]}], "}"}]}], ";", "\n", 
     "\t", "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "exponent"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"newSigma", "=", 
      RowBox[{"sigma", "-", "1"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "leading", " ", "coefficient"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"newC0", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"new", " ", "sub"}], "-", 
       RowBox[{"leading", " ", "coefficient"}]}], " ", "*)"}], "\n", "\t", 
     RowBox[{"newC1", "=", 
      RowBox[{
       RowBox[{"derCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"singCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "+", 
       RowBox[{"regCoeffs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"newC0", ",", "newC1"}], "}"}], ",", "newSigma"}], "}"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.9847978411479263`*^9, 3.984797984043974*^9}, {
   3.9847983847333813`*^9, 3.9847983889050465`*^9}, {3.9848005424235687`*^9, 
   3.984800554767416*^9}, 3.985065466848425*^9, {3.985065548066326*^9, 
   3.9850655787271385`*^9}, {3.9850656144923744`*^9, 3.985065619239092*^9}, {
   3.985067826118387*^9, 3.9850678523175583`*^9}, {3.9850795679918747`*^9, 
   3.985079570186735*^9}, {3.985159280518669*^9, 3.9851593084103565`*^9}, {
   3.9851645521179276`*^9, 3.9851645591496925`*^9}, {3.9852330253043156`*^9, 
   3.9852330352431793`*^9}, {3.985233067588434*^9, 3.9852331106564217`*^9}},
 CellLabel->

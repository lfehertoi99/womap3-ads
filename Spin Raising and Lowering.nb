Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}]}], "Text",
 CellChangeTimes->{{3.9817839028112392`*^9, 3.9817839285593576`*^9}, {

Cell["Expansion of the operators", "Section",
 CellChangeTimes->{{3.985078526441988*^9, 3.985078540540991*^9}, {
  3.985159845483364*^9, 3.9851598531906223`*^9}, {3.9863485757647896`*^9, 
  3.986348578969631*^9}, {3.990251038103878*^9, 3.9902510393857574`*^9}, {
  3.9902521261933136`*^9, 3.990252127927561*^9}, {3.99025216728619*^9, 
  3.9902521823366566`*^9}},ExpressionUUID->"414b4011-111e-0c49-92f5-\
b7b0b98322de"],

Cell["We are interested in the power series expansions of", "Text",
 CellChangeTimes->{{3.9850648662688026`*^9, 3.9850650053084774`*^9}, {
  3.985065220018097*^9, 3.9850652324101276`*^9}, {3.9902510604531*^9, 
  3.990251065721117*^9}, {3.9902512124876423`*^9, 
  3.9902512191776295`*^9}},ExpressionUUID->"826fa332-dcb6-4544-b5e6-\
d5e5498251e1"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}], "\n", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}]}], "Text",
 CellChangeTimes->{{3.981783547808112*^9, 3.981783676409051*^9}, {
  3.981786079998436*^9, 3.981786082213542*^9}, {3.981797064465685*^9, 
  3.981797067385528*^9}},ExpressionUUID->"790bc4a0-2c6e-8d4b-8775-\
e0cfb6105259"]], "Text",
 CellChangeTimes->{{3.9850652373558865`*^9, 
  3.9850652409425697`*^9}},ExpressionUUID->"32be6198-0401-7045-95d7-\
714fb813bc1c"],

Cell["We want to repeatedly apply the operator ", "Text",
 CellChangeTimes->{{3.9850652463759193`*^9, 3.9850652494589977`*^9}, {
  3.9902512251968136`*^9, 3.9902512252903614`*^9}, {3.9902513124138947`*^9, 
  3.990251313289442*^9}, {3.990251351927908*^9, 
  3.99025136296212*^9}},ExpressionUUID->"f42c7e90-64fc-d24c-aaf3-\
e07b4e124959"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  FractionBox["Lplus", 
   RowBox[{"Sin", "[", "\[Theta]", "]"}]], "=", 
  RowBox[{
   RowBox[{
    FractionBox["Lplus", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]], "        ", "or", "         ", 
    FractionBox["Lminus", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]]}], "=", 
   FractionBox["Lminus", 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["x", "2"]}]]]}]}]], "Text",
 CellChangeTimes->{{3.9817837581531963`*^9, 
  3.98178382239657*^9}},ExpressionUUID->"a577b3ef-ebb0-8345-8be5-\
5ffeaa601959"]], "Text",
 CellChangeTimes->{{3.985065254686611*^9, 
  3.9850652579892826`*^9}},ExpressionUUID->"292cff9e-8004-d24b-9a6d-\
fa0aa5b664df"],

Cell["\<\
With a slight abuse of notation, we initialize as \
\[OpenCurlyDoubleQuote]Lplus\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]Lminus\[CloseCurlyDoubleQuote] what would actually be \
\[OpenCurlyDoubleQuote]Lplus / sin \[Theta]\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]Lminus / sin \[Theta]\[CloseCurlyDoubleQuote] minus \
their derivative term:\
\>", "Text",
 CellChangeTimes->{{3.9850652623266983`*^9, 3.985065264986702*^9}, {
  3.9902512328852596`*^9, 3.9902513348909016`*^9}, {3.9902513666039486`*^9, 
  3.9902515504109974`*^9}},ExpressionUUID->"f5aa4d53-5046-a945-98ca-\
e026fdf7c0e0"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"Lplus", ",", "Lminus"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lplus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"]}]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"s", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"s", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.981783946242859*^9, 3.981783975318748*^9}, {
  3.981785464292274*^9, 3.981785508449151*^9}, {3.981786268601119*^9, 
  3.981786270435828*^9}, {3.9817864510815077`*^9, 3.981786479650158*^9}, {
  3.981788690484048*^9, 3.981788696319776*^9}, {3.981797099419589*^9, 
  3.98179710264193*^9}, {3.98199039390654*^9, 3.9819904244803867`*^9}, {
  3.98199045539818*^9, 3.9819904565252533`*^9}, {3.9859443904049644`*^9, 
  3.985944410636242*^9}, {3.985946724114273*^9, 3.985946726798132*^9}, {
  3.985946797047308*^9, 3.9859468073324375`*^9}, {3.986005231110489*^9, 
  3.986005235441969*^9}, {3.9860053507705383`*^9, 3.986005375355421*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"58e2e56a-8279-4d46-8fdb-0a73e0ace3ed"],

Cell["\<\
We expand  each operator using the following module and then save the \
coefficients in a list.\
\>", "Text",
 CellChangeTimes->{{3.985065022328207*^9, 3.9850650296938744`*^9}, {
  3.98594612303673*^9, 3.9859461317535095`*^9}, {3.990251562539604*^9, 
  3.9902515980822964`*^9}, {3.9902516396290092`*^9, 
  3.990251670120947*^9}},ExpressionUUID->"a7c79e04-6a30-5245-81ab-\
62c6c4004f96"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "OperatorCoefficientList", "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "extracts", " ", "the", " ", "coefficients", " ", "in", " ", "the", " ", 
     "expansion", " ", "of", " ", "the", " ", "spin", " ", 
     RowBox[{"raising", "/", "lowering"}], " ", "operators"}], ",", " ", 
    RowBox[{
     RowBox[{
     "and", " ", "flips", " ", "the", " ", "signs", " ", "for", " ", "x"}], "=",
      "1"}]}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"OperatorCoefficientList", "[", 
   RowBox[{"F_", ",", " ", "x_", ",", " ", "x0_", ",", " ", "max_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "i", "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x0", " ", "==", " ", "1"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", "i"}], ",", " ", "1"}], "]"}], 
        " ", "*", " ", 
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{"F", ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "x0", ",", " ", "i"}], "}"}]}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "max"}], "}"}]}], "\n", "  ", "]"}], 
     "]"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9859443438359184`*^9, 3.9859443851887665`*^9}, {
   3.985944422186575*^9, 3.985944442455391*^9}, {3.9859445483058815`*^9, 
   3.985944548473675*^9}, {3.9859445863577785`*^9, 3.9859445879064445`*^9}, {
   3.9859446228265953`*^9, 3.985944635607939*^9}, {3.9859446946161957`*^9, 
   3.9859447114420223`*^9}, {3.9859447523787575`*^9, 
   3.9859447758753567`*^9}, {3.985945065983959*^9, 3.985945074500412*^9}, {
   3.9859453895038357`*^9, 3.985945623610239*^9}, 3.9859456995131245`*^9, {
   3.9859459420995197`*^9, 3.9859459706312733`*^9}, {3.9859461040030785`*^9, 
   3.9859461088189125`*^9}, {3.985946286621483*^9, 3.9859463348067493`*^9}, {
   3.985946412024767*^9, 3.985946466275549*^9}, {3.98594674374498*^9, 
   3.9859467682476215`*^9}, {3.986003902957672*^9, 3.98600391128734*^9}, {
   3.99025160264579*^9, 3.9902516116487274`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"718f56b0-2685-3e49-93a7-0020cdca239b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "and", " ", "store", " ", "the", " ", "operator", " ", 
    "coefficient", " ", "lists"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"RCoeff", ",", "LCoeff"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"LCoeff", ":=", 
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lplus", "[", "x", "]"}], ",", "x", ",", "1", ",", "2"}], 
     "]"}]}], "\n", 
   RowBox[{"RCoeff", ":=", 
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lminus", "[", "x", "]"}], ",", "x", ",", "1", ",", "2"}], 
     "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"operator", ",", " ", "variable", ",", " ", 
     RowBox[{"location", " ", "of", " ", "expansion"}], ",", " ", 
     RowBox[{"order", " ", "of", " ", "expansion"}]}], " ", 
    "*)"}]}]}]], "Code",
 CellChangeTimes->{{3.9859468754586983`*^9, 3.985946909416916*^9}, {
  3.98594743992684*^9, 3.9859474459937973`*^9}, {3.9859475651430664`*^9, 
  3.985947567311878*^9}, {3.9859476828940697`*^9, 3.985947755531189*^9}, {
  3.9859498590856724`*^9, 3.9859498965331287`*^9}, {3.9860053856421833`*^9, 
  3.986005393166157*^9}, {3.987646628803072*^9, 3.9876466421317596`*^9}, {
  3.9902517024592495`*^9, 3.9902517062107544`*^9}, {3.990251746296608*^9, 
  3.990251753344225*^9}},ExpressionUUID->"7ac80b39-c8b8-a344-91cf-\
069d00d39781"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "compute", " ", "these", " ", "to", " ", "check", " ", "that", " ", "the", 
    " ", "expansions", " ", "are", " ", "the", " ", "ones", " ", "we", " ", 
    "are", " ", "familiar", " ", "with"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lplus", "[", "x", "]"}], ",", "x", ",", " ", "1", ",", "2"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"OperatorCoefficientList", "[", 
     RowBox[{
      RowBox[{"Lminus", "[", "x", "]"}], ",", "x", ",", " ", "1", ",", "2"}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9859455400909824`*^9, 3.985945549276245*^9}, {
   3.985945628911381*^9, 3.985945651477564*^9}, {3.985945705861429*^9, 
   3.9859457423296432`*^9}, {3.9859459826492157`*^9, 3.98594598451581*^9}, {
   3.985946047834099*^9, 3.985946052968748*^9}, {3.9859466759798107`*^9, 
   3.9859466807967567`*^9}, {3.9859468250974903`*^9, 3.98594682731534*^9}, {
   3.9859474996782665`*^9, 3.985947512011343*^9}, {3.9860039222065887`*^9, 
   3.986003934333267*^9}, {3.9860054006126137`*^9, 3.986005418455759*^9}, {
   3.9860056602663517`*^9, 3.9860056665519695`*^9}, 3.9860223157309113`*^9, 
   3.9876466008735447`*^9, 3.98766307809268*^9, 3.990251709961851*^9, {
   3.990252189636202*^9, 3.990252190479948*^9}},

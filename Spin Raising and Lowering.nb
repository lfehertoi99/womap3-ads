Cell[CellGroupData[{

Cell["Expansion of spin raising /lowering operators", "Section",
 CellChangeTimes->{{3.985078526441988*^9, 3.985078540540991*^9}, {
  3.985159845483364*^9, 
  3.9851598531906223`*^9}},ExpressionUUID->"94dfd297-647f-d949-b60e-\
5e5da2cfc925"],

Cell["Firstly, recall that the operators look like this:  ", "Text",
 CellChangeTimes->{{3.9850648662688026`*^9, 3.9850650053084774`*^9}, {
  3.985065220018097*^9, 
  3.9850652324101276`*^9}},ExpressionUUID->"f36e6176-d54a-d84e-ace6-\
cd449d32f89a"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}], "\n", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["m", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
     FractionBox[
      RowBox[{"s", "*", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["k", "2"], 
          SuperscriptBox["x", "2"]}]}], ")"}]}]]}], ")"}]}]}]}], "Text",
 CellChangeTimes->{{3.981783547808112*^9, 3.981783676409051*^9}, {
  3.981786079998436*^9, 3.981786082213542*^9}, {3.981797064465685*^9, 
  3.981797067385528*^9}},ExpressionUUID->"ab5026fa-01fc-894e-80c3-\
492331b1efd7"]], "Text",
 CellChangeTimes->{{3.9850652373558865`*^9, 
  3.9850652409425697`*^9}},ExpressionUUID->"6a62147e-083b-7848-a9a3-\
340bb1faffbc"],

Cell["Since what we want to apply repeatedly is ", "Text",
 CellChangeTimes->{{3.9850652463759193`*^9, 
  3.9850652494589977`*^9}},ExpressionUUID->"b552890a-d0e4-9a49-9793-\
4e1a84345060"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  FractionBox["Lplus", 
   RowBox[{"Sin", "[", "\[Theta]", "]"}]], "=", 
  RowBox[{
   RowBox[{
    FractionBox["Lplus", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]], "        ", "or", "         ", 
    FractionBox["Lminus", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]]}], "=", 
   FractionBox["Lminus", 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["x", "2"]}]]]}]}]], "Text",
 CellChangeTimes->{{3.9817837581531963`*^9, 
  3.98178382239657*^9}},ExpressionUUID->"db48248c-6805-5946-b9ab-\
3d05554c4085"]], "Text",
 CellChangeTimes->{{3.985065254686611*^9, 
  3.9850652579892826`*^9}},ExpressionUUID->"dbf74f9f-d174-b84e-9b29-\
6d4e6791da87"],

Cell["\<\
We will work (computationally) with the renormalised operators. where we now \
include the derivative term:\
\>", "Text",
 CellChangeTimes->{{3.9850652623266983`*^9, 
  3.985065264986702*^9}},ExpressionUUID->"7047eb30-3198-5a4a-a0f0-\
67fc9433cb07"],

Cell[TextData[Cell[BoxData[{
 RowBox[{"Lplus", "  ", "=", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "+", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Lminus", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "d"}], "/", "dx"}], " ", "-", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"]}]}], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], 
       SuperscriptBox["k", "2"], 
       SuperscriptBox["x", "2"]}]}]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["m", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], " ", "+", " ", 
   FractionBox[
    RowBox[{"s", "*", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}]}], "Text",
 CellChangeTimes->{{3.9817839028112392`*^9, 3.9817839285593576`*^9}, {
  3.981786261883848*^9, 3.9817862639400682`*^9}, {3.981797077438373*^9, 
  3.981797096430489*^9}},ExpressionUUID->"f343112d-85df-7b4d-b117-\
df50e880ccfa"]], "Text",
 CellChangeTimes->{{3.985065270280943*^9, 
  3.9850652737887745`*^9}},ExpressionUUID->"9f5d2cc5-5f87-254b-b30d-\
9739bda9a731"],

Cell["\<\
NOTE THAT THE MINUS OPERATOR RAISES THE SPIN AND THE PLUS OPERATOR LOWERS THE \
SPIN.\
\>", "Text",
 CellChangeTimes->{{3.985156188971203*^9, 
  3.985156205030262*^9}},ExpressionUUID->"ca3c2be7-4695-244e-96b4-\
44968483ed0c"],

Cell["\<\
Now, we want to compute the expansions of these operators near x=-1. Since \
the derivative term is of 0th order in x, as far as the expansions are \
concerned, we only need to consider \
\>", "Text",
 CellChangeTimes->{
  3.9850652780954456`*^9, {3.986347391286442*^9, 
   3.9863473922308826`*^9}},ExpressionUUID->"1caceed0-e4f9-ec4d-9f7e-\
095c6f4f9f34"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"Lplus", ",", "Lminus"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lplus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"]}]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"s", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[

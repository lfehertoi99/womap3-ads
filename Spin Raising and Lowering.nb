Cell[CellGroupData[{
Cell["Angular ODE", "Title",
 CellChangeTimes->{{3.986347502315937*^9, 
  3.986347506917862*^9}},ExpressionUUID->"a1bfa8a2-7039-3243-868e-\
51c5c15ebd44"],

Cell[CellGroupData[{

Cell["Initialisation of solutions S1, S2, S3, S4", "Section",
 CellChangeTimes->{{3.984798512038782*^9, 3.984798514695101*^9}, {
  3.98515981445916*^9, 
  3.985159822009365*^9}},ExpressionUUID->"396c3bf5-fbf6-7340-ad7b-\
5e0fbdd2e16d"],

Cell["\<\
We compute the exponent \
\[OpenCurlyDoubleQuote]Sigma_n\[CloseCurlyDoubleQuote] and the coefficient \
list \[OpenCurlyDoubleQuote]Coeffs_n\[CloseCurlyDoubleQuote] in the \
master_frobenius notebook using the angular expansion block /without/ \
absolute values, i.e. we manually input the desired roots of the indicial \
equation (which correspond to the values of \[OpenCurlyDoubleQuote]Sigma_n\
\[CloseCurlyDoubleQuote]) and use the Frobenius algorithm to obtain the \
correspondent solution. Below, we can print out the data for solution to \
check that it looks correct.\
\>", "Text",
 CellChangeTimes->{{3.985077583144577*^9, 3.98507761444042*^9}, {
  3.9851594945808926`*^9, 3.985159514354103*^9}, {3.9854017493911686`*^9, 
  3.9854018993984547`*^9}},ExpressionUUID->"47cd35ba-41ce-374e-8391-\
5e95cc81203b"],


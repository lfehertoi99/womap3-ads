Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "OperatorCoefficientList", "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "a", " ", "function", " ", "that", " ", "extracts", " ", "the", " ", 
     "coefficients", " ", "in", " ", "the", " ", "expansion", " ", "of", " ", 
     "the", " ", "spin", " ", "raising", " ", "and", " ", "lowering", " ", 
     "operators"}], ",", " ", 
    RowBox[{
     RowBox[{
     "and", " ", "flips", " ", "the", " ", "signs", " ", "for", " ", "x"}], "=",
      "1"}]}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"OperatorCoefficientList", "[", 
   RowBox[{"F_", ",", " ", "x_", ",", " ", "x0_", ",", " ", "max_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "i", "}"}], ",", "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x0", " ", "==", " ", "1"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", "i"}], ",", " ", "1"}], "]"}], 
        " ", "*", " ", 
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{"F", ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "x0", ",", " ", "i"}], "}"}]}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "max"}], "}"}]}], "\n", "  ", "]"}], 
     "]"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9859443438359184`*^9, 3.9859443851887665`*^9}, {

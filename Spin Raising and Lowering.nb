Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"\<\"final sigma\"\>", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      FractionBox[
       RowBox[{"m", "+", "s"}], "2"]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 

Cell[CellGroupData[{

Cell["Spin Raising or Spin Lowering multiple times", "Section",
 CellChangeTimes->{{3.9859486914009266`*^9, 3.9859487015987225`*^9}, {
  3.9859488197036724`*^9, 
  3.9859488219867992`*^9}},ExpressionUUID->"5ae28385-5433-8a44-945c-\
94f9f11343b2"],

Cell["\<\
Due to the similarities between the structure of the two operators, we write \
a single piece of code to implement their repeated application, for both \
regular singular points. Note that to compute the first N elements in the \
final series expansion, we need the first N coefficients of the initial \
solution and the first N-1 coefficients in the operator expansion -- the code \
should tell us if the objects have the appropriate length.

Before using this piece of code, we have to separately initialize:

1. \[OpenCurlyDoubleQuote]operator\[CloseCurlyDoubleQuote] = list of \
coefficients in the power series expansion of the operator at either x=+1 or \
x=-1;
2. \[OpenCurlyDoubleQuote]coeffs0\[CloseCurlyDoubleQuote] = list of \
coefficients of the initial solution;
3. \[OpenCurlyDoubleQuote]sigma0\[CloseCurlyDoubleQuote] = the initial \
exponent.

Then the code can compute the correct expansion provided that we also feed it \
with:

4. \[OpenCurlyDoubleQuote]x0\[CloseCurlyDoubleQuote] = the location of the \
asymptotic expansion, either x=+1 or x=-1; 
5. \[OpenCurlyDoubleQuote]spin\[CloseCurlyDoubleQuote] = the spin value, to \
determine the number of applications (2 spin) and plug-in at the very end;
6. \[OpenCurlyDoubleQuote]maxOrder\[CloseCurlyDoubleQuote] = maximum order of \
the expansion.\
\>", "Text",
 CellChangeTimes->{{3.985948826968508*^9, 3.9859489238956776`*^9}, {
  3.9859489887370815`*^9, 3.9859490114253273`*^9}, {3.9860039900974464`*^9, 
  3.986004097044258*^9}, {3.9860041841521797`*^9, 3.986004251451576*^9}, {
  3.9860051349779453`*^9, 3.9860051353382206`*^9}, {3.986348736732456*^9, 
  3.9863487656138306`*^9}, {3.986349495591881*^9, 3.9863495004867363`*^9}, {
  3.986349531364847*^9, 3.9863495326655197`*^9}, {3.9863495827439594`*^9, 
  3.986349675398117*^9}},ExpressionUUID->"c4fa597b-6822-d340-b2b8-\
fba8bebe90ad"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "ApplyOperator", "]"}], "\n", 
 RowBox[{
  RowBox[{"ApplyOperator", "[", 
   RowBox[{
   "operator_", ",", " ", "x0_", ",", " ", "coeffs0_", ",", " ", "sigma0_", ",",
     " ", "spin_", ",", " ", "maxOrder_"}], "]"}], " ", ":=", " ", "\n", "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sigma", ",", " ", "c", ",", " ", "dq"}], "}"}], ",", "\n", "\n",
     "    ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Operator", " ", 
       RowBox[{"coefficients", ":", " ", 
        RowBox[{"dq", "[", "q", "]"}]}]}], " ", "=", " ", 
      RowBox[{
      "coefficient", " ", "of", " ", "order", " ", "q", " ", "in", " ", "the",
        " ", "expansion"}]}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"dq", "[", "q_", "]"}], " ", ":=", " ", 
      RowBox[{"operator", "[", 
       RowBox[{"[", 
        RowBox[{"q", " ", "+", " ", "2"}], "]"}], "]"}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"shift", ":", " ", 
        RowBox[{"index", " ", "1"}]}], " ", "=", " ", 
       RowBox[{"power", " ", "-", "1"}]}], " ", "*)"}], "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Base", " ", "cases"}], " ", "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "0", "]"}], " ", "=", " ", "sigma0"}], ";", "\n", 
     "    ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"k", ",", " ", "0"}], "]"}], " ", "=", " ", 
        RowBox[{"coeffs0", "[", 
         RowBox[{"[", 
          RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursion", " ", "for", " ", "sigma"}], " ", "*)"}], "\n", 
     "    ", 
     RowBox[{
      RowBox[{"sigma", "[", "j_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"sigma", "[", "j", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "-", " ", "1"}]}]}], ";",
      "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursion", " ", "for", " ", "coefficients"}], " ", "*)"}], 
     "\n", "    ", 
     RowBox[{
      RowBox[{"c", "[", 
       RowBox[{"k_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"k", ",", " ", "j"}], "]"}], " ", "=", " ", 
       RowBox[{"FullSimplify", "[", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"x0", "==", 
             RowBox[{"-", "1"}]}], ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], "*", 
          RowBox[{"c", "[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"j", " ", "-", " ", "1"}]}], "]"}], " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"j", " ", "-", " ", "1"}], "]"}], " ", "+", " ", "k", 
            " ", "+", " ", 
            RowBox[{"dq", "[", 
             RowBox[{"-", "1"}], "]"}]}], ")"}]}], " ", "+", "\n", "      ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"p", ",", " ", 
              RowBox[{"j", " ", "-", " ", "1"}]}], "]"}], " ", "*", " ", 
            RowBox[{"dq", "[", 
             RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "p"}], "]"}]}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "0", ",", " ", 
             RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "\n", 
        "    ", "]"}]}]}], ";", "\n", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Return", " ", "result", " ", 
       RowBox[{"after", " ", "'"}], "2", " ", 
       RowBox[{"spin", "'"}], " ", "applications"}], " ", "*)"}], "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"2", "*", "spin"}], "]"}], " ", "/.", 
        RowBox[{"s", "->", "spin"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"2", "*", "spin"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}],
         "/.", " ", 
        RowBox[{"s", "->", "spin"}]}]}], "}"}]}]}], "\n", "  ", 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.98594871368099*^9, 3.985948771582941*^9}, {
  3.9860039717644997`*^9, 3.986003980630707*^9}, {3.9860041050661507`*^9, 
  3.98600413244442*^9}, {3.9860041695070477`*^9, 3.9860041701476116`*^9}, {
  3.98600473979735*^9, 3.9860047484090137`*^9}, {3.9860050296265507`*^9, 
  3.9860050297047024`*^9}, {3.9860054445063725`*^9, 3.9860054445735188`*^9}, {
  3.9860054787745132`*^9, 3.986005543871521*^9}, {3.986348448968731*^9, 
  3.9863484651403255`*^9}, {3.986348512294136*^9, 3.9863485399133186`*^9}, {
  3.986348677094364*^9, 3.986348724395376*^9}, {3.98634955366296*^9, 
  3.98634957236652*^9}},ExpressionUUID->"cedda11b-c8b4-0f4b-ae6f-\
5e6cc4eab97d"],

Cell[BoxData[
 RowBox[{"ApplyOperator", "[", 
  RowBox[{
  "LCoeff", ",", " ", "1", ",", "  ", "coeffs1", ",", " ", "sigma1", ",", " ", 
   RowBox[{"1", "/", "2"}], ",", " ", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.9860048274463024`*^9, 3.986004840147663*^9}, {
  3.9860049049755096`*^9, 3.986004928360449*^9}, {3.986004975558527*^9, 
  3.986004991430889*^9}, {3.986005036435566*^9, 3.986005058446903*^9}, {
  3.986005427642601*^9, 3.986005428239464*^9}, {3.9863484713895283`*^9, 
  3.9863484724804153`*^9}, {3.986348516447384*^9, 3.986348516889267*^9}, {
  3.9863497121240387`*^9, 
  3.9863497227725506`*^9}},ExpressionUUID->"27bc98b5-1128-214e-929b-\
218e7b8ef304"]
}, Closed]],

Cell[CellGroupData[{

Cell["Lowering + Raising", "Section",
 CellChangeTimes->{{3.9854077965379333`*^9, 
  3.9854078089895573`*^9}},ExpressionUUID->"cd962781-b5f1-a84f-aa85-\
4429e8053a21"],

Cell["\<\
When spin lowering and raising, or viceversa, we also have to multiply by the \
factor\
\>", "Text",
 CellChangeTimes->{{3.985407816039095*^9, 3.9854078476008453`*^9}, {
  3.9854079412630615`*^9, 3.9854079415925694`*^9}, {3.986350219495289*^9, 
  3.9863502264978027`*^9}},ExpressionUUID->"d5bb79f3-f831-4843-ad46-\
9942205c3b16"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          SqrtBox[
           SubscriptBox["\[CapitalDelta]", "\[Theta]"]], 
          RowBox[{"2", 
            StyleBox["s", "TI"]}]], 
         SuperscriptBox[
          SqrtBox[
           RowBox[{"1", "-", 
             SuperscriptBox[
              StyleBox["x", "TI"], "2"]}]], 
          RowBox[{"2", 
            StyleBox["s", "TI"]}]]}], TraditionalForm], "errors" -> {}, 

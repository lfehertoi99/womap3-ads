Cell["\<\
NOTE THAT THE MINUS OPERATOR RAISES THE SPIN AND THE PLUS OPERATOR LOWERS THE \
SPIN.\
\>", "Text",
 CellChangeTimes->{{3.985156188971203*^9, 
  3.985156205030262*^9}},ExpressionUUID->"ca3c2be7-4695-244e-96b4-\
44968483ed0c"],

Cell["\<\
Now, we want to compute the expansions of these operators near x=-1. Since \
the derivative term is of 0th order in x, as far as the expansions are \
concerned, we only need to consider \
\>", "Text",
 CellChangeTimes->{
  3.9850652780954456`*^9, {3.986347391286442*^9, 
   3.9863473922308826`*^9}},ExpressionUUID->"1caceed0-e4f9-ec4d-9f7e-\
095c6f4f9f34"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"Lplus", ",", "Lminus"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lplus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"]}]}], 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox["k", "2"], 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"s", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminus", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"]}]}], 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}]]}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["m", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]], "-", "\[Nu]"}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"s", "*", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SuperscriptBox["x", "2"]}], "-", "1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["a", "2"], 
         SuperscriptBox["k", "2"], 
         SuperscriptBox["x", "2"]}]}], ")"}]}]]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.981783946242859*^9, 3.981783975318748*^9}, {
  3.981785464292274*^9, 3.981785508449151*^9}, {3.981786268601119*^9, 

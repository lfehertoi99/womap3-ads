Cell[CellGroupData[{

Cell["Lowering + Raising", "Section",
 CellChangeTimes->{{3.9854077965379333`*^9, 
  3.9854078089895573`*^9}},ExpressionUUID->"cd962781-b5f1-a84f-aa85-\
4429e8053a21"],

Cell["\<\
When spin lowering and raising, or viceversa, we also have to multiply by the \
factor\
\>", "Text",
 CellChangeTimes->{{3.985407816039095*^9, 3.9854078476008453`*^9}, {
  3.9854079412630615`*^9, 3.9854079415925694`*^9}, {3.986350219495289*^9, 
  3.9863502264978027`*^9}},ExpressionUUID->"d5bb79f3-f831-4843-ad46-\
9942205c3b16"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          SqrtBox[
           SubscriptBox["\[CapitalDelta]", "\[Theta]"]], 
          RowBox[{"2", 
            StyleBox["s", "TI"]}]], 
         SuperscriptBox[
          SqrtBox[
           RowBox[{"1", "-", 
             SuperscriptBox[
              StyleBox["x", "TI"], "2"]}]], 
          RowBox[{"2", 
            StyleBox["s", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "{\\sqrt{\\Delta_{\\theta}}^{2s}{\\sqrt{1-x^2}}^{2s}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e462574f-0b9f-5740-9d9b-013c0ded1f6a"],
 "."
}], "Text",
 CellChangeTimes->{3.9854078537699795`*^9, 
  3.9863499960246296`*^9},ExpressionUUID->"8ea73933-de53-8148-b46c-\
93e4fc1b2dce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MultiplyByFactor", "[", 
   RowBox[{
   "x0_", ",", "sigma_", ",", "coeffs_", ",", "spin_", ",", "maxOrder_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"factor", ",", " ", "FactorCoeffs", ",", "newCoeffs"}], "}"}], ",",
     "\n", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "multiplicative", " ", "factor"}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"factor", "[", "x_", "]"}], ":=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           SuperscriptBox["a", "2"], 
           SuperscriptBox["k", "2"], 
           SuperscriptBox["x", "2"]}]}], ")"}], "spin"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}], ")"}], "spin"]}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Taylor", " ", "coefficients", " ", "of", " ", 
       RowBox[{"factor", "[", "x", "]"}], " ", "around", " ", "x0"}], "*)"}], 
     "\n", 
     RowBox[{"FactorCoeffs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"x0", "==", "1"}], ",", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "n"], ",", " ", "1"}], "]"}], "*", 
          RowBox[{"SeriesCoefficient", "[", 
           RowBox[{
            RowBox[{"factor", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "x0", ",", "n"}], "}"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "maxOrder"}], "}"}]}], "]"}]}], ";", 
     "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Convolution", ":", " ", 
        RowBox[{
         RowBox[{"new", " ", "j"}], "-", 
         RowBox[{"th", " ", "coefficient"}]}]}], " ", "=", " ", 
       RowBox[{"Sum_", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", "=", "0"}], "}"}], "^", 
         RowBox[{"{", "j", "}"}]}], " ", "g_p", "*", "c_", 
        RowBox[{"{", 
         RowBox[{"j", "-", "p"}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newCoeffs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"FactorCoeffs", "[", 
             RowBox[{"[", 
              RowBox[{"p", "+", "1"}], "]"}], "]"}], "*", 
            RowBox[{"coeffs", "[", 
             RowBox[{"[", 
              RowBox[{"j", "-", "p", "+", "1"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "0", ",", "j"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "maxOrder"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sigma", "+", "spin"}], ",", "newCoeffs"}], "}"}]}]}], 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.9881952867273903`*^9, 3.9881953480167522`*^9}, {
  3.9882570699687576`*^9, 3.988257176989252*^9}, {3.9882572160163326`*^9, 
  3.9882573065281563`*^9}, {3.988257395698908*^9, 3.9882574183984127`*^9}, {
  3.9882574817526817`*^9, 3.9882574924041862`*^9}, {3.988257562451441*^9, 
  3.988257572350954*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"67f88c49-60d7-3f48-906e-c1c7675fcc6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LoweringRaising", "[", 
   RowBox[{
   "x0_", ",", " ", "coeff0_", ",", " ", "sigma0_", ",", " ", "spin_", ",", 
    " ", "maxOrder_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sigmaL", ",", " ", "coeffsL", ",", " ", "sigmaLfactor", ",", " ", 
      "coeffsLfactor", ",", " ", "sigmaR", ",", " ", "coeffsR", ",", " ", 
      "sigmaFinal", ",", " ", "coeffsFinal"}], "}"}], ",", "\n", "  ", "\n", 
    "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Step", " ", "1"}], ":", " ", 
      RowBox[{
      "Lower", " ", "2", "spin", " ", "times", " ", "using", " ", 
       "LCoeff"}]}], " ", "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sigmaL", ",", " ", "coeffsL"}], "}"}], " ", "=", " ", 
      RowBox[{"ApplyOperator", "[", 
       RowBox[{
       "LCoeff", ",", " ", "x0", ",", " ", "coeff0", ",", " ", "sigma0", ",", 

        " ", "*", " ", 
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{"F", ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "x0", ",", " ", "i"}], "}"}]}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "max"}], "}"}]}], "\n", "  ", "]"}], 

 CellLabel->"In[52]:=",ExpressionUUID->"15264a7a-69a3-934c-ac23-485e6961bb76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "and", " ", "store", " ", "the", " ", "operator", " ", 
    "coefficient", " ", "lists", " ", "as", " ", "functions", " ", "of", " ", 

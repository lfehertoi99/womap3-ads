                RowBox[{"4", "-", 
                 RowBox[{"4", " ", 
                  SuperscriptBox["a", "2"]}]}]], "+", "\[Nu]"}], ")"}]}], "+", 
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "m"}], " ", 
                RowBox[{"(", 
                 RowBox[{"3", "+", "m"}], ")"}]}], "+", "s", "+", 
               SuperscriptBox["s", "2"], "-", 
               RowBox[{"4", " ", "s", " ", "\[Nu]"}], "+", 

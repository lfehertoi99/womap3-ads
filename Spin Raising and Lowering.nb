Cell[BoxData[
 RowBox[{
  RowBox[{"LoweringRaising", "[", 
   RowBox[{
   "x0_", ",", " ", "coeff0_", ",", " ", "sigma0_", ",", " ", "spin_", ",", 
    " ", "maxOrder_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sigmaL", ",", " ", "coeffsL", ",", " ", "sigmaLfactor", ",", " ", 
      "coeffsLfactor", ",", " ", "result"}], "}"}], ",", "\n", "  ", "\n", 
    "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Step", " ", "1"}], ":", " ", 
      RowBox[{
      "Lower", " ", "2", "spin", " ", "times", " ", "using", " ", 
       "LCoeff"}]}], " ", "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sigmaL", ",", " ", "coeffsL"}], "}"}], " ", "=", " ", 
      RowBox[{"ApplyOperator", "[", 
       RowBox[{
       "LCoeff", ",", " ", "x0", ",", " ", "coeff0", ",", " ", "sigma0", ",", 
        " ", "spin", ",", " ", "maxOrder"}], "]"}]}], ";", "\n", "  ", "\n", 
     "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Step", " ", "2"}], ":", " ", 
       RowBox[{"Multiply", " ", "by", " ", "factor"}]}], " ", "*)"}], "\n", 
     "  ", 
     RowBox[{"sigmaLfactor", "   ", "=", " ", 
      RowBox[{"sigmaL", " ", "+", " ", "spin"}]}], ";", "\n", "  ", 
     RowBox[{"coeffsLfactor", "  ", "=", " ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"x0", "==", "1"}], ",", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "spin"], ",", " ", "1"}], "]"}], "*", 
       " ", 
       RowBox[{"2", "^", "spin"}], " ", "*", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"a", "^", "2"}], " ", 
           RowBox[{"k", "^", "2"}]}]}], ")"}], "^", "spin"}], " ", "*", " ", 
       "coeffsL"}]}], ";", "\n", "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Step", " ", "3"}], ":", " ", 
       RowBox[{
       "Raise", " ", "2", " ", "spin", " ", "times", " ", "using", " ", 
        "RCoeff"}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sigmaR", ",", " ", "coeffsR"}], "}"}], " ", "=", " ", 
      RowBox[{"ApplyOperator", "[", 
       RowBox[{
       "RCoeff", ",", " ", "x0", ",", " ", "coeffsLfactor", ",", " ", 
        "sigmaLfactor", ",", " ", "spin", ",", " ", "maxOrder"}], "]"}]}], ";",
      "\n", "  ", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Step", " ", "4"}], ":", " ", 
       RowBox[{"Multiply", " ", "by", " ", "factor", " ", "again"}]}], " ", 
      "*)"}], "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{"\"\<final sigma\>\"", " ", "->", " ", 
         RowBox[{"sigmaR", " ", "+", " ", "spin"}]}], " ", 
        RowBox[{"(*", 
         RowBox[{"/.", " ", 
          RowBox[{"s", "->", "spin"}]}], "*)"}], "|>"}], ",", " ", "\n", 
       "   ", 
       RowBox[{"<|", 
        RowBox[{"\"\<final coefficients\>\"", " ", "->", " ", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x0", "==", "1"}], ",", " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "spin"], ",", " ", "1"}], "]"}], "*",
            " ", 
           RowBox[{"2", "^", "spin"}], " ", "*", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{
               RowBox[{"a", "^", "2"}], " ", 
               RowBox[{"k", "^", "2"}]}]}], ")"}], "^", "spin"}], " ", "*", 
           " ", "coeffsR"}], "  ", 
          RowBox[{"(*", 
           RowBox[{"/.", " ", 
            RowBox[{"s", "->", "spin"}]}], "*)"}], "]"}]}], "|>"}]}], 
      "}"}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{{3.9854083286611423`*^9, 3.985408440926449*^9}, {
  3.985408478422676*^9, 3.9854088175622253`*^9}, {3.985408868295431*^9, 
  3.9854090003689613`*^9}, {3.985409144008524*^9, 3.9854091475954285`*^9}, {
  3.9854092602934647`*^9, 3.9854092648298244`*^9}, {3.9860070971285076`*^9, 
  3.986007153456335*^9}, {3.98600719193219*^9, 3.986007238799402*^9}, {
  3.9860082624261456`*^9, 3.9860083006443977`*^9}, {3.9863498008677273`*^9, 
  3.986349802391815*^9}, {3.986350088372793*^9, 3.986350129313175*^9}, {
  3.9863501630624676`*^9, 3.9863501674959545`*^9}, {3.9876469680485954`*^9, 
  3.9876469795996*^9}, {3.9876483269976673`*^9, 3.9876483297325935`*^9}, {
  3.987648359786829*^9, 3.9876483632245445`*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"d1259203-fb32-414d-9742-3c091e21c9a9"],


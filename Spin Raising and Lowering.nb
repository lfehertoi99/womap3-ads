Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"\<\"final sigma\"\>", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox[
       RowBox[{"m", "+", "s"}], "2"]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"\<\"final coefficients\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SqrtBox[
          RowBox[{"1", "-", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["k", "2"]}]}]]}], " ", 
        RowBox[{"(", 
         RowBox[{"m", "+", "s"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "s"}]}], ")"}]}], ",", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["k", "2"]}]}]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", 
           RowBox[{"(", 
            RowBox[{"m", "+", "s"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 RowBox[{"5", " ", 
                  SuperscriptBox["a", "2"]}]}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"m", "+", "s"}], ")"}]}], 
              RowBox[{"4", "-", 
               RowBox[{"4", " ", 
                SuperscriptBox["a", "2"]}]}]], "+", "\[Nu]"}], ")"}]}], "+", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "2"], "+", "s"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "m"}], " ", 
               RowBox[{"(", 
                RowBox[{"2", "+", "m"}], ")"}]}], "+", 
              SuperscriptBox["s", "2"], "-", 
              RowBox[{"4", " ", "s", " ", "\[Nu]"}], "+", 
              RowBox[{"2", " ", 
               SuperscriptBox["a", "4"], " ", "\[Nu]", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "2"}], " ", "m"}], "+", "\[Nu]"}], ")"}]}], "+", 
              RowBox[{
               SuperscriptBox["a", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"4", "+", 
                 RowBox[{"5", " ", "m", " ", 
                  RowBox[{"(", 
                   RowBox[{"2", "+", "m"}], ")"}]}], "+", 
                 RowBox[{"3", " ", 
                  SuperscriptBox["s", "2"]}], "-", 
                 RowBox[{"4", " ", "\[Nu]"}], "+", 
                 RowBox[{"4", " ", 
                  RowBox[{"(", 
                   RowBox[{"m", "+", "s"}], ")"}], " ", "\[Nu]"}], "-", 
                 RowBox[{"4", " ", 
                  SuperscriptBox["\[Nu]", "2"]}]}], ")"}]}], "+", 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"\[Lambda]", "+", 
                 RowBox[{"\[Nu]", " ", 
                  RowBox[{"(", 
                   RowBox[{"2", "+", "\[Nu]"}], ")"}]}]}], ")"}]}]}], ")"}]}], 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}]]]}], ")"}]}]}], "}"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.987646790191061*^9, 3.987646997626665*^9, {3.9876483083255043`*^9, 
   3.987648337140421*^9}, {3.987648368866871*^9, 3.987648385999151*^9}, 

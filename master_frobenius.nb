42e213b9be90"],

Cell["\<\
Note that this block is essentially the same as HorizonExpansion, but we copy \
it here and give it a different name because we might modify the \
HorizonExpansion block to address the horizon location problem.\
\>", "Text",
 CellChangeTimes->{{3.9785862916600475`*^9, 3.9785863511027737`*^9}, {
  3.9785911134584503`*^9, 
  3.9785911144583244`*^9}},ExpressionUUID->"fa32d067-a3fd-4f45-9c0d-\
0f78b0a69e97"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "AngularExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AngularExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
     "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "F1coeffs", ",", " ", "F2coeffs", ",", 
       " ", "indicial", ",", " ", "coeffs", ",", " ", "polyVar", ",", " ", 
       "poly", ",", " ", "root1", ",", " ", "root2", ",", " ", "result1", ",",
        " ", "result2", ",", " ", "k"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{
      RowBox[{"F1coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F1expr", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"F2coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F2expr", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "     ", "\n", "    ", 
      RowBox[{"coeffs", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"F2coeffs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", " ", "1"}], 
        "}"}]}], ";", "\n", "    ", 
      RowBox[{"polyVar", " ", "=", " ", 
       RowBox[{"Unique", "[", "x", "]"}]}], ";", "\n", "\t", 
      RowBox[{"poly", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"coeffs", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
          RowBox[{"polyVar", "^", "k"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
      "\n", "\t", 
      RowBox[{"root1", " ", "=", " ", 
       RowBox[{"polyVar", " ", "/.", " ", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"root2", " ", "=", " ", 
       RowBox[{"polyVar", " ", "/.", " ", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], 
          "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"indicial", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"poly", " ", "/.", " ", 
           RowBox[{"polyVar", " ", "->", " ", "n"}]}], "]"}]}], "]"}]}], ";", 
      " ", "\n", "   ", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Compute", " ", "using", " ", "root1"}], " ", "*)"}], "\n", 
      "\t", 
      RowBox[{"result1", " ", "=", " ", 
       RowBox[{"Catch", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"A1", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
         "\t\t", 
         RowBox[{
          RowBox[{"A1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
           RowBox[{"k", " ", "<=", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
           RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "[", 
                RowBox[{"indicial", "[", 
                 RowBox[{"root1", " ", "+", " ", "k", " ", "-", " ", "1"}], 
                 "]"}], "]"}], " ", "==", " ", "0"}], ",", "\n", "\t\t\t\t", 
              RowBox[{"Throw", "[", 
               RowBox[{"{", 
                RowBox[{
                 
                 RowBox[{"\"\<Algorithm fails for root1: division by zero at \
k=\>\"", " ", "<>", " ", 
                  RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", "root1", ",",
                  " ", "A1"}], "}"}], "]"}]}], "\n", "\t\t\t", "]"}], ";", 
            "\n", "\t\t\t", 
            RowBox[{
             RowBox[{"A1", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sum", "[", "\n", "\t\t\t\t", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"root1", " ", "+", " ", "i"}], ")"}], " ", 
                    RowBox[{"F2coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                     " ", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], 
                  "*", 
                  RowBox[{"A1", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                 "\n", "\t\t\t\t", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "0", ",", " ", 
                   RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", 
                "\t\t\t", "]"}]}], " ", "/", " ", 
              RowBox[{"indicial", "[", 
               RowBox[{"root1", " ", "+", " ", "k", " ", "-", " ", "1"}], 
               "]"}]}]}], ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
         RowBox[{"{", 
          RowBox[{"root1", ",", " ", "A1"}], "}"}]}], "  ", "\n", "\t", 
        "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Compute", " ", "using", " ", "root2"}], " ", "*)"}], "\n", 
      "\t", 
      RowBox[{"result2", " ", "=", " ", 
       RowBox[{"Catch", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"A2", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
         "\t\t", 
         RowBox[{
          RowBox[{"A2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
           RowBox[{"k", " ", "<=", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
           RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "[", 
                RowBox[{"indicial", "[", 
                 RowBox[{"root2", " ", "+", " ", "k", " ", "-", " ", "1"}], 
                 "]"}], "]"}], " ", "==", " ", "0"}], ",", "\n", "\t\t\t\t", 
              RowBox[{"Throw", "[", 
               RowBox[{"{", 
                RowBox[{
                 
                 RowBox[{"\"\<Algorithm fails for root2: division by zero at \
k=\>\"", " ", "<>", " ", 
                  RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", "root2", ",",
                  " ", "A2"}], "}"}], "]"}]}], "\n", "\t\t\t", "]"}], ";", 
            "\n", "\t\t\t", 
            RowBox[{
             RowBox[{"A2", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sum", "[", "\n", "\t\t\t\t", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"root2", " ", "+", " ", "i"}], ")"}], " ", 
                    RowBox[{"F2coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                     " ", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], 
                  "*", 
                  RowBox[{"A2", "[", 
                   RowBox[{"[", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "kthCoefficient", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kthCoefficient", "[", 
   RowBox[{
   "F_", ",", " ", "r_Symbol", ",", " ", "r0_", ",", " ", "k_Integer"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "expr", "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"expr", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "F", "]"}], " ", "===", " ", "Function"}], ",", 
        " ", 
        RowBox[{"F", "[", "r", "]"}], ",", " ", "F"}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{"SeriesCoefficient", "[", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"expr", ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "r0", ",", " ", "k"}], "}"}]}], "]"}], ",", 
       " ", "k"}], "]"}]}]}], "]"}]}]}], "Code",

            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "\[Mu]1"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]1"}], 
                 ")"}], "*", 
                RowBox[{"A1", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", "\n", "\t\t\t\t", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Lambda]1", "*", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}]}], " ", "+",
                     " ", 
                    RowBox[{"F2coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}], " ", "+",
                     " ", 
                    RowBox[{"\[Mu]1", "*", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1", "-", "i"}], "]"}], "]"}]}]}], 
                   ")"}], "*", 
                  RowBox[{"A1", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", " ", "\n", 
                 "\t\t\t\t", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "0", ",", " ", 
                   RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", 
                "\t\t\t\t", "]"}]}], ")"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"k", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"F1coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
                 RowBox[{"2", "*", "\[Lambda]1"}]}], ")"}]}], ")"}]}]}], 
           ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]1", ",", " ", "\[Mu]1", ",", " ", "A1"}], "}"}]}], 
       "\n", "\t", "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Compute", " ", "for", " ", "\[Lambda]2"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"result2", " ", "=", " ", 
      RowBox[{"Catch", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"F1coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"2", "*", "\[Lambda]2"}]}], "]"}], " ", "==", " ", "0"}],
           ",", "\n", "\t\t\t", 
          RowBox[{
          "Throw", 
           "[", "\"\<Algorithm fails for \[Lambda]2: division by zero in \
denominator\>\"", "]"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
        RowBox[{"\[Mu]2", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"F1coeffs", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", "\[Lambda]2"}], "+", 
             RowBox[{"F2coeffs", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"F1coeffs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"2", "\[Lambda]2"}]}], ")"}]}]}], ";", "\n", "\t\t", 
        RowBox[{"A2", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{
         RowBox[{"A2", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
        "\t\t", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", " ", "=", " ", "1"}], ",", " ", 

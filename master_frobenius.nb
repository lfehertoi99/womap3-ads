Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Delta", ",", " ", "F1", ",", " ", "F2", ",", " ", "F1expr", ",", " ", 
    "F2expr", ",", " ", "F1Hor", ",", " ", "F2Hor"}], "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Delta", "[", 
     RowBox[{"r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r", "^", "2"}], "+", 
        RowBox[{"a", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"r", "^", "2"}], "/", 
         RowBox[{"L", "^", "2"}]}]}], ")"}]}], "-", 
     RowBox[{"2", "M", "*", "r"}]}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Delta", "[", 
      RowBox[{"r_", ",", "a_", ",", "M_", ",", "L_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["L", "2"]], "*", 
      RowBox[{"(", 
       RowBox[{"r", "-", "rp"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["r", "3"], "+", 
        RowBox[{"rp", "*", 
         SuperscriptBox["r", "2"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "2"], "+", 
           SuperscriptBox["L", "2"], "+", "rp"}], ")"}], "*", "r"}], "-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["L", "2"]}], "rp"]}], ")"}]}]}], ";"}], " ", "*)"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", 
    RowBox[{
    "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", "s_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "s"}], ")"}], "*", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Delta", "[", 
        RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], ",",
        "r"}], "]"}], "/", 
     RowBox[{"Delta", "[", 
      RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}]}]}]}],
   " ", 
  RowBox[{"(*", 
   RowBox[{"pole", " ", "of", " ", "order", " ", "1", " ", "at", " ", "rp"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F2", "[", 
     RowBox[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "\[CapitalXi]Ang", ",", " ", "DeltaAng", ",", " ", "F1Ang", ",", " ", 
   "F2Ang", ",", " ", "F1AngExpr", ",", " ", "F2AngExpr"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalXi]Ang", "[", 
    RowBox[{"a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["a", "2"], 
     SuperscriptBox["L", "2"]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DeltaAng", "[", 
     RowBox[{"x_", ",", " ", "a_", ",", " ", "L_"}], "]"}], ":=", 
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"], "+", 
     RowBox[{
      RowBox[{"\[CapitalXi]Ang", "[", 
       RowBox[{"a", ",", " ", "L"}], "]"}], "*", 
      SuperscriptBox["x", "2"]}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1Ang", "[", 
    RowBox[{"x_", ",", " ", "a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "x"}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], 
         FractionBox["1", "2"]], 
        RowBox[{"DeltaAng", "[", 
         RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["x", "2"]}], ")"}], 
           FractionBox["1", "2"]], "*", 
          RowBox[{"DeltaAng", "[", 
           RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}], ",", "x"}], 
        "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F2Ang", "[", 
     RowBox[{
     "x_", ",", " ", "a_", ",", " ", "L_", ",", " ", "s_", ",", " ", 
      "\[Lambda]_", ",", " ", "\[Nu]_", ",", " ", "m_"}], "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"DeltaAng", "[", 
        RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}]], "*", 
     RowBox[{"(", 
      RowBox[{"\[Lambda]", "-", " ", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalXi]Ang", "[", 
           RowBox[{"a", ",", " ", "L"}], "]"}], "-", "1"}], ")"}], "*", 
        SuperscriptBox["x", "2"], "*", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", "*", 
           SuperscriptBox["s", "2"]}], "+", 
          RowBox[{
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[CapitalXi]Ang", "[", 
               RowBox[{"a", ",", " ", "L"}], "]"}], ")"}], "2"], 
            RowBox[{"DeltaAng", "[", 
             RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]], "*", "m", "*",
            "\[Nu]"}]}], ")"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[CapitalXi]Ang", "[", 
           RowBox[{"a", ",", " ", "L"}], "]"}], ")"}], "2"], "*", 
        SuperscriptBox["\[Nu]", "2"], "*", 
        FractionBox[
         RowBox[{
          RowBox[{"\[CapitalXi]Ang", "[", 
           RowBox[{"a", ",", " ", "L"}], "]"}], "*", 
          SuperscriptBox["x", "2"]}], 
         RowBox[{"DeltaAng", "[", 
          RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]]}], "-", 
       RowBox[{"2", "*", "\[Nu]", "*", "s", "*", 
        FractionBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"\[CapitalXi]Ang", "[", 
            RowBox[{"a", ",", " ", "L"}], "]"}], "2"], "*", "x"}], 
         RowBox[{"DeltaAng", "[", 
          RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]]}], "-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalXi]Ang", "[", 
             RowBox[{"a", ",", " ", "L"}], "]"}], "*", "m"}], "+", 
           RowBox[{"s", "*", "x", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[CapitalXi]Ang", "[", 
               RowBox[{"a", ",", " ", "L"}], "]"}], "-", 
              RowBox[{"2", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[CapitalXi]Ang", "[", 
                  RowBox[{"a", ",", " ", "L"}], "]"}], "-", "1"}], ")"}], "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 SuperscriptBox["x", "2"]}], ")"}]}]}], ")"}]}]}], ")"}], 
         "2"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], "*", 
         RowBox[{"DeltaAng", "[", 
          RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}]]}], ")"}]}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"F1AngExpr", "=", 
   RowBox[{"F1Ang", "[", 
    RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}], ";"}], "\n", 
 RowBox[{

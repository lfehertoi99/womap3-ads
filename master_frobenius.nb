Cell[CellGroupData[{

Cell["\<\
for recursive construction of coefficients at regular singular points\
\>", "Subsection",
 CellChangeTimes->{{3.9808303686380177`*^9, 
  3.980830391188593*^9}},ExpressionUUID->"5adde694-b359-0340-912a-\
68168ea36c32"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "ComputeFrobeniusCoeffs", "]"}], "\n", 
 RowBox[{
  RowBox[{"ComputeFrobeniusCoeffs", "[", 
   RowBox[{
   "root_", ",", " ", "A0_", ",", " ", "maxOrder_", ",", " ", "Fcoeffs_", ",",
     " ", "Gcoeffs_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "k", ",", " ", "indicial"}], "}"}], ",", "\n", 
    "    ", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"indicial", "[", "n_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Gcoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Fcoeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], " ", 
        "n"}], " ", "+", " ", 
       RowBox[{"n", "^", "2"}]}]}], ";", "\n", "    ", "\n", "    ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
     "    ", "\n", "    ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "        ", "\n", "        ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"indicial", "[", 
            RowBox[{"root", " ", "+", " ", "k", " ", "-", " ", "1"}], "]"}], 
           " ", "===", " ", "0"}], ",", "\n", "            ", 
          RowBox[{"Throw", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Division by zero at k=\>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", "root", ",", 
             " ", "A"}], "}"}], "]"}]}], "\n", "        ", "]"}], ";", "\n", 
        "        ", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"root", " ", "+", " ", "i"}], ")"}], " ", 
                 RowBox[{"Fcoeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                 " ", 
                RowBox[{"Gcoeffs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], " ", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "]"}]}], " ", 
          "\n", "                  ", "/", " ", 
          RowBox[{"indicial", "[", 
           RowBox[{"root", " ", "+", " ", "k", " ", "-", " ", "1"}], 
           "]"}]}]}], ";"}]}], " ", "]"}], ";", " ", "\n", "        ", 
     "A"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9808304038603725`*^9, 3.9808304059543743`*^9}, {
   3.9808341939551105`*^9, 3.98083420225502*^9}, {3.980838658744194*^9, 
   3.980838669323515*^9}, {3.981019504374096*^9, 3.9810195062315445`*^9}, {
   3.9810198231648254`*^9, 3.98101982327429*^9}, {3.981019908888586*^9, 
   3.9810199090131626`*^9}, 3.9810201432523823`*^9, {3.9826427173390503`*^9, 
   3.9826427192063828`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"7a9a59b8-6ed6-6c4c-891f-3a007576c610"],

Cell["\<\
When expanding around x=1, we want a power series expansion w.r.t (1-x) \
instead of (x-1) so we add some factors of (-1):\
\>", "Text",
 CellChangeTimes->{{3.9854069897406197`*^9, 
  3.9854070093748474`*^9}},ExpressionUUID->"745b31fe-1144-f746-b553-\
52cfcb0e1a0f"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "ComputeFrobeniusCoeffsAtOne", "]"}], "\n", 
 RowBox[{
  RowBox[{"ComputeFrobeniusCoeffsAtOne", "[", 
   RowBox[{
   "root_", ",", " ", "A0_", ",", " ", "maxOrder_", ",", " ", "Fcoeffs_", ",",
     " ", "Gcoeffs_"}], "]"}], " ", ":=", "\n", "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "rawCoeffs", "}"}], ",", "\n", "    ", 
    RowBox[{
     RowBox[{"rawCoeffs", " ", "=", " ", 
      RowBox[{"ComputeFrobeniusCoeffs", "[", 
       RowBox[{
       "root", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "Fcoeffs", ",",
         " ", "Gcoeffs"}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "i"}], " ", "*", " ", 
        RowBox[{"rawCoeffs", "[", 
         RowBox[{"[", 
          RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], 
      "]"}]}]}], "\n", "  ", "]"}]}]}], "Code",
 CellChangeTimes->{3.985406983347828*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"82bf36e7-2ce0-324f-86a4-ee36f7acea1e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
for recursive construction of coefficients at regular singular point at \
infinity\
\>", "Subsection",
 CellChangeTimes->{{3.9809393196744614`*^9, 
  3.9809393361049976`*^9}},ExpressionUUID->"474a4001-f8b1-c042-9237-\
979fa5f8397e"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "ComputeFrobeniusCoeffsInfinity", "]"}], "\n", 
 RowBox[{
  RowBox[{"ComputeFrobeniusCoeffsInfinity", "[", 
   RowBox[{
   "root_", ",", " ", "A0_", ",", " ", "maxOrder_", ",", " ", "Fcoeffs_", ",",
     " ", "Gcoeffs_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "k", ",", " ", "indicial"}], "}"}], ",", "\n", 
    "    ", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"indicial", "[", "n_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Gcoeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Fcoeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", "n"}], " ", "+", " ", 
       RowBox[{"n", "^", "2"}]}]}], ";", "\n", "    ", "\n", "    ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
     "    ", "\n", "    ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "        ", "\n", "        ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"indicial", "[", 
            RowBox[{"root", " ", "+", " ", "k", " ", "-", " ", "1"}], "]"}], 
           " ", "===", " ", "0"}], ",", "\n", "            ", 
          RowBox[{"Throw", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Division by zero at k=\>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", "root", ",", 
             " ", "A"}], "}"}], "]"}]}], "\n", "        ", "]"}], ";", "\n", 
        "        ", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"root", " ", "+", " ", "i"}], ")"}]}], " ", 
                 RowBox[{"Fcoeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                 " ", 
                RowBox[{"Gcoeffs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], " ", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "]"}]}], " ", 
          "\n", "                  ", "/", " ", 
          RowBox[{"indicial", "[", 
           RowBox[{"root", " ", "+", " ", "k", " ", "-", " ", "1"}], 
           "]"}]}]}], ";"}]}], " ", "]"}], ";", " ", "\n", "        ", 
     "A"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9808304038603725`*^9, 3.9808304059543743`*^9}, {
   3.9808341939551105`*^9, 3.98083420225502*^9}, {3.980838658744194*^9, 
   3.980838669323515*^9}, {3.9809393492637978`*^9, 3.9809393696230145`*^9}, 
   3.9809395937173824`*^9, 3.9809397867440166`*^9, {3.981019439787939*^9, 
   3.9810194733538494`*^9}, {3.9810198258737354`*^9, 
   3.9810198259679527`*^9}, {3.9810199055368958`*^9, 3.981019905622078*^9}, {
   3.98102012644265*^9, 3.9810201372833652`*^9}, {3.9826427222885704`*^9, 
   3.9826427241566715`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"0375db2e-4ea2-a040-b95f-31c55ae967fb"]

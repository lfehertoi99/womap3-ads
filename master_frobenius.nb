Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Delta", ",", " ", "f10", ",", " ", "f20", ",", " ", "\[Kappa]", ",", " ", 
    "\[Chi]", ",", " ", "F1", ",", " ", "F2", ",", " ", "SF1", ",", " ", 
    "SF2", ",", " ", "F1expr", ",", " ", "F2expr", ",", " ", "F1Hor", ",", 
    " ", "F2Hor"}], "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Delta", "[", 
     RowBox[{"r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["r", "2"], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["r", "2"], 
         SuperscriptBox["L", "2"]]}], ")"}]}], "-", 
     RowBox[{"2", "M", "*", "r"}]}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Delta", "[", 
      RowBox[{"r_", ",", "a_", ",", "M_", ",", "L_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["L", "2"]], "*", 
      RowBox[{"(", 
       RowBox[{"r", "-", "rp"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["r", "3"], "+", 
        RowBox[{"rp", "*", 
         SuperscriptBox["r", "2"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "2"], "+", 
           SuperscriptBox["L", "2"], "+", "rp"}], ")"}], "*", "r"}], "-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["a", "2"], 
          SuperscriptBox["L", "2"]}], "rp"]}], ")"}]}]}], ";"}], " ", "*)"}], 
  "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Kappa]", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Delta", "[", 
         RowBox[{"r", ",", "a", ",", "M", ",", "L"}], "]"}], ",", "r"}], 
       "]"}], " ", "/.", " ", 
      RowBox[{"r", "->", "rp"}]}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Chi]", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["\[CapitalXi]", "2"], "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"w", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["r", "2"], "+", 
              SuperscriptBox["a", "2"]}], ")"}]}], "-", 
           RowBox[{"a", "*", "m"}]}], ")"}], "2"]}], "-", 
       RowBox[{"\[ImaginaryI]", "*", "s", "*", "\[CapitalXi]", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["w", "2"], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["r", "2"], "+", 
             SuperscriptBox["a", "2"]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}]}]}], "/.", " ", 
      RowBox[{"r", "->", "rp"}]}]}], ";"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"f10", "=", 
   RowBox[{"(", 
    RowBox[{"1", "+", "s"}], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f20", "=", 
    FractionBox["\[Chi]", "\[Kappa]"]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", 
    RowBox[{
    "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", "s_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "s"}], ")"}], "*", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Delta", "[", 
        RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], ",",
        "r"}], "]"}], "/", 
     RowBox[{"Delta", "[", 
      RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}]}]}]}],
   " ", 
  RowBox[{"(*", 
   RowBox[{"pole", " ", "of", " ", "order", " ", "1", " ", "at", " ", "rp"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F2", "[", 
     RowBox[{
     "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", "w_", ",",
       " ", "m_", ",", " ", "s_", ",", " ", "\[Lambda]_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"a", "^", "2"}], "/", 
            RowBox[{"L", "^", "2"}]}]}], ")"}], "^", "2"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"w", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"r", "^", "2"}], "+", 
              RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
           RowBox[{"a", "*", "m"}]}], ")"}], "^", "2"}]}], "-", 
       RowBox[{"\[ImaginaryI]", "*", "s", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"a", "^", "2"}], "/", 
           RowBox[{"L", "^", "2"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"w", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Delta", "[", 
           RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], 
          ",", "r"}], "]"}]}], " ", "+", " ", "\n", 
       RowBox[{

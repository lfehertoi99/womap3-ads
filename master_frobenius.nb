  3.979116442723572*^9}},ExpressionUUID->"db69d043-c100-274b-b6e8-\
6077493fdd39"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "HorizonExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HorizonExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
     "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "F1coeffs", ",", " ", "F2coeffs", ",", 
       " ", "SymbolicIndicial", ",", " ", "symbolicRoots", ",", " ", 
       "root1Symbolic", ",", " ", "root2Symbolic", ",", " ", 
       "ExplicitIndicial", ",", " ", "explicitRoots", ",", " ", 
       "root1Explicit", ",", " ", "root2Explicit", ",", ",", " ", "result1", ",",
        " ", "result2", ",", " ", "k"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "twice", " ", "the", " ", "amount", " ", "of", " ", 
       "coefficients", " ", "for", " ", "safety"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"F1coeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"F1expr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"F2coeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"F2expr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "     ", "\n", 
      "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "compute", " ", "explicit", " ", "and", " ", "symbolic", " ", "roots", 
        " ", "using", " ", "quadratic", " ", "formula", " ", "directly"}], 
       " ", "*)"}], "\n", "    ", 
      RowBox[{"root1Explicit", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"F1coeffs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"F1coeffs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], 
              "^", "2"}], " ", "-", " ", 
             RowBox[{"4", " ", 
              RowBox[{"F2coeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", "\n", "\t", 
      RowBox[{"root2Explicit", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"F1coeffs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"F1coeffs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], 
              "^", "2"}], " ", "-", " ", 
             RowBox[{"4", " ", 
              RowBox[{"F2coeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", " ", "\n", "\t", "\n", "\t", 
      RowBox[{"root1Symbolic", " ", "=", " ", 
       RowBox[{"Simplify", "[", "\n", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f10", " ", "+", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"f10", " ", "-", " ", "1"}], ")"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{"4", " ", "f20"}]}], "]"}]}], ")"}], "/", "2"}], ",", 
         "\n", "    ", 
         RowBox[{"Assumptions", " ", "->", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"f10", "^", "2"}], " ", "-", " ", 
            RowBox[{"4", " ", "f20"}]}], " ", ">=", " ", "0"}]}]}], "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"root2Symbolic", " ", "=", " ", 
       RowBox[{"Simplify", "[", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f10", " ", "-", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"f10", " ", "-", " ", "1"}], ")"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{"4", " ", "f20"}]}], "]"}]}], ")"}], "/", "2"}], ",", 
         "\n", "    ", 
         RowBox[{"Assumptions", " ", "->", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"f10", "^", "2"}], " ", "-", " ", 
            RowBox[{"4", " ", "f20"}]}], " ", ">=", " ", "0"}]}]}], "]"}]}], ";",
       " ", "\n", "\t", "\n", "\t", 
      RowBox[{"A1", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root1Explicit", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", 
         "F1coeffs", ",", " ", "F2coeffs"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"A2", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root2Explicit", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", 
         "F1coeffs", ",", " ", "F2coeffs"}], "]"}]}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"sol1", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{
        "A1", ",", " ", "root1Explicit", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"sol2", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{
        "A2", ",", " ", "root2Explicit", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<symbolic root\>\"", "->", " ", "root1Symbolic"}], ",", 
          " ", 
          RowBox[{"\"\<explicit root\>\"", " ", "->", " ", "root1Explicit"}], 
          ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A1"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol1"}]}], "|>"}], ",", 
        "\n", "\t", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<symbolic root\>\"", "->", " ", "root2Symbolic"}], ",", 
          " ", 
          RowBox[{"\"\<explicit root\>\"", " ", "->", " ", "root2Explicit"}], 
          ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A2"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol2"}]}], "|>"}]}], 
       "}"}]}]}], "\n", "]"}]}], ";"}]}], "Code",

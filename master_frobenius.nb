Cell[BoxData[{
 RowBox[{"ClearAll", "[", "SeriesCoefficientList", "]"}], "\n", 
 RowBox[{
  RowBox[{"SeriesCoefficientList", "[", 
   RowBox[{"F_", ",", " ", "r_", ",", " ", "r0_", ",", " ", "max_"}], "]"}], 
  " ", ":=", "\n", "  ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{"F", ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "r0", ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 

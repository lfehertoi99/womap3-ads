Cell[CellGroupData[{

Cell["First two terms in the power series expansion", "Subsubsection",
 CellChangeTimes->{{3.978594806399706*^9, 
  3.978594826088867*^9}},ExpressionUUID->"a3c2ae69-6961-b14e-9fe8-\
a1b1ceef617d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "root1", ",", " ", "root2", ",", " ", "coeffs1", ",", " ", "coeffs2"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"root1", ",", " ", "coeffs1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"root2", ",", " ", "coeffs2"}], "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"HorizonExpansion", "[", 
    RowBox[{
    "A0", ",", " ", "1", ",", " ", "F1exp", ",", " ", "F2exp", ",", " ", "r", 
     ",", " ", "rp"}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9785948422752285`*^9, 3.9785948500409927`*^9}, {
  3.978595137286627*^9, 3.978595140810196*^9}, {3.978595176220562*^9, 
  3.9785951829238853`*^9}, {3.9785952450106583`*^9, 
  3.9785952459974136`*^9}},ExpressionUUID->"8aa439c7-0657-604a-a3f9-\
169639ab4712"],

Cell["\<\
The variables root1 and root2 were only local variables in the \
HorizonExpansion module, so they do not exist outside of it, but we use the \
ClearAll command for safety.\
\>", "Text",
 CellChangeTimes->{{3.978595186676264*^9, 3.9785952102096195`*^9}, {
  3.9785952589663086`*^9, 
  3.978595287092655*^9}},ExpressionUUID->"577a737e-2877-aa46-940c-\
d96cee8bf6b8"],

Cell[BoxData[{
 RowBox[{"solution1horizon", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", " ", "-", " ", "rp"}], ")"}], "^", "root1"}], " ", "*", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"coeffs1", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", " ", "-", " ", "rp"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"i", "-", "1"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}]}]}], "\n", 
 RowBox[{"solution2horizon", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", " ", "-", " ", "rp"}], ")"}], "^", "root2"}], " ", "*", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"coeffs2", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", " ", "-", " ", "rp"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"i", "-", "1"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "2"}], "}"}]}], 
    "]"}]}]}]}], "Code",
 CellChangeTimes->{{3.978594896473694*^9, 3.978594912802658*^9}, {
  3.9785949454300766`*^9, 3.9785949600559826`*^9}, {3.9785950092518234`*^9, 
  3.9785950101737976`*^9}, {3.9785951708612633`*^9, 
  3.978595174017481*^9}},ExpressionUUID->"7b76d90b-a821-744f-bbf8-\
87adc1505500"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sanity Check: the Radial ODE in Schwarzschild ", "Subsection",
 CellChangeTimes->{{3.973067728794239*^9, 3.973067733773279*^9}, {
  3.978585653094864*^9, 
  3.978585666248148*^9}},ExpressionUUID->"65075c27-2bd4-4810-a9cc-\
68853fcca5c6"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "SchDelta", ",", " ", "Sch1", ",", " ", "Sch2", ",", " ", "Sch1norm", ",", 
   " ", "Sch2norm"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"SchDelta", "[", 
   RowBox[{"r_", ",", " ", "M_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"r", "^", "2"}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"2", 
      RowBox[{"M", "/", "r"}]}]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"Sch1", "[", 
   RowBox[{"r_", ",", " ", "M_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", "s"}], ")"}], "*", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"SchDelta", "[", 
      RowBox[{"r", ",", " ", "M"}], "]"}], ",", " ", "r"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Sch2", "[", 
    RowBox[{
    "r_", ",", " ", "M_", ",", " ", "w_", ",", " ", "m_", ",", " ", "s_", ",",
      " ", "\[Lambda]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"w", "*", 
       RowBox[{"r", "^", "2"}]}], ")"}], "^", "2"}], "-", 
    RowBox[{"\[ImaginaryI]", "*", "s", "*", "w", "*", 
     RowBox[{"r", "^", "2"}], "*", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"SchDelta", "[", 
        RowBox[{"r", ",", "M"}], "]"}], ",", " ", "r"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"SchDelta", "[", 
      RowBox[{"r", ",", "M"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", "*", "4", "*", "s", "*", "w", "*", "r"}], "+",
        "s", "-", "\[Lambda]"}], ")"}]}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Sch1norm", "[", 
   RowBox[{"r_", ",", "M_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"r", "-", 
       RowBox[{"2", "M"}]}], ")"}], "/", 
     RowBox[{"SchDelta", "[", 
      RowBox[{"r", ",", "M"}], "]"}]}], ")"}], "*", 
   RowBox[{"Sch1", "[", 
    RowBox[{"r", ",", " ", "M", ",", " ", "s"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"Sch2norm", "[", 
   RowBox[{
   "r_", ",", " ", "M_", ",", " ", "w_", ",", " ", "m_", ",", " ", "s_", ",", 
    " ", "\[Lambda]_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "-", 
        RowBox[{"2", "M"}]}], ")"}], "/", 
      RowBox[{"SchDelta", "[", 
       RowBox[{"r", ",", "M"}], "]"}]}], ")"}], "^", "2"}], "*", 
   RowBox[{"Sch2", "[", 
    RowBox[{
    "r", ",", "M", ",", " ", "w", ",", " ", "m", ",", " ", "s", ",", " ", 
     "\[Lambda]"}], "]"}]}]}]}], "Code",
 CellChangeTimes->{{3.973065324780121*^9, 3.9730655603523293`*^9}, {
   3.9730655935846863`*^9, 3.9730655950499067`*^9}, {3.973066155105256*^9, 

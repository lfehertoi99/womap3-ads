Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "InfinityExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"InfinityExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "Fexpr_", ",", " ", 
     "Gexpr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "Fcoeffs", ",", " ", "Gcoeffs", ",", 
       " ", "indicial", ",", " ", "roots", ",", " ", "root1", ",", " ", 
       "root2", ",", " ", "result1", ",", " ", "result2", ",", " ", "k", ",", 
       " ", "sol1", ",", " ", "sol2"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "twice", " ", "the", " ", "amount", " ", "of", " ", 
       "coefficients", " ", "for", " ", "safety"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"Fcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientListInfinity", "[", 
        RowBox[{"Fexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"Gcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientListInfinity", "[", 
        RowBox[{"Gexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "^", "2"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "f0"}], ")"}], "n"}], " ", "+", " ", "g0"}], " ",
         "=", " ", "0"}], "  ", "*)"}], "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "use", " ", "quadratic", " ", "formula", " ", "instead", " ", "of", " ",
         "Solve", " ", "because", " ", "cheaper"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"root1", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Fcoeffs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "-", "1", " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Fcoeffs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], 
              "^", "2"}], " ", "-", " ", 
             RowBox[{"4", " ", 
              RowBox[{"Gcoeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", "\n", "\t", 
      RowBox[{"root2", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Fcoeffs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "-", "1", " ", "-", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Fcoeffs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], 
              "^", "2"}], " ", "-", " ", 
             RowBox[{"4", " ", 
              RowBox[{"Gcoeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"A1", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffsInfinity", "[", 
        RowBox[{
        "root1", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "Fcoeffs", ",",
          " ", "Gcoeffs"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"A2", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffsInfinity", "[", 
        RowBox[{
        "root2", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "Fcoeffs", ",",
          " ", "Gcoeffs"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"sol1", " ", "=", " ", 
       RowBox[{"FrobeniusSolutionInfinity", "[", 
        RowBox[{"A1", ",", " ", "root1", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"sol2", " ", "=", " ", 
       RowBox[{"FrobeniusSolutionInfinity", "[", 
        RowBox[{"A2", ",", " ", "root2", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<root\>\"", " ", "->", " ", "root1"}], ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A1"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol1"}]}], "|>"}], ",", 
        "\n", "\t", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<root\>\"", " ", "->", " ", "root2"}], ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A2"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol2"}]}], "|>"}]}], 
       "}"}]}]}], "\n", "]"}]}], ";"}]}], "Code",

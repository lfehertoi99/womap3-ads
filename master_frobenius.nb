Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalXi]", "[", 
    RowBox[{"a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["a", "2"], 
     SuperscriptBox["L", "2"]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Delta_Ang", "[", 
    RowBox[{"x_", ",", " ", "a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    SuperscriptBox["x", "2"], "+", 
    RowBox[{
     RowBox[{"\[CapitalXi]", "[", 
      RowBox[{"a", ",", " ", "L"}], "]"}], "*", 
     SuperscriptBox["x", "2"]}]}]}], ";"}]}], "Code",
 CellChangeTimes->{
  3.973673137108238*^9, {3.973673179075183*^9, 3.9736732714591417`*^9}, {

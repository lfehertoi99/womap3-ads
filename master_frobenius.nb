Cell[CellGroupData[{

Cell["at infinity", "Subsection",
 CellChangeTimes->{{3.9785854999215965`*^9, 
  3.978585508326021*^9}},ExpressionUUID->"9cc9819a-d48a-7d45-8337-\
b3daf0e6bc8f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "kthCoefficientinfinity", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kthCoefficientinfinity", "[", 
   RowBox[{"F_", ",", " ", "r_Symbol", ",", " ", "k_Integer"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "expr", "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"expr", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "F", "]"}], "===", "Function"}], ",", " ", 
        RowBox[{"F", "[", "r", "]"}], ",", " ", "F"}], "]"}]}], ";", "\n", 
     "\t", 
     RowBox[{"exprInZ", " ", "=", " ", 
      RowBox[{"expr", " ", "/.", " ", 
       RowBox[{"r", " ", "->", " ", 
        RowBox[{"1", "/", "z"}]}]}]}], ";", "\n", "\t", 
     RowBox[{"series", " ", "=", " ", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"exprInZ", ",", " ", 
         RowBox[{"{", 
          RowBox[{"z", ",", " ", "0", ",", " ", "k"}], "}"}]}], "]"}], "//", 
       "Normal"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
        "5", " ", "was", " ", "set", " ", "as", " ", "the", " ", "top", " ", 
         "order"}], ";", " ", 
        RowBox[{"I", " ", "set", " ", "it", " ", "to", " ", "k"}]}], ",", " ", 
       RowBox[{"as", " ", "I", " ", "believe", " ", "we", " ", "intended"}]}],
       "*)"}], "\n", "\t", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"series", ",", " ", "z", ",", " ", "k"}], "]"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{
  3.97427420125887*^9, {3.9742759875589027`*^9, 3.974276104408119*^9}, {
   3.9742769149973516`*^9, 3.974276965896985*^9}, 3.974277061222633*^9, {

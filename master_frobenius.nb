    RowBox[{"\[CapitalXi]", ":=", 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], "*", 
       SuperscriptBox["k", "2"]}]}]}], ";"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DeltaAng", "[", "x_", "]"}], ":=", 
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["x", "2"]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1Ang", "[", "x_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "x"}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], 
         FractionBox["1", "2"]], 
        RowBox[{"DeltaAng", "[", "x", "]"}]], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 

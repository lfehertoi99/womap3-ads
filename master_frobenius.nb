Cell[CellGroupData[{

Cell["Expansion Module at the event horizon", "Subsection",
 CellChangeTimes->{{3.979116433497692*^9, 
  3.979116442723572*^9}},ExpressionUUID->"db69d043-c100-274b-b6e8-\
6077493fdd39"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "HorizonExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HorizonExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
     "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "F1coeffs", ",", " ", "F2coeffs", ",", 
       " ", "SymbolicIndicial", ",", " ", "symbolicRoots", ",", " ", 
       "root1Symbolic", ",", " ", "root2Symbolic", ",", " ", 
       "ExplicitIndicial", ",", " ", "explicitRoots", ",", " ", 
       "root1Explicit", ",", " ", "root2Explicit", ",", ",", " ", "result1", ",",
        " ", "result2", ",", " ", "k"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{
      RowBox[{"F1coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F1expr", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"F2coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F2expr", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "     ", "\n", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Symbolic", " ", "indicial", " ", "polynomial", " ", "and", " ", 
        "roots"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"SymbolicIndicial", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"f20", " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"f10", " ", "-", " ", "1"}], ")"}], " ", "*", " ", "n"}], 
          " ", "+", " ", 
          RowBox[{"n", "^", "2"}]}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"symbolicRoots", " ", "=", " ", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SymbolicIndicial", "[", "n", "]"}], " ", "==", " ", "0"}], 
         ",", " ", "n"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"root1Symbolic", " ", "=", " ", 
       RowBox[{"n", " ", "/.", " ", 
        RowBox[{"symbolicRoots", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"root2Symbolic", " ", "=", " ", 
       RowBox[{"n", " ", "/.", " ", 
        RowBox[{"symbolicRoots", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Explicit", " ", "indicial", " ", "polynomial", " ", "and", " ", 
        "roots"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"ExplicitIndicial", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{
          RowBox[{"F2coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"F1coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], 
           " ", "*", " ", "n"}], " ", "+", " ", 
          RowBox[{"n", "^", "2"}]}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"explicitRoots", " ", "=", " ", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ExplicitIndicial", "[", "n", "]"}], " ", "==", " ", "0"}], 
         ",", " ", "n"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"root1Explicit", " ", "=", " ", 
       RowBox[{"n", " ", "/.", " ", 
        RowBox[{"explicitRoots", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"root2Explicit", " ", "=", " ", 
       RowBox[{"n", " ", "/.", " ", 
        RowBox[{"explicitRoots", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "   ", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Compute", " ", "using", " ", "root1"}], " ", "*)"}], "\n", 
      "\t", 
      RowBox[{"result1", " ", "=", " ", 
       RowBox[{"Catch", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"A1", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
         "\t\t", 
         RowBox[{
          RowBox[{"A1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
           RowBox[{"k", " ", "<=", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
           RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "[", 
                RowBox[{"ExplicitIndicial", "[", 
                 RowBox[{
                 "root1Explicit", " ", "+", " ", "k", " ", "-", " ", "1"}], 
                 "]"}], "]"}], " ", "==", " ", "0"}], ",", "\n", "\t\t\t\t", 
              RowBox[{"Throw", "[", 
               RowBox[{"{", 
                RowBox[{
                 
                 RowBox[{"\"\<Algorithm fails for root1: division by zero at \
k=\>\"", " ", "<>", " ", 
                  RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", 
                 
                 RowBox[{"\"\<symbolic root\>\"", " ", "->", " ", 
                  "root1Symbolic"}], ",", " ", 
                 
                 RowBox[{"\"\<explicit root\>\"", " ", "->", " ", 
                  "root1Explicit"}], ",", " ", "A1"}], "}"}], "]"}]}], "\n", 

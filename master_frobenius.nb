Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\<\"smaller root\"\>", "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "m"}], "-", "s"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       FractionBox[
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{"5", " ", 
             SuperscriptBox["a", "2"]}], "-", 
            SuperscriptBox["L", "2"]}], 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["a", "2"], "-", 
              SuperscriptBox["L", "2"]}], ")"}]}]]}], "-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "m"}], "-", "s"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "4"}], " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["L", "2"]}], "-", 
             RowBox[{"5", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["L", "2"], " ", 
              SuperscriptBox["m", "2"]}], "+", 
             RowBox[{
              SuperscriptBox["L", "4"], " ", 
              SuperscriptBox["m", "2"]}], "-", 
             RowBox[{"3", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["L", "2"], " ", 
              SuperscriptBox["s", "2"]}], "-", 

   3.973064040072591*^9}, {3.97306759679358*^9, 3.9730676490828037`*^9}, {
   3.97307341292843*^9, 3.9730734145498333`*^9}, {3.973073473460248*^9, 
   3.973073480561533*^9}, {3.973073535596262*^9, 3.973073537225281*^9}, 
   3.9735864010633793`*^9, {3.97361252353915*^9, 3.973612526510652*^9}, {
   3.9742740787679653`*^9, 3.974274084951743*^9}, {3.9785916221545677`*^9, 
   3.9785916245296936`*^9}, {3.9785942931999836`*^9, 3.978594542482052*^9}, {
   3.9785948770098915`*^9, 3.978594877384884*^9}, 3.978670078010023*^9, {

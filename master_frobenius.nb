Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "HorizonExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HorizonExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "Fexpr_", ",", " ", 
     "Gexpr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "Fcoeffs", ",", " ", "Gcoeffs", ",", 
       " ", "SymbolicIndicial", ",", " ", "symbolicRoots", ",", " ", 
       "root1Symbolic", ",", " ", "root2Symbolic", ",", " ", 
       "ExplicitIndicial", ",", " ", "explicitRoots", ",", " ", 
       "root1Explicit", ",", " ", "root2Explicit", ",", ",", " ", "result1", ",",
        " ", "result2", ",", " ", "k"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "twice", " ", "the", " ", "amount", " ", "of", " ", 
       "coefficients", " ", "for", " ", "safety"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"Fcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"Fexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"Gcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"Gexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "     ", "\n", 
      "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "compute", " ", "explicit", " ", "and", " ", "symbolic", " ", "roots", 
        " ", "using", " ", "quadratic", " ", "formula", " ", "directly"}], 
       " ", "*)"}], "\n", "    ", 
      RowBox[{"root1Explicit", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Fcoeffs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Fcoeffs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], 
              "^", "2"}], " ", "-", " ", 
             RowBox[{"4", " ", 
              RowBox[{"Gcoeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", "\n", "\t", 
      RowBox[{"root2Explicit", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Fcoeffs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Fcoeffs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], 
              "^", "2"}], " ", "-", " ", 
             RowBox[{"4", " ", 
              RowBox[{"Gcoeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", "2"}],
         "]"}]}], ";", " ", "\n", "\t", "\n", "\t", 
      RowBox[{"root1Symbolic", " ", "=", " ", 
       RowBox[{"Simplify", "[", "\n", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f0", " ", "+", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"f0", " ", "-", " ", "1"}], ")"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{"4", " ", "g0"}]}], "]"}]}], ")"}], "/", "2"}], ",", 
         "\n", "    ", 
         RowBox[{"Assumptions", " ", "->", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"f0", "^", "2"}], " ", "-", " ", 
            RowBox[{"4", " ", "g0"}]}], " ", ">=", " ", "0"}]}]}], "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"root2Symbolic", " ", "=", " ", 
       RowBox[{"Simplify", "[", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "f0", " ", "-", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"f0", " ", "-", " ", "1"}], ")"}], "^", "2"}], " ", "-",
               " ", 
              RowBox[{"4", " ", "g0"}]}], "]"}]}], ")"}], "/", "2"}], ",", 
         "\n", "    ", 
         RowBox[{"Assumptions", " ", "->", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"f0", "^", "2"}], " ", "-", " ", 
            RowBox[{"4", " ", "g0"}]}], " ", ">=", " ", "0"}]}]}], "]"}]}], ";",
       " ", "\n", "\t", "\n", "\t", 
      RowBox[{"A1", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root1Explicit", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", 
         "Fcoeffs", ",", " ", "Gcoeffs"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"A2", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root2Explicit", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", 
         "Fcoeffs", ",", " ", "Gcoeffs"}], "]"}]}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"sol1", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{
        "A1", ",", " ", "root1Explicit", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"sol2", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{
        "A2", ",", " ", "root2Explicit", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<symbolic root\>\"", "->", " ", "root1Symbolic"}], ",", 
          " ", 
          RowBox[{"\"\<explicit root\>\"", " ", "->", " ", "root1Explicit"}], 
          ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A1"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol1"}]}], "|>"}], ",", 
        "\n", "\t", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<symbolic root\>\"", "->", " ", "root2Symbolic"}], ",", 
          " ", 
          RowBox[{"\"\<explicit root\>\"", " ", "->", " ", "root2Explicit"}], 
          ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A2"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol2"}]}], "|>"}]}], 
       "}"}]}]}], "\n", "]"}]}], ";"}]}], "Code",

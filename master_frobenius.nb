42e213b9be90"],

Cell["\<\
Note that this block is essentially the same as HorizonExpansion, but I copy \
it here and give it a different name because we might modify the \
HorizonExpansion block to address the horizon location problem.\
\>", "Text",
 CellChangeTimes->{{3.9785862916600475`*^9, 
  3.9785863511027737`*^9}},ExpressionUUID->"fa32d067-a3fd-4f45-9c0d-\
0f78b0a69e97"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CreateExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CreateExpansion", "[", 
   RowBox[{
   "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
    "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", " ", "\n",
   "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "F1", ",", " ", "F2", ",", " ", "indicial"}], 
     "}"}], ",", "\n", "\t ", 
    RowBox[{
     RowBox[{"F1", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F1expr"}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{"F2", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F2expr"}], "]"}]}], ";", "\n", 
     "\t", "\n", "\t ", 
     RowBox[{"F1coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficient", "[", 
         RowBox[{"F1", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", 
     RowBox[{"F2coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficient", "[", 
         RowBox[{"F2", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", "\n", "     ", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F2coeffs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"F1coeffs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", " ", "1"}], 
       "}"}]}], ";", "\n", "     ", 
     RowBox[{"polyVar", " ", "=", " ", 
      RowBox[{"Unique", "[", "x", "]"}]}], ";", "\n", "\t", 
     RowBox[{"poly", " ", "=", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"coeffs", "[", 
          RowBox[{"[", 
           RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
         RowBox[{"polyVar", "^", "k"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"root1", " ", "=", " ", 
      RowBox[{"polyVar", " ", "/.", " ", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], "]"}],
         "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
     RowBox[{"root2", " ", "=", " ", 
      RowBox[{"polyVar", " ", "/.", " ", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], "]"}],
         "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", 
     RowBox[{"indicial", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"poly", " ", "/.", " ", 
          RowBox[{"polyVar", " ", "->", " ", "n"}]}], "]"}]}], "]"}]}], ";", 
     "\n", "   ", "\n", "     ", "\n", "\t ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "  ", "\n",
      "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursively", " ", "compute", " ", "coefficients"}], " ", 
      "*)"}], "\n", "  ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sum", "[", "\n", "       ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"root2", " ", "+", " ", "i"}], ")"}], " ", 
                 RowBox[{"F2coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                 " ", 
                RowBox[{"F1coeffs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], "*", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", "\n", 
             "       ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", "    ", 
            "]"}]}], " ", "/", " ", 
          RowBox[{"indicial", "[", 
           RowBox[{"root2", " ", "+", " ", "k", " ", "-", " ", "1"}], 
           "]"}]}]}], ";"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"root1", ",", " ", "root2", ",", " ", "A"}], "}"}]}]}], "\n", 
   "  ", "]"}]}]}], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9785861168918304`*^9, 3.978586125748863*^9}},
 Background->None,ExpressionUUID->"e0438e44-021d-504d-933b-734a52c412f6"],


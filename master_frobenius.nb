Cell[CellGroupData[{

Cell["for construction of Frobenius power series solution", "Subsection",
 CellChangeTimes->{{3.979968192214285*^9, 
  3.9799682010949287`*^9}},ExpressionUUID->"f2b6d492-971f-ae41-aa47-\
a9464103ace0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "FrobeniusSolution", "]"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"FrobeniusSolution", "[", 
   RowBox[{"coeffs_", ",", " ", "root_", ",", " ", "r_", ",", " ", "r0_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", " ", "-", " ", "r0"}], ")"}], "^", "root"}], " ", "*", " ", 
   
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"coeffs", "[", 
       RowBox[{"[", 
        RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "*", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", " ", "-", " ", "r0"}], ")"}], "^", "i"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{"Length", "[", "coeffs", "]"}], " ", "-", " ", "1"}]}], 
      "}"}]}], "]"}]}]}]}], "Code",
 CellChangeTimes->{
  3.9797894153806076`*^9, {3.980828217808754*^9, 3.980828236307808*^9}, {
   3.9808289814374256`*^9, 3.9808289823395844`*^9}, 3.9808291791431847`*^9, 
   3.9808292485534897`*^9, {3.980829468632578*^9, 3.9808294693904457`*^9}, {
   3.9808295972196827`*^9, 3.980829601305298*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"b202c4c4-f701-d348-a907-546d762088ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "FrobeniusSolutionInfinity", "]"}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{"FrobeniusSolutionInfinity", "[", 
   RowBox[{"coeffs_", ",", " ", "root_", ",", " ", "r_", ",", " ", "r0_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     FractionBox["1", "r"], ")"}], "^", "root"}], " ", "*", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"coeffs", "[", 
       RowBox[{"[", 
        RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "*", " ", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["1", "r"], ")"}], "^", "i"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{"Length", "[", "coeffs", "]"}], " ", "-", " ", "1"}]}], 
      "}"}]}], "]"}]}]}]}], "Code",
 CellChangeTimes->{{3.980940369352522*^9, 3.9809404074747925`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"aa4cf9ac-db62-894a-9339-2294e051a6f7"]
}, Open  ]]

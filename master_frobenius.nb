Cell[BoxData[{
 RowBox[{"ClearAll", "[", "SeriesCoefficientListInfinity", "]"}], "\n", 
 RowBox[{
  RowBox[{"SeriesCoefficientListInfinity", "[", 
   RowBox[{"F_", ",", " ", "r_", ",", " ", "r0_", ",", " ", "max_"}], "]"}], 
  " ", ":=", "\n", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "u", "}"}], ",", "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"r0", " ", "===", " ", "Infinity"}], ",", "\n", "   ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{
          RowBox[{"F", " ", "/.", " ", 
           RowBox[{"r", " ", "->", " ", 
            RowBox[{"1", "/", "u"}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "max"}], "}"}]}], "]"}], ",", 
      "\n", "   ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{"F", ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "r0", ",", " ", "n"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "max"}], "}"}]}], "]"}]}], 
     "]"}]}], "\n", "   ", "]"}]}]}], "Code",
 CellChangeTimes->{{3.980939422912733*^9, 3.9809394289879704`*^9}, {

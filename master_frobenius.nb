Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Delta", ",", " ", "F1", ",", " ", "F2", ",", " ", "F1expr", ",", " ", 
    "F2expr", ",", " ", "F1Hor", ",", " ", "F2Hor"}], "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Delta", "[", 
     RowBox[{"r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r", "^", "2"}], "+", 
        RowBox[{"a", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"r", "^", "2"}], "/", 
         RowBox[{"L", "^", "2"}]}]}], ")"}]}], "-", 
     RowBox[{"2", "M", "*", "r"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"DeltaSeries", " ", "=", " ", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"Delta", "[", 
       RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "rp", ",", " ", "5"}], "}"}]}], "]"}], " ", "//",
     " ", "Normal"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DeltaSeries", " ", "=", " ", 
    RowBox[{"DeltaSeries", " ", "/.", " ", 
     RowBox[{
      RowBox[{"Delta", "[", 
       RowBox[{"rp", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], 
      " ", "->", " ", "0"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "impose", " ", "that", " ", "rp", " ", "be", " ", "a", " ", "real", " ", 
    "root", " ", "of", " ", "Delta"}], "*)"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", 
    RowBox[{
    "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", "s_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "s"}], ")"}], "*", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Delta", "[", 
        RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], ",",
        "r"}], "]"}], "/", 
     RowBox[{"Delta", "[", 
      RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}]}]}]}],
   " ", 
  RowBox[{"(*", 
   RowBox[{"pole", " ", "of", " ", "order", " ", "1", " ", "at", " ", "rp"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F2", "[", 
     RowBox[{
     "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", "w_", ",",
       " ", "m_", ",", " ", "s_", ",", " ", "\[Lambda]_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"a", "^", "2"}], "/", 
            RowBox[{"L", "^", "2"}]}]}], ")"}], "^", "2"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"w", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"r", "^", "2"}], "+", 
              RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
           RowBox[{"a", "*", "m"}]}], ")"}], "^", "2"}]}], "-", 
       RowBox[{"\[ImaginaryI]", "*", "s", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"a", "^", "2"}], "/", 
           RowBox[{"L", "^", "2"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"w", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"r", "^", "2"}], "+", 
             RowBox[{"a", "^", "2"}]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Delta", "[", 
           RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], 
          ",", "r"}], "]"}]}], " ", "+", " ", "\n", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Delta", "[", 
          RowBox[{"r", ",", "a", ",", "M", ",", "L"}], "]"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[ImaginaryI]", "*", "4", "*", "s", "*", "w", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"a", "^", "2"}], "/", 
              RowBox[{"L", "^", "2"}]}]}], ")"}], "*", "r"}], "+", 
          RowBox[{
           FractionBox["2", 
            RowBox[{"L", "^", "2"}]], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"3", "s"}], "+", 

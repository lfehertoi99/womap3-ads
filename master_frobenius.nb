Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "\[CapitalXi]", ",", " ", "DeltaAng", ",", " ", "FAng", ",", " ", "GAng", ",",
    " ", "FAngExpr", ",", " ", "GAngExpr", ",", " ", "s"}], "]"}], "\n", 
 RowBox[{"\[CapitalXi]", ":=", 
  RowBox[{"1", "-", 
   RowBox[{
    SuperscriptBox["a", "2"], "*", 
    SuperscriptBox["k", "2"]}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DeltaAng", "[", "x_", "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{
      SuperscriptBox["a", "2"], "*", 
      SuperscriptBox["k", "2"], "*", 
      SuperscriptBox["x", "2"]}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FAng", "[", "x_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "x"}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], 
         FractionBox["1", "2"]], 
        RowBox[{"DeltaAng", "[", "x", "]"}]], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["x", "2"]}], ")"}], 
           FractionBox["1", "2"]], "*", 
          RowBox[{"DeltaAng", "[", "x", "]"}]}], ",", "x"}], "]"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GAng", "[", "x_", "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], "*", 
       RowBox[{"DeltaAng", "[", "x", "]"}]}]], "*", 
     RowBox[{"(", 
      RowBox[{"\[Lambda]", "-", " ", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{"\[CapitalXi]", "-", "1"}], ")"}], "*", 
        SuperscriptBox["x", "2"], "*", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", "*", 
           SuperscriptBox["s", "2"]}], "+", 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[CapitalXi]", "2"], 
            RowBox[{"DeltaAng", "[", "x", "]"}]], "*", "m", "*", "\[Nu]"}]}], 
         ")"}]}], "+", 
       RowBox[{
        SuperscriptBox["\[CapitalXi]", "2"], "*", 
        SuperscriptBox["\[Nu]", "2"], "*", 
        FractionBox[
         RowBox[{"\[CapitalXi]", "*", 
          SuperscriptBox["x", "2"]}], 
         RowBox[{"DeltaAng", "[", "x", "]"}]]}], "-", 
       RowBox[{"2", "*", "\[Nu]", "*", "s", "*", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[CapitalXi]", "2"], "*", "x"}], 
         RowBox[{"DeltaAng", "[", "x", "]"}]]}], "-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[CapitalXi]", "*", "m"}], "+", 
           RowBox[{"s", "*", "x", "*", 
            RowBox[{"(", 
             RowBox[{"\[CapitalXi]", "-", 
              RowBox[{"2", "*", 
               RowBox[{"(", 
                RowBox[{"\[CapitalXi]", "-", "1"}], ")"}], "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 SuperscriptBox["x", "2"]}], ")"}]}]}], ")"}]}]}], ")"}], 
         "2"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], "*", 
         RowBox[{"DeltaAng", "[", "x", "]"}]}]]}], ")"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"FAngExpr", "=", 
   RowBox[{"FAng", "[", "x", "]"}]}], ";"}], "\n", 

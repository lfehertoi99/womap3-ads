Cell[CellGroupData[{

Cell["Expansion (without absolute values):", "Subsection",
 CellChangeTimes->{{3.985237896547533*^9, 3.98523791192918*^9}, {
  3.985239288009657*^9, 3.985239295103384*^9}, {3.985253263409807*^9, 
  3.9852532713670807`*^9}},ExpressionUUID->"eef69abd-bf19-1144-baca-\
a690d6ba44c9"],

Cell["\<\
To avoid the absolute value, we input manually \[OpenCurlyDoubleQuote]root1\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]root2\
\[CloseCurlyDoubleQuote] (which would otherwise be determined as roots of the \
indicial equation) and let the code compute the correspondent power series \
expansion. We choose root1 = (m+s)/2 and root2= -(m+s)/2 .\
\>", "Text",
 CellChangeTimes->{{3.9852532755011387`*^9, 3.9852533435061245`*^9}, {
  3.9852533989255047`*^9, 
  3.9852534174321613`*^9}},ExpressionUUID->"35c4d676-0dac-384b-bbf2-\
19daf1b4d396"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "AngularExpansionModified", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AngularExpansionModified", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "Fexpr_", ",", " ", 
     "Gexpr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "A3", ",", " ", "A4", ",", " ", 
       "Fcoeffs", ",", " ", "Gcoeffs", ",", " ", "root1", ",", " ", "root2", ",",
        " ", "root3", ",", " ", "root4", ",", " ", "sol1", ",", " ", "sol2", ",",
        " ", "sol3", ",", " ", "sol4"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "twice", " ", "the", " ", "amount", " ", "of", " ", 
       "coefficients", " ", "for", " ", "safety"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"Fcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"Fexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"Gcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"Gexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "we", " ", "fix", " ", "the", " ", "desired", " ", "leading", " ", 
        "order", " ", "exponents", " ", "to", " ", "avoid", " ", "absolute", " ",
         "values"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"root1", " ", "=", "  ", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"m", "+", "s"}], ")"}], "2"]}], ";", "\n", "\t", 
      RowBox[{"root2", " ", "=", " ", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"m", "+", "s"}], ")"}], "2"]}]}], ";", "\n", "\t", 
      RowBox[{"root3", " ", "=", " ", 
       FractionBox[
        RowBox[{"m", "-", "s"}], "2"]}], ";", "\n", "\t", 
      RowBox[{"root4", " ", "=", " ", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "m"}], "+", "s"}], "2"]}], ";", "\n", "\t", "\n", "\t", 
      
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"r0", "==", "1"}], " ", ",", " ", "\n", "\t", "\n", "\t", 
        RowBox[{
         RowBox[{"A1", " ", "=", " ", 
          RowBox[{"ComputeFrobeniusCoeffsAtOne", "[", 
           RowBox[{
           "root1", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "Fcoeffs",
             ",", " ", "Gcoeffs"}], "]"}]}], ";", "\n", "\t", 
         RowBox[{"A2", " ", "=", " ", 
          RowBox[{"ComputeFrobeniusCoeffsAtOne", "[", 

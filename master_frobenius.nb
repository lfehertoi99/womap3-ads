Cell[CellGroupData[{

Cell["Computing quantities related to the normal expansion", "Subsection",
 CellChangeTimes->{{3.9785855716350803`*^9, 
  3.978585575959715*^9}},ExpressionUUID->"5ed327a4-802d-b749-9d2e-\
97a876172e45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "InfinityExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"InfinityExpansion", "[", 
   RowBox[{
   "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
    "F2expr_", ",", " ", "r_"}], "]"}], " ", ":=", " ", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "F1", ",", " ", "F2"}], "}"}], ",", "\n", "\t ", 
    RowBox[{
     RowBox[{"F1", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F1expr"}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{"F2", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F2expr"}], "]"}]}], ";", "\n", 
     "\t", "\n", "\t ", 
     RowBox[{"F1coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficientinfinity", "[", 
         RowBox[{"F1", ",", " ", "r", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", 
     RowBox[{"F2coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficientinfinity", "[", 
         RowBox[{"F2", ",", " ", "r", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", "\n", "     ", 
     RowBox[{"f10", " ", "=", " ", 
      RowBox[{"F1coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"f11", " ", "=", " ", 
      RowBox[{"F1coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"f20", " ", "=", " ", 
      RowBox[{"F2coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"f21", " ", "=", " ", 
      RowBox[{"F2coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"\[Lambda]1", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], "*", "f10"}], " ", "+", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "4"], "\[Times]", 
           SuperscriptBox[
            RowBox[{"(", "f10", ")"}], "2"]}], "-", "f20"}], ")"}], 
        FractionBox["1", "2"]]}]}], ";", "\n", "\t", 
     RowBox[{"\[Lambda]2", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], "*", "f10"}], " ", "-", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "4"], "\[Times]", 
           SuperscriptBox[
            RowBox[{"(", "f10", ")"}], "2"]}], "-", "f20"}], ")"}], 
        FractionBox["1", "2"]]}]}], ";", "\n", "\t", 
     RowBox[{"\[Mu]1", " ", "=", " ", 
      FractionBox[
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f11", "*", "\[Lambda]1"}], "+", "f21"}], ")"}]}], 
       RowBox[{"f10", "+", 
        RowBox[{"2", "\[Lambda]1"}]}]]}], ";", "\n", "\t", 
     RowBox[{"\[Mu]2", " ", "=", " ", 
      FractionBox[
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f11", "*", "\[Lambda]2"}], "+", "f21"}], ")"}]}], 
       RowBox[{"f10", "+", 
        RowBox[{"2", "\[Lambda]2"}]}]]}], ";", "\n", "   ", "\n", "     ", 
     "\n", "\t ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "  ", "\n",
      "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursively", " ", "compute", " ", "coefficients"}], " ", 
      "*)"}], "\n", "  ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", "=", "\n", "  ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", " ", "-", " ", "\[Mu]1"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]1"}], 
              ")"}], "*", 

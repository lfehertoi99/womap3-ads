Cell[CellGroupData[{

Cell["\<\
Computing the roots of the indicial equation and generating the coefficients \
of the Frobenius expansion to given order\
\>", "Subsection",
 CellChangeTimes->{{3.9785855301061897`*^9, 
  3.97858554610602*^9}},ExpressionUUID->"4aff421d-a0f0-9f40-ad1f-\
58736248239b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "HorizonExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HorizonExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
     "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "F1", ",", " ", "F2", ",", " ", 
       "F1coeffs", ",", " ", "F2coeffs", ",", " ", "indicial", ",", " ", 
       "coeffs", ",", " ", "polyVar", ",", " ", 
       RowBox[{"poly", " ", "root1"}], ",", " ", "root2"}], "}"}], ",", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"local", " ", "variables"}], " ", "*)"}], "\n", "\t ", 
     RowBox[{
      RowBox[{"F1", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "r", "}"}], ",", " ", "F1expr"}], "]"}]}], ";", "\n", 
      "     ", 
      RowBox[{"F2", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "r", "}"}], ",", " ", "F2expr"}], "]"}]}], ";", "\n", 
      "\t", "\n", "\t", 
      RowBox[{"F1coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F1", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}],
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"F2coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F2", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}],
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], 
        "]"}]}], ";", "\n", "     ", "\n", "    ", 
      RowBox[{"coeffs", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"F2coeffs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", " ", "1"}], 
        "}"}]}], ";", "\n", "    ", 
      RowBox[{"polyVar", " ", "=", " ", 
       RowBox[{"Unique", "[", "x", "]"}]}], ";", "\n", "\t", 
      RowBox[{"poly", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"coeffs", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
          RowBox[{"polyVar", "^", "k"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
      "\n", "\t", 
      RowBox[{"root1", " ", "=", " ", 
       RowBox[{"polyVar", " ", "/.", " ", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"root2", " ", "=", " ", 
       RowBox[{"polyVar", " ", "/.", " ", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], 
          "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"indicial", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"poly", " ", "/.", " ", 
           RowBox[{"polyVar", " ", "->", " ", "n"}]}], "]"}]}], "]"}]}], ";", 
      " ", "\n", "   ", "\n", "    ", "\n", "\t", 
      RowBox[{"A1", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"array", " ", "one", " ", "for", " ", "root1"}], "*)"}], "\n", 
      "\t", 
      RowBox[{
       RowBox[{"A1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
      "\t", "\n", "\t", 
      RowBox[{"A2", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"array", " ", "two", " ", "for", " ", "root2"}], "*)"}], "\n", 
      "\t", 
      RowBox[{
       RowBox[{"A2", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", " ", "\n",
       "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "recursively", " ", "compute", " ", "coefficients", " ", "using", " ", 
        "root1"}], "*)"}], "\n", "\t", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
        RowBox[{"k", " ", "<=", " ", 
         RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
        RowBox[{"k", "++"}], ",", " ", "\n", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{"A1", "[", 
           RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sum", "[", "\n", "    ", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"root1", " ", "+", " ", "i"}], ")"}], " ", 
                  RowBox[{"F2coeffs", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                  " ", 
                 RowBox[{"F1coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], "*", 
               RowBox[{"A1", "[", 
                RowBox[{"[", 
                 RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", "\n",
               "    ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "0", ",", " ", 
                RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", "    ", 
             "]"}]}], " ", "/", " ", 
           RowBox[{"indicial", "[", 
            RowBox[{"root1", " ", "+", " ", "k", " ", "-", " ", "1"}], 
            "]"}]}]}], ";"}]}], "]"}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "recursively", " ", "compute", " ", "coefficients", " ", "using", " ", 
        "root2"}], "*)"}], "\n", "\t", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
        RowBox[{"k", " ", "<=", " ", 
         RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
        RowBox[{"k", "++"}], ",", "\n", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{"A2", "[", 
           RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sum", "[", "\n", "\t", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"root2", " ", "+", " ", "i"}], ")"}], " ", 
                  RowBox[{"F2coeffs", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                  " ", 
                 RowBox[{"F1coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], "*", 
               RowBox[{"A2", "[", 
                RowBox[{"[", 
                 RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", "\n",
               "    ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "0", ",", " ", 
                RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", "    ", 
             "]"}]}], " ", "/", " ", 
           RowBox[{"indicial", "[", 
            RowBox[{"root2", " ", "+", " ", "k", " ", "-", " ", "1"}], 
            "]"}]}]}], ";"}]}], "]"}], ";", "\n", "    ", "\n", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{"return", " ", "nested", " ", "structure"}], " ", "*)"}], "\n",
       "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"root1", ",", " ", "A1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"root2", ",", " ", "A2"}], "}"}]}], "}"}]}]}], "\n", "]"}]}],
   ";"}]}], "Code",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9730613418171597`*^9, 3.973061369298456*^9}, {
   3.97306141844766*^9, 3.973061571334193*^9}, {3.973061796171379*^9, 

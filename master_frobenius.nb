Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
    RowBox[{"k", " ", "<=", " ", 
     RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
    RowBox[{"k", "++"}], ",", "\n", "\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{"A2", "[", 
       RowBox[{"[", "k", "]"}], "]"}], " ", "=", "\n", "\t\t", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", " ", "-", " ", "\[Mu]2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]2"}], ")"}], 
          "*", 
          RowBox[{"A2", "[", 
           RowBox[{"[", 
            RowBox[{"k", " ", "-", " ", "1"}], "]"}], "]"}]}], " ", "+", "\n",
          "\t\t", 
         RowBox[{"Sum", "[", "\n", "\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Lambda]2", "*", 
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], " ", "+", " ", 
              RowBox[{"F2coeffs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"k", " ", "-", " ", "i", " ", "-", " ", "\[Mu]2"}], 
                ")"}], "*", 
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", 
                 RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}]}]}], ")"}], "*", 
            RowBox[{"A2", "[", 
             RowBox[{"[", 
              RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ",", " ", 
           "\n", "\t\t", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", "\t\t", 
          "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"k", "*", 
         RowBox[{"(", 
          RowBox[{"f10", " ", "+", " ", 
           RowBox[{"2", "\[Times]", "\[Lambda]2"}]}], ")"}]}], ")"}]}]}], 
     ";"}]}], "\n", "\t\t", "]"}], ";"}]], "Code",

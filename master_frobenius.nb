Cell[CellGroupData[{

Cell["Computing quantities related to the normal expansion", "Subsection",
 CellChangeTimes->{{3.9785855716350803`*^9, 
  3.978585575959715*^9}},ExpressionUUID->"5ed327a4-802d-b749-9d2e-\
97a876172e45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "InfinityExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"InfinityExpansion", "[", 
   RowBox[{
   "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
    "F2expr_", ",", " ", "r_"}], "]"}], " ", ":=", " ", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "A1", ",", " ", "A2", ",", " ", "F1coeffs", ",", " ", "F2coeffs", ",", 
      " ", "\[Lambda]1", ",", " ", "\[Lambda]2", ",", " ", "\[Mu]1", ",", " ",
       "\[Mu]2", ",", " ", "result1", ",", " ", "result2", ",", " ", "k"}], 
     "}"}], ",", "\n", "\t", "\n", "\t ", 
    RowBox[{
     RowBox[{"F1coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficientinfinity", "[", 
         RowBox[{"F1expr", ",", " ", "r", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", 
          RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{"F2coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficientinfinity", "[", 
         RowBox[{"F2expr", ",", " ", "r", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", 
          RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
     "     ", "\n", "\t", 
     RowBox[{"\[Lambda]1", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}], "*", 
        RowBox[{"F1coeffs", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", "4"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"F1coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ")"}], "^", "2"}]}], "-", 
          RowBox[{"F2coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}]}]}], ";", "\n", "\t", 
     RowBox[{"\[Lambda]2", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}], "*", 
        RowBox[{"F1coeffs", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", "4"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"F1coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ")"}], "^", "2"}]}], "-", 
          RowBox[{"F2coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Compute", " ", "for", " ", "\[Lambda]1"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"result1", " ", "=", " ", 
      RowBox[{"Catch", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"F1coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"2", "*", "\[Lambda]1"}]}], "]"}], " ", "==", " ", "0"}],
           ",", "\n", "\t\t\t", 
          RowBox[{
          "Throw", 
           "[", "\"\<Algorithm fails for \[Lambda]1: division by zero in \
denominator\>\"", "]"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
        RowBox[{"\[Mu]1", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"F1coeffs", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", "\[Lambda]1"}], "+", 
             RowBox[{"F2coeffs", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"F1coeffs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"2", "\[Lambda]1"}]}], ")"}]}]}], ";", "\n", "\t\t", 
        RowBox[{"A1", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{
         RowBox[{"A1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
        "\t\t", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", " ", "=", " ", "1"}], ",", " ", 
          RowBox[{"k", " ", "<=", " ", "maxOrder"}], ",", " ", 
          RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"A1", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "=", " ", "\n", 
            "\t\t\t\t", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "\[Mu]1"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]1"}], 
                 ")"}], "*", 
                RowBox[{"A1", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", "\n", "\t\t\t\t", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Lambda]1", "*", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}]}], " ", "+",
                     " ", 
                    RowBox[{"F2coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}], " ", "+",
                     " ", 
                    RowBox[{"\[Mu]1", "*", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1", "-", "i"}], "]"}], "]"}]}]}], 
                   ")"}], "*", 
                  RowBox[{"A1", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", " ", "\n", 
                 "\t\t\t\t", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "0", ",", " ", 
                   RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", 
                "\t\t\t\t", "]"}]}], ")"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"k", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"F1coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
                 RowBox[{"2", "*", "\[Lambda]1"}]}], ")"}]}], ")"}]}]}], 
           ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]1", ",", " ", "\[Mu]1", ",", " ", "A1"}], "}"}]}], 
       "\n", "\t", "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"Compute", " ", "for", " ", "\[Lambda]2"}], " ", "*)"}], "\n", 
     "\t", 
     RowBox[{"result2", " ", "=", " ", 
      RowBox[{"Catch", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"F1coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"2", "*", "\[Lambda]2"}]}], "]"}], " ", "==", " ", "0"}],
           ",", "\n", "\t\t\t", 
          RowBox[{
          "Throw", 
           "[", "\"\<Algorithm fails for \[Lambda]2: division by zero in \
denominator\>\"", "]"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
        RowBox[{"\[Mu]2", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"F1coeffs", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", "\[Lambda]2"}], "+", 
             RowBox[{"F2coeffs", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"F1coeffs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"2", "\[Lambda]2"}]}], ")"}]}]}], ";", "\n", "\t\t", 
        RowBox[{"A2", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{
         RowBox[{"A2", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
        "\t\t", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", " ", "=", " ", "1"}], ",", " ", 
          RowBox[{"k", " ", "<=", " ", "maxOrder"}], ",", " ", 
          RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"A2", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "=", " ", "\n", 
            "\t\t\t\t", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "\[Mu]2"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]2"}], 
                 ")"}], "*", 
                RowBox[{"A2", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", "\n", "\t\t\t\t", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Lambda]2", "*", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}]}], " ", "+",
                     " ", 
                    RowBox[{"F2coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}], " ", "+",
                     " ", 
                    RowBox[{"\[Mu]2", "*", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1", "-", "i"}], "]"}], "]"}]}]}], 
                   ")"}], "*", 
                  RowBox[{"A2", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", " ", "\n", 
                 "\t\t\t\t", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "0", ",", " ", 
                   RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", 
                "\t\t\t\t", "]"}]}], ")"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"k", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"F1coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
                 RowBox[{"2", "*", "\[Lambda]2"}]}], ")"}]}], ")"}]}]}], 
           ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]2", ",", " ", "\[Mu]2", ",", " ", "A2"}], "}"}]}], 
       "\n", "\t", "]"}]}], ";", "\n", "\t\t", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"F1coeffs", ",", " ", "F2coeffs", ",", " ", 
       RowBox[{"F2coeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", "result1", ",", " ", 
       "result2"}], "}"}]}]}], "\n", "]"}]}]}], "Code",

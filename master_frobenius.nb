Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F1_ang", "[", 
    RowBox[{"x_", ",", " ", "a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "x"}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], 
         FractionBox["1", "2"]], 
        RowBox[{"Delta_Ang", "[", 
         RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["x", "2"]}], ")"}], 
           FractionBox["1", "2"]], "*", 
          RowBox[{"Delta_Ang", "[", 
           RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}], ",", "x"}], 
        "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F2_ang", "[", 
    RowBox[{
    "x_", ",", " ", "a_", ",", " ", "L_", ",", " ", "s_", ",", " ", 
     "\[Lambda]_", ",", " ", "\[Nu]_", ",", " ", "m_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"Delta_Ang", "[", 
       RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}]], "*", 
    RowBox[{"(", 
     RowBox[{"\[Lambda]", "-", " ", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalXi]_func", "[", 
          RowBox[{"a", ",", " ", "L"}], "]"}], "-", "1"}], ")"}], "*", 
       SuperscriptBox["x", "2"], "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", "*", 
          SuperscriptBox["s", "2"]}], "+", 
         RowBox[{
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[CapitalXi]_func", "[", 
              RowBox[{"a", ",", " ", "L"}], "]"}], ")"}], "2"], 
           RowBox[{"Delta_Ang", "[", 
            RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]], "*", "m", "*",
           "\[Nu]"}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CapitalXi]_func", "[", 
          RowBox[{"a", ",", " ", "L"}], "]"}], ")"}], "2"], "*", 
       SuperscriptBox["\[Nu]", "2"], "*", 
       FractionBox[
        RowBox[{
         RowBox[{"\[CapitalXi]_func", "[", 
          RowBox[{"a", ",", " ", "L"}], "]"}], "*", 
         SuperscriptBox["x", "2"]}], 
        RowBox[{"Delta_Ang", "[", 
         RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]]}], "-", 
      RowBox[{"2", "*", "\[Nu]", "*", "s", "*", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"\[CapitalXi]_func", "[", 
           RowBox[{"a", ",", " ", "L"}], "]"}], "2"], "*", "x"}], 

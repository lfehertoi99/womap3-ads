  3.9852531796398335`*^9}},ExpressionUUID->"e2a2b4ab-ee22-6649-97de-\
a8ffc9cafaf7"],

Cell["\<\
We apply Frobenius method to construct a power series expansion. The leading \
order coefficients are obtained as roots of the indicial equation and, as \
such, feature absolute values.\
\>", "Text",
 CellChangeTimes->{{3.985253114881876*^9, 
  3.985253152744068*^9}},ExpressionUUID->"7b15a079-a401-e44f-9654-\
d33d62a8e51c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "AngularExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AngularExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "Fexpr_", ",", " ", 
     "Gexpr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "Fcoeffs", ",", " ", "Gcoeffs", ",", 
       " ", "indicial", ",", " ", "roots", ",", " ", "root1", ",", " ", 
       "root2", ",", " ", "result1", ",", " ", "result2", ",", " ", "k", ",", 
       " ", "sol1", ",", " ", "sol2"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "twice", " ", "the", " ", "amount", " ", "of", " ", 
       "coefficients", " ", "for", " ", "safety"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"Fcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"Fexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"Gcoeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"Gexpr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", "\n", 
      "\t", 

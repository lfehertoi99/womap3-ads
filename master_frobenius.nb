Cell[CellGroupData[{

Cell["Regular singular points", "Section",
 CellChangeTimes->{{3.9730641439404593`*^9, 3.973064156677085*^9}, {
  3.973673698128593*^9, 3.973673710459581*^9}, {3.973673851971795*^9, 
  3.9736738544634933`*^9}, {3.978585527961233*^9, 
  3.9785855284665756`*^9}},ExpressionUUID->"1993bf65-0d38-458b-a1cb-\
136fd6ebf87c"],

Cell[CellGroupData[{

Cell["\<\
Computing the roots of the indicial equation and generating the coefficients \
of the Frobenius expansion to given order\
\>", "Subsection",
 CellChangeTimes->{{3.9785855301061897`*^9, 
  3.97858554610602*^9}},ExpressionUUID->"4aff421d-a0f0-9f40-ad1f-\
58736248239b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "HorizonExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HorizonExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
     "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "F1coeffs", ",", " ", "F2coeffs", ",", 
       " ", "indicial", ",", " ", "coeffs", ",", " ", "polyVar", ",", " ", 
       "poly", ",", " ", "root1", ",", " ", "root2", ",", " ", "result1", ",",
        " ", "result2", ",", " ", "k"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{
      RowBox[{"F1coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F1expr", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"F2coeffs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"kthCoefficient", "[", 
          RowBox[{"F2expr", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"2", "*", "maxOrder"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "     ", "\n", "    ", 
      RowBox[{"coeffs", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"F2coeffs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", " ", "1"}], 
        "}"}]}], ";", "\n", "    ", 
      RowBox[{"polyVar", " ", "=", " ", 
       RowBox[{"Unique", "[", "x", "]"}]}], ";", "\n", "\t", 
      RowBox[{"poly", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"coeffs", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
          RowBox[{"polyVar", "^", "k"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
      "\n", "\t", 
      RowBox[{"root1", " ", "=", " ", 
       RowBox[{"polyVar", " ", "/.", " ", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"root2", " ", "=", " ", 
       RowBox[{"polyVar", " ", "/.", " ", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], 
          "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"indicial", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"poly", " ", "/.", " ", 
           RowBox[{"polyVar", " ", "->", " ", "n"}]}], "]"}]}], "]"}]}], ";", 
      " ", "\n", "   ", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Compute", " ", "using", " ", "root1"}], " ", "*)"}], "\n", 
      "\t", 
      RowBox[{"result1", " ", "=", " ", 
       RowBox[{"Catch", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"A1", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
         "\t\t", 
         RowBox[{
          RowBox[{"A1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
           RowBox[{"k", " ", "<=", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
           RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "[", 
                RowBox[{"indicial", "[", 
                 RowBox[{"root1", " ", "+", " ", "k", " ", "-", " ", "1"}], 
                 "]"}], "]"}], " ", "==", " ", "0"}], ",", "\n", "\t\t\t\t", 
              RowBox[{"Throw", "[", 
               RowBox[{"{", 
                RowBox[{
                 
                 RowBox[{"\"\<Algorithm fails for root1: division by zero at \
k=\>\"", " ", "<>", " ", 
                  RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", "root1", ",",
                  " ", "A1"}], "}"}], "]"}]}], "\n", "\t\t\t", "]"}], ";", 
            "\n", "\t\t\t", 
            RowBox[{
             RowBox[{"A1", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sum", "[", "\n", "\t\t\t\t", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"root1", " ", "+", " ", "i"}], ")"}], " ", 
                    RowBox[{"F2coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                     " ", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], 
                  "*", 
                  RowBox[{"A1", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                 "\n", "\t\t\t\t", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "0", ",", " ", 
                   RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", 
                "\t\t\t", "]"}]}], " ", "/", " ", 
              RowBox[{"indicial", "[", 
               RowBox[{"root1", " ", "+", " ", "k", " ", "-", " ", "1"}], 
               "]"}]}]}], ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
         RowBox[{"{", 
          RowBox[{"root1", ",", " ", "A1"}], "}"}]}], "  ", "\n", "\t", 
        "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"Compute", " ", "using", " ", "root2"}], " ", "*)"}], "\n", 
      "\t", 
      RowBox[{"result2", " ", "=", " ", 
       RowBox[{"Catch", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"A2", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
         "\t\t", 
         RowBox[{
          RowBox[{"A2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
         "\t\t", "\n", "\t\t", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
           RowBox[{"k", " ", "<=", " ", 
            RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
           RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "[", 
                RowBox[{"indicial", "[", 
                 RowBox[{"root2", " ", "+", " ", "k", " ", "-", " ", "1"}], 
                 "]"}], "]"}], " ", "==", " ", "0"}], ",", "\n", "\t\t\t\t", 
              RowBox[{"Throw", "[", 
               RowBox[{"{", 
                RowBox[{
                 
                 RowBox[{"\"\<Algorithm fails for root2: division by zero at \
k=\>\"", " ", "<>", " ", 
                  RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", "root2", ",",
                  " ", "A2"}], "}"}], "]"}]}], "\n", "\t\t\t", "]"}], ";", 
            "\n", "\t\t\t", 
            RowBox[{
             RowBox[{"A2", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sum", "[", "\n", "\t\t\t\t", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"root2", " ", "+", " ", "i"}], ")"}], " ", 
                    RowBox[{"F2coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                     " ", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], 
                  "*", 
                  RowBox[{"A2", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", 
                 "\n", "\t\t\t\t", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "0", ",", " ", 
                   RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", 
                "\t\t\t", "]"}]}], " ", "/", " ", 
              RowBox[{"indicial", "[", 
               RowBox[{"root2", " ", "+", " ", "k", " ", "-", " ", "1"}], 
               "]"}]}]}], ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
         RowBox[{"{", 
          RowBox[{"root2", ",", " ", "A2"}], "}"}]}], "  ", "\n", "\t", 
        "]"}]}], ";", "\n", "    ", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"result1", ",", " ", "result2"}], "}"}]}]}], "\n", "]"}]}], 
  ";"}]}], "Code",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9730613418171597`*^9, 3.973061369298456*^9}, {
   3.97306141844766*^9, 3.973061571334193*^9}, {3.973061796171379*^9, 
   3.973061928246966*^9}, {3.97306204178098*^9, 3.973062195663329*^9}, {

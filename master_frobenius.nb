Cell[CellGroupData[{

Cell["Plugging in the values of \[Xi] and its derivatives at rp", "Subsection",
 CellChangeTimes->{{3.9805838977823887`*^9, 
  3.9805839142824345`*^9}},ExpressionUUID->"09bc0c24-50d8-174e-90bc-\
d3cc5be583f7"],

Cell["\<\
We create a rule that computes the first n coefficients of the power series \
expansion of \[Xi] at rp and substitutes them to the symbols \[Xi][rp], \[Xi]\
\[CloseCurlyQuote][rp],...\
\>", "Text",
 CellChangeTimes->{{3.9805839225643616`*^9, 3.980583978252001*^9}, {
  3.9808214674521675`*^9, 
  3.9808214680335503`*^9}},ExpressionUUID->"863fe27a-af96-4b4b-81ea-\
dabf66093e30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Xi]Rules", "[", 
   RowBox[{"n_", ",", " ", "rp_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Join", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Xi]", "[", "rp", "]"}], " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], "*", 
         FractionBox["\[CapitalXi]", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}]], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Omega]", "*", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["r", "2"], "+", 
              SuperscriptBox["a", "2"]}], ")"}]}], "-", 
           RowBox[{"a", "*", "m"}]}], ")"}]}], " ", "/.", " ", 
        RowBox[{"r", " ", "->", " ", "rp"}]}], ")"}]}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{"Table", "[", "\n", "        ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", "i", "]"}], "[", "\[Xi]", "]"}], "[", 
        "rp", "]"}], " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], "*", 
            FractionBox["\[CapitalXi]", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}]],
             "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Omega]", "*", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["r", "2"], "+", 
                 SuperscriptBox["a", "2"]}], ")"}]}], "-", 
              RowBox[{"a", "*", "m"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "i"}], "}"}]}], "]"}], " ", "/.", " ", 
         RowBox[{"r", " ", "->", " ", "rp"}]}], ")"}]}], ",", "\n", 
      "        ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", 
        RowBox[{"n", "+", "1"}]}], "}"}]}], " ", "]"}]}], "]"}]}]], "Code",
 CellChangeTimes->{
  3.980583367050518*^9, {3.9805834492014465`*^9, 3.9805834494203663`*^9}, {
   3.980583608826576*^9, 3.9805836101390953`*^9}, {3.9805837693466454`*^9, 
   3.980583770581562*^9}, {3.980584781330639*^9, 3.9805847840500126`*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"2435be78-4add-1e44-9e7b-35acc0b8a39a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"RR1", "[", "r_", "]"}], "=", 
  RowBox[{"sol1rplus", "/.", 
   RowBox[{"\[Xi]Rules", "[", 
    RowBox[{"2", ",", "rp"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RR2", "[", "r_", "]"}], "=", 
   RowBox[{"sol2rplus", "/.", " ", 
    RowBox[{"\[Xi]Rules", "[", 
     RowBox[{"2", ",", "rp"}], "]"}]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9805862458377113`*^9, 3.980586274604313*^9}, {

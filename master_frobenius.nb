Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "\[CapitalDelta]", ",", " ", "f10", ",", " ", "f20", ",", " ", "\[Xi]", ",",
    " ", "F1", ",", " ", "F2", ",", " ", "F1HorExpr", ",", " ", "F2HorExpr"}],
   "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]", "[", "r_", "]"}], ":=", " ", 
    RowBox[{
     SuperscriptBox["k", "2"], "*", 
     RowBox[{"(", 
      RowBox[{"r", "-", "rp"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["r", "3"], "+", 
       RowBox[{"rp", "*", 
        SuperscriptBox["r", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["a", "2"], "+", 
          FractionBox["1", 
           SuperscriptBox["k", "2"]], "+", 
          SuperscriptBox["rp", "2"]}], ")"}], "*", "r"}], "+", 
       SuperscriptBox["rp", "3"], "+", 
       RowBox[{"rp", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["a", "2"], "+", 
          FractionBox["1", 
           SuperscriptBox["k", "2"]]}], ")"}]}], "-", 
       RowBox[{"2", "*", "M", "*", 
        FractionBox["1", 
         SuperscriptBox["k", "2"]]}]}], ")"}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[CapitalXi]", ":=", 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], "*", 
       SuperscriptBox["k", "2"]}]}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]", "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "*", 
      FractionBox["\[CapitalXi]", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}]], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Omega]", "*", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           SuperscriptBox["a", "2"]}], ")"}]}], "-", 
        RowBox[{"a", "*", "m"}]}], ")"}]}]}], ";"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "symbols", " ", "for", " ", "f10", " ", "and", " ", "f20", " ", "to", " ", 
    "check", " ", "that", " ", "indicial", " ", "roots", " ", "are", " ", 
    "correct"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"f10", "=", 
   RowBox[{"(", 
    RowBox[{"1", "+", "s"}], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f20", "=", 
    RowBox[{"\[Xi]", 
     RowBox[{"(", 
      RowBox[{"s", "-", "\[Xi]"}], ")"}]}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Radial", " ", "ODE", " ", 
      RowBox[{"is", " ", "\\", 
       RowBox[{"alpha", "''"}]}], 
      RowBox[{"(", "r", ")"}]}], "+", 
     RowBox[{"F1", 
      RowBox[{
       RowBox[{"(", "r", ")"}], "\\", 
       RowBox[{"alpha", "'"}]}], 
      RowBox[{"(", "r", ")"}]}], "+", 
     RowBox[{"F2", 
      RowBox[{
       RowBox[{"(", "r", ")"}], "\\", "alpha"}], 
      RowBox[{"(", "r", ")"}]}]}], "=", "0"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", "r_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "s"}], ")"}], "*", 
    FractionBox[
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}], 
     RowBox[{"\[CapitalDelta]", "[", "r", "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F2", "[", "r_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}], 
          ")"}], "2"], "*", 
        RowBox[{"\[Xi]", "[", "r", "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ")"}], "2"]], "*", 
      RowBox[{"(", 
       RowBox[{"s", "-", 
        RowBox[{"\[Xi]", "[", "r", "]"}]}], ")"}]}], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"\[CapitalDelta]", "[", "r", "]"}]], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "\[ImaginaryI]", "*", "4", "*", "s", "*", "\[Omega]", "*", 
         "\[CapitalXi]", "*", "r"}], "+", 
        RowBox[{"2", "*", 
         SuperscriptBox["r", "2"], "*", 
         SuperscriptBox["k", "2"], 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"3", "s"}], "+", 
           RowBox[{"2", 
            SuperscriptBox["s", "2"]}]}], ")"}]}], "+", 
        RowBox[{"s", "*", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            SuperscriptBox["a", "2"], "*", 
            SuperscriptBox["k", "2"]}]}], ")"}]}], "-", "\[Lambda]", "+", 
        RowBox[{"2", "*", 
         SuperscriptBox["\[CapitalXi]", "2"], "*", "a", "*", "m", "*", 
         "\[Omega]"}], "-", 
        RowBox[{
         SuperscriptBox["a", "2"], "*", 
         SuperscriptBox["\[CapitalXi]", "2"], "*", 
         SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}]}], ";"}], " ", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "functions", " ", "analytic", " ", "at", " ", "event", " ", "horizon"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1Hor", "[", "r_", "]"}], ":=", " ", 

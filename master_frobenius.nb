       "->", " ", "DeltaSeries"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "power", " ", "expand", " ", "Delta", " ", "to", " ", "order", " ", "5", " ",
     "and", " ", "impose", " ", "that", " ", "it", " ", "be", " ", "zero", " ",
     "at", " ", "rp"}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"F2exp", " ", "=", " ", 
   RowBox[{
    RowBox[{"F2", "[", 
     RowBox[{
     "r", ",", " ", "a", ",", " ", "M", ",", " ", "L", ",", " ", "w", ",", 
      " ", "m", ",", " ", "s", ",", " ", "\[Lambda]"}], "]"}], " ", "/.", " ", 
    RowBox[{
     RowBox[{"Delta", "[", 
      RowBox[{"rp", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], " ",
      "->", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F2exp", " ", "=", " ", 
   RowBox[{"F2exp", " ", "/.", " ", 
    RowBox[{
     RowBox[{"Delta", "[", 
      RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], " ", 
     "->", " ", "DeltaSeries"}]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.973060611337212*^9, 3.973060629256061*^9}, 

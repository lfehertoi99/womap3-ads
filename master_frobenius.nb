       "\[Mu]2", ",", " ", "result1", ",", " ", "result2", ",", " ", "k"}], 
     "}"}], ",", "\n", "\t", "\n", "\t", 
    RowBox[{
     RowBox[{"F1coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{

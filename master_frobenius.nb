Cell["Initialisation of functions and parameters", "Subsection",
 CellChangeTimes->{{3.979114336437563*^9, 
  3.979114341375292*^9}},ExpressionUUID->"2a5051bd-f520-c140-9cb1-\
08decae110a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Delta", ",", " ", "\[CapitalXi]", ",", " ", "F", ",", " ", "G", ",", " ", 
    "Fexpr", ",", " ", "Gexpr"}], "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Delta", "[", "r_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["r", "2"], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["r", "2"], "*", 
         SuperscriptBox["k", "2"]}]}], ")"}]}], "-", 
     RowBox[{"2", "M", "*", "r"}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"\[CapitalXi]", ":=", 
    RowBox[{"1", "-", 
     RowBox[{
      SuperscriptBox["a", "2"], "*", 
      SuperscriptBox["k", "2"]}]}]}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", "r_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "s"}], ")"}], "*", 
     FractionBox[
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Delta", "[", "r", "]"}], ",", "r"}], "]"}], 
      RowBox[{"Delta", "[", "r", "]"}]]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"G", "[", "r_", "]"}], ":=", " ", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Delta", "[", "r", "]"}], ")"}], "2"]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[CapitalXi]", "2"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Omega]", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["r", "2"], "+", 
              SuperscriptBox["a", "2"]}], ")"}]}], "-", 
           RowBox[{"a", "*", "m"}]}], ")"}], "^", "2"}]}], "-", 
       RowBox[{"\[ImaginaryI]", "*", "s", "*", "\[CapitalXi]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Omega]", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["r", "2"], "+", 
             SuperscriptBox["a", "2"]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Delta", "[", "r", "]"}], ",", "r"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"Delta", "[", "r", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "\[ImaginaryI]", "*", "4", "*", "s", "*", "\[Omega]", "*", 
           "\[CapitalXi]", "*", "r"}], "+", 
          RowBox[{"2", 
           SuperscriptBox["k", "2"], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"3", "s"}], "+", 
             RowBox[{"2", 
              SuperscriptBox["s", "2"]}]}], ")"}], 
           SuperscriptBox["r", "2"]}], "+", 
          RowBox[{"s", "*", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              SuperscriptBox["a", "2"], "*", 
              SuperscriptBox["k", "2"]}]}], ")"}]}], "-", "\[Lambda]", "+", 
          RowBox[{"2", "*", 
           SuperscriptBox["\[CapitalXi]", "2"], "*", "a", "*", "m", "*", 
           "\[Omega]"}], "-", 
          RowBox[{
           SuperscriptBox["a", "2"], "*", 
           SuperscriptBox["\[CapitalXi]", "2"], "*", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}]}]}], ";"}], 
  " ", "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "expressions", " ", "associated", " ", "to", " ", "F", " ", "and", " ", 
    "G", " ", "which", " ", "we", " ", "feed", " ", "to", " ", "expansion", " ",
     "at", " ", "infinity", " ", "module"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Fexpr", " ", "=", " ", 
   RowBox[{"r", "*", 
    RowBox[{"F", "[", "r", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gexpr", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["r", "2"], "*", 
    RowBox[{"G", "[", "r", "]"}]}]}], ";"}]}], "Code",

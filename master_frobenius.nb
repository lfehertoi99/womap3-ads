       RowBox[{"(", "r", ")"}], "\\", "alpha"}], 
      RowBox[{"(", "r", ")"}]}]}], "=", "0"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", "r_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "s"}], ")"}], "*", 
    FractionBox[
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}], 

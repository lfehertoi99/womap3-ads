Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "kthCoefficient", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kthCoefficient", "[", 
   RowBox[{
   "F_", ",", " ", "r_Symbol", ",", " ", "r0_", ",", " ", "k_Integer"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "expr", "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"expr", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "F", "]"}], " ", "===", " ", "Function"}], ",", 
        " ", 
        RowBox[{"F", "[", "r", "]"}], ",", " ", "F"}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{"SeriesCoefficient", "[", 
      RowBox[{"expr", ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "r0", ",", " ", "k"}], "}"}]}], "]"}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.9730593296067266`*^9, 3.97305933921476*^9}, 
   3.9730595543860903`*^9, 3.973059777525549*^9, 3.973059881115363*^9, {
   3.973061060163166*^9, 3.973061070048574*^9}, {3.973061257063545*^9, 
   3.973061261752151*^9}, {3.973062887728306*^9, 3.973062903774377*^9}, {

   3.9730627782532587`*^9}, {3.9730630023542223`*^9, 3.973063006915163*^9}, {
   3.9730630780164843`*^9, 3.973063135147931*^9}, {3.973063200158554*^9, 
   3.973063200282399*^9}, {3.973063291452414*^9, 3.9730633207446947`*^9}, {
   3.9730634266846523`*^9, 3.9730634673033133`*^9}, {3.9730635135675077`*^9, 

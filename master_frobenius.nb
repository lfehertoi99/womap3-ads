Cell[CellGroupData[{

Cell["\<\
for recursive construction of coefficients at regular singular points\
\>", "Subsection",
 CellChangeTimes->{{3.9808303686380177`*^9, 
  3.980830391188593*^9}},ExpressionUUID->"5adde694-b359-0340-912a-\
68168ea36c32"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "ComputeFrobeniusCoeffs", "]"}], "\n", 
 RowBox[{
  RowBox[{"ComputeFrobeniusCoeffs", "[", 
   RowBox[{
   "root_", ",", " ", "A0_", ",", " ", "maxOrder_", ",", " ", "F1coeffs_", ",",
     " ", "F2coeffs_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "k", ",", " ", "indicial"}], "}"}], ",", "\n", 
    "    ", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"indicial", "[", "n_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"F2coeffs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], " ", 
        "n"}], " ", "+", " ", 
       RowBox[{"n", "^", "2"}]}]}], ";", "\n", "    ", "\n", "    ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "\n", 
     "    ", "\n", "    ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "        ", "\n", "        ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"indicial", "[", 
            RowBox[{"root", " ", "+", " ", "k", " ", "-", " ", "1"}], "]"}], 
           " ", "===", " ", "0"}], ",", "\n", "            ", 
          RowBox[{"Throw", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Division by zero at k=\>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", "root", ",", 
             " ", "A"}], "}"}], "]"}]}], "\n", "        ", "]"}], ";", "\n", 
        "        ", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"root", " ", "+", " ", "i"}], ")"}], " ", 
                 RowBox[{"F2coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                 " ", 
                RowBox[{"F1coeffs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], " ", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "]"}]}], " ", 
          "\n", "                  ", "/", " ", 
          RowBox[{"indicial", "[", 
           RowBox[{"root", " ", "+", " ", "k", " ", "-", " ", "1"}], 
           "]"}]}]}], ";"}]}], "\n", "    ", "]"}], ";", "\n", "    ", 
     "A"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9808304038603725`*^9, 3.9808304059543743`*^9}, {
  3.9808341939551105`*^9, 
  3.98083420225502*^9}},ExpressionUUID->"7a9a59b8-6ed6-6c4c-891f-\
3a007576c610"]
}, Open  ]],

Cell[CellGroupData[{

Cell["for construction of Frobenius power series solution", "Subsection",
 CellChangeTimes->{{3.979968192214285*^9, 
  3.9799682010949287`*^9}},ExpressionUUID->"f2b6d492-971f-ae41-aa47-\
a9464103ace0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "FrobeniusSolution", "]"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"FrobeniusSolution", "[", 
   RowBox[{"coeffs_", ",", " ", "root_", ",", " ", "r_", ",", " ", "r0_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", " ", "-", " ", "r0"}], ")"}], "^", "root"}], " ", "*", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"coeffs", "[", 
       RowBox[{"[", 
        RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "*", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", " ", "-", " ", "r0"}], ")"}], "^", "i"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{"Length", "[", "coeffs", "]"}], " ", "-", " ", "1"}]}], 
      "}"}]}], "]"}]}]}]}], "Code",
 CellChangeTimes->{
  3.9797894153806076`*^9, {3.980828217808754*^9, 3.980828236307808*^9}, {
   3.9808289814374256`*^9, 3.9808289823395844`*^9}, 3.9808291791431847`*^9, 
   3.9808292485534897`*^9, {3.980829468632578*^9, 3.9808294693904457`*^9}, {
   3.9808295972196827`*^9, 3.980829601305298*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"b202c4c4-f701-d348-a907-546d762088ce"]
}, Open  ]]
}, Open  ]],


Cell[CellGroupData[{

Cell["Angular ODE in Kerr-AdS", "Section",
 CellChangeTimes->{{3.973671117078277*^9, 3.973671134170636*^9}, {
  3.9785857181775093`*^9, 
  3.978585721980425*^9}},ExpressionUUID->"ea3db366-d0af-421c-a107-\
fc05a67ea319"],

Cell[CellGroupData[{

Cell["Initialisation of new parameters", "Subsection",
 CellChangeTimes->{{3.978585742583637*^9, 
  3.9785857626615505`*^9}},ExpressionUUID->"fd3e7729-cd58-6141-b423-\
2e09a9ed0706"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalXi]", "[", 
    RowBox[{"a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["a", "2"], 
     SuperscriptBox["L", "2"]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Delta_Ang", "[", 
    RowBox[{"x_", ",", " ", "a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    SuperscriptBox["x", "2"], "+", 
    RowBox[{
     RowBox[{"\[CapitalXi]", "[", 
      RowBox[{"a", ",", " ", "L"}], "]"}], "*", 
     SuperscriptBox["x", "2"]}]}]}], ";"}]}], "Code",
 CellChangeTimes->{
  3.973673137108238*^9, {3.973673179075183*^9, 3.9736732714591417`*^9}, {
   3.973673554447382*^9, 3.973673555231492*^9}, {3.9785858552275925`*^9, 
   3.978585882719475*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"11bad374-caeb-4990-8250-9b69a204d016"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Initialisation of functions", "Subsection",
 CellChangeTimes->{{3.978585769443117*^9, 
  3.9785857764992104`*^9}},ExpressionUUID->"1b9543d8-2d2e-3149-8e00-\
2bfccdcc1a08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F1_ang", "[", 
    RowBox[{"x_", ",", " ", "a_", ",", " ", "L_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}]], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "x"}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["x", "2"]}], ")"}], 
         FractionBox["1", "2"]], 
        RowBox[{"Delta_Ang", "[", 
         RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["x", "2"]}], ")"}], 
           FractionBox["1", "2"]], "*", 
          RowBox[{"Delta_Ang", "[", 
           RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}], ",", "x"}], 
        "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F2_ang", "[", 
    RowBox[{
    "x_", ",", " ", "a_", ",", " ", "L_", ",", " ", "s_", ",", " ", 
     "\[Lambda]_", ",", " ", "\[Nu]_", ",", " ", "m_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"Delta_Ang", "[", 
       RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}]], "*", 
    RowBox[{"(", 
     RowBox[{"\[Lambda]", "-", " ", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalXi]_func", "[", 
          RowBox[{"a", ",", " ", "L"}], "]"}], "-", "1"}], ")"}], "*", 
       SuperscriptBox["x", "2"], "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", "*", 
          SuperscriptBox["s", "2"]}], "+", 
         RowBox[{
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[CapitalXi]_func", "[", 
              RowBox[{"a", ",", " ", "L"}], "]"}], ")"}], "2"], 
           RowBox[{"Delta_Ang", "[", 
            RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]], "*", "m", "*",
           "\[Nu]"}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CapitalXi]_func", "[", 
          RowBox[{"a", ",", " ", "L"}], "]"}], ")"}], "2"], "*", 
       SuperscriptBox["\[Nu]", "2"], "*", 
       FractionBox[
        RowBox[{
         RowBox[{"\[CapitalXi]_func", "[", 
          RowBox[{"a", ",", " ", "L"}], "]"}], "*", 
         SuperscriptBox["x", "2"]}], 
        RowBox[{"Delta_Ang", "[", 
         RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]]}], "-", 
      RowBox[{"2", "*", "\[Nu]", "*", "s", "*", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"\[CapitalXi]_func", "[", 
           RowBox[{"a", ",", " ", "L"}], "]"}], "2"], "*", "x"}], 
        RowBox[{"Delta_Ang", "[", 
         RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]]}], "-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalXi]_func", "[", 
            RowBox[{"a", ",", " ", "L"}], "]"}], "*", "m"}], "+", 
          RowBox[{"s", "*", "x", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[CapitalXi]_func", "[", 
              RowBox[{"a", ",", " ", "L"}], "]"}], "-", 
             RowBox[{"2", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[CapitalXi]_func", "[", 
                 RowBox[{"a", ",", " ", "L"}], "]"}], "-", "1"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox["x", "2"]}], ")"}]}]}], ")"}]}]}], ")"}], "2"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}], ")"}], "*", 
        RowBox[{"Delta_Ang", "[", 
         RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}]]}], ")"}]}]}], 
  ";"}]}], "Code",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{
  3.9736731186788797`*^9, {3.973673357730659*^9, 3.973673652859995*^9}, {
   3.9785859215590916`*^9, 3.9785859470859814`*^9}, {3.9785861742402954`*^9, 
   3.978586205550703*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"b55b51ae-f47a-4ac5-befd-85b76a164eff"],

Cell["\<\
We will later have to feed F1_ang *(1-x) and F2_ang*(1-x)^2 to the Expansion \
Function. Should we initialize those function directly but lose flexibility \
in terms of singular point? Should we automatically implement the transition \
from F1_ang to F1_ang*(1-x)? Should we leave it as it is and manually specify \
the factors (1-x) and (1-x)^2? \
\>", "Text",
 CellChangeTimes->{{3.978590959835909*^9, 3.978591107145796*^9}, {
  3.978592959402258*^9, 3.9785929781521816`*^9}, {3.978669543065489*^9, 
  3.9786695467551155`*^9}},ExpressionUUID->"a2d70da9-c713-554b-94d3-\
1e526ba560bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Expansion function", "Subsection",
 CellChangeTimes->{{3.9785862773767033`*^9, 
  3.9785862830287304`*^9}},ExpressionUUID->"ba9411a4-e686-d940-ab70-\
42e213b9be90"],

Cell["\<\
Note that this block is essentially the same as HorizonExpansion, but we copy \
it here and give it a different name because we might modify the \
HorizonExpansion block to address the horizon location problem.\
\>", "Text",
 CellChangeTimes->{{3.9785862916600475`*^9, 3.9785863511027737`*^9}, {
  3.9785911134584503`*^9, 
  3.9785911144583244`*^9}},ExpressionUUID->"fa32d067-a3fd-4f45-9c0d-\
0f78b0a69e97"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CreateExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CreateExpansion", "[", 
   RowBox[{
   "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
    "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", " ", "\n",
   "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "F1", ",", " ", "F2", ",", " ", "indicial"}], 
     "}"}], ",", "\n", "\t ", 
    RowBox[{
     RowBox[{"F1", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F1expr"}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{"F2", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F2expr"}], "]"}]}], ";", "\n", 
     "\t", "\n", "\t ", 
     RowBox[{"F1coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficient", "[", 
         RowBox[{"F1", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", 
     RowBox[{"F2coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficient", "[", 
         RowBox[{"F2", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", "\n", "     ", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F2coeffs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"F1coeffs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", " ", "1"}], 
       "}"}]}], ";", "\n", "     ", 
     RowBox[{"polyVar", " ", "=", " ", 
      RowBox[{"Unique", "[", "x", "]"}]}], ";", "\n", "\t", 
     RowBox[{"poly", " ", "=", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"coeffs", "[", 
          RowBox[{"[", 
           RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
         RowBox[{"polyVar", "^", "k"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"root1", " ", "=", " ", 
      RowBox[{"polyVar", " ", "/.", " ", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], "]"}],
         "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
     RowBox[{"root2", " ", "=", " ", 
      RowBox[{"polyVar", " ", "/.", " ", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], "]"}],
         "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", 
     RowBox[{"indicial", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"poly", " ", "/.", " ", 
          RowBox[{"polyVar", " ", "->", " ", "n"}]}], "]"}]}], "]"}]}], ";", 
     "\n", "   ", "\n", "     ", "\n", "\t ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "  ", "\n",
      "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursively", " ", "compute", " ", "coefficients"}], " ", 
      "*)"}], "\n", "  ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sum", "[", "\n", "       ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"root2", " ", "+", " ", "i"}], ")"}], " ", 
                 RowBox[{"F2coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                 " ", 
                RowBox[{"F1coeffs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], "*", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", "\n", 
             "       ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", "    ", 
            "]"}]}], " ", "/", " ", 
          RowBox[{"indicial", "[", 
           RowBox[{"root2", " ", "+", " ", "k", " ", "-", " ", "1"}], 
           "]"}]}]}], ";"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"root1", ",", " ", "root2", ",", " ", "A"}], "}"}]}]}], "\n", 
   "  ", "]"}]}]}], "Code",
 CellChangeTimes->{3.978593023408329*^9},
 CellLabel->"In[37]:=",ExpressionUUID->"a20d9d63-40dc-3d41-8ee8-ac5fc7ba3b38"],

Cell[BoxData[
 RowBox[{"CreateExpansion", "[", 
  RowBox[{"A0", ",", " ", "2", ",", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "-", "1"}], ")"}], "*", 
    RowBox[{"F1_ang", "[", 
     RowBox[{"x", ",", " ", "a", ",", " ", "L"}], "]"}]}], ",", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}], "2"], "*", " ", 
    RowBox[{"F2_ang", "[", 
     RowBox[{
     "x", ",", " ", "a", ",", " ", "L", ",", " ", "s", ",", " ", "\[Lambda]", 
      ",", " ", "\[Nu]", ",", " ", "m"}], "]"}]}], ",", " ", "x", ",", " ", 
   "1"}], "]"}]], "Code",
 CellChangeTimes->{3.9785930335210648`*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"c88b9746-c884-0941-aae0-8e1006fca7f5"]
}, Open  ]]
}, Open  ]]
}, Open  ]]

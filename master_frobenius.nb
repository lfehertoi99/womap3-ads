Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "GenericExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GenericExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
     "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "F1coeffs", ",", " ", "F2coeffs", ",", 
       " ", "indicial", ",", " ", "roots", ",", " ", "root1", ",", " ", 
       "root2", ",", " ", "result1", ",", " ", "result2", ",", " ", "k", ",", 
       " ", "sol1", ",", " ", "sol2"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "twice", " ", "the", " ", "amount", " ", "of", " ", 
       "coefficients", " ", "for", " ", "safety"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"F1coeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"F1expr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"F2coeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"F2expr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "use", " ", "quadratic", " ", "formula", " ", "instead", " ", "of", " ",
         "Solve", " ", "because", " ", "cheaper"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"root1", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], "^",
              "2"}], " ", "-", " ", 
            RowBox[{"4", " ", 

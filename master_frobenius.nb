                     " ", 
                    RowBox[{"\[Mu]2", "*", 
                    RowBox[{"F1coeffs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1", "-", "i"}], "]"}], "]"}]}]}], 
                   ")"}], "*", 
                  RowBox[{"A2", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", " ", "\n", 
                 "\t\t\t\t", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "0", ",", " ", 
                   RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", 
                "\t\t\t\t", "]"}]}], ")"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"k", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"F1coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
                 RowBox[{"2", "*", "\[Lambda]2"}]}], ")"}]}], ")"}]}]}], 
           ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]2", ",", " ", "\[Mu]2", ",", " ", "A2"}], "}"}]}], 
       "\n", "\t", "]"}]}], ";", "\n", "\t\t", "\n", "\t", 
     RowBox[{"{", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "kthCoefficientinfinity", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kthCoefficientinfinity", "[", 
   RowBox[{"F_", ",", " ", "r_Symbol", ",", " ", "k_Integer"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "expr", "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"expr", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "F", "]"}], "===", "Function"}], ",", " ", 
        RowBox[{"F", "[", "r", "]"}], ",", " ", "F"}], "]"}]}], ";", "\n", 
     "\t", 
     RowBox[{"exprInZ", " ", "=", " ", 
      RowBox[{"expr", " ", "/.", " ", 
       RowBox[{"r", " ", "->", " ", 
        RowBox[{"1", "/", "z"}]}]}]}], ";", "\n", "\t", 
     RowBox[{"series", " ", "=", " ", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"exprInZ", ",", " ", 
         RowBox[{"{", 
          RowBox[{"z", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "//", 
       "Normal"}]}], ";", "\n", "\t", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"series", ",", " ", "z", ",", " ", "k"}], "]"}]}]}], "\n", 
   "]"}]}]}], "Code",
 CellChangeTimes->{
  3.97427420125887*^9, {3.9742759875589027`*^9, 3.974276104408119*^9}, {

        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Delta", "[", 
           RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], 
          ",", "r"}], "]"}]}], " ", "+", " ", "\n", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Delta", "[", 
          RowBox[{"r", ",", "a", ",", "M", ",", "L"}], "]"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[ImaginaryI]", "*", "4", "*", "s", "*", "\[Omega]", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox[
              SuperscriptBox["a", "2"], 
              SuperscriptBox["L", "2"]]}], ")"}], "*", "r"}], "+", 
          RowBox[{
           FractionBox["2", 
            SuperscriptBox["L", "2"]], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"3", "s"}], "+", 
             RowBox[{"2", 
              SuperscriptBox["s", "2"]}]}], ")"}], 
           SuperscriptBox["r", "2"]}], "+", 
          RowBox[{"s", "*", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             FractionBox[
              SuperscriptBox["a", "2"], 
              SuperscriptBox["L", "2"]]}], ")"}]}], "-", "\[Lambda]", "+", 
          RowBox[{"2", "*", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               SuperscriptBox["a", "2"], 
               SuperscriptBox["L", "2"]]}], ")"}], "2"], "*", "a", "*", "m", "*",
            "\[Omega]"}], "-", 
          RowBox[{
           SuperscriptBox["a", "2"], "*", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               SuperscriptBox["a", "2"], 
               SuperscriptBox["L", "2"]]}], ")"}], "2"], "*", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}], "/", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Delta", "[", 
        RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], 
       ")"}], "2"]}]}], ";"}], " ", "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "expressions", " ", "associated", " ", "to", " ", "F1", " ", "and", " ", 
    "F2", " ", "which", " ", "we", " ", "feed", " ", "to", " ", "expansion", " ",
     "at", " ", "infinity", " ", "module"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"F1expr", " ", "=", " ", 
   RowBox[{"F1", "[", 
    RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L", ",", " ", "s"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F2expr", " ", "=", " ", 
    RowBox[{"F2", "[", 
     RowBox[{
     "r", ",", " ", "a", ",", " ", "M", ",", " ", "L", ",", " ", "\[Omega]", ",",
       " ", "m", ",", " ", "s", ",", " ", "\[Lambda]"}], "]"}]}], ";"}], "\n",
   "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "irregular", " ", "singular", " ", "point", " ", "at", " ", "infinity", " ",
      "is", " ", "becomes", " ", "regular", " ", "at", " ", "z"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"0", " ", "for", " ", "transformed", " ", "equation", " ", 
       RowBox[{"W", "''"}], 
       RowBox[{"(", "z", ")"}]}], "+", " ", 
      RowBox[{"G1", 
       RowBox[{"(", "z", ")"}], 
       RowBox[{"W", "'"}], 
       RowBox[{"(", "z", ")"}]}], "+", 
      RowBox[{"G2", 
       RowBox[{"(", "z", ")"}], "W", 
       RowBox[{"(", "z", ")"}]}]}], "=", "0"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "InfinityExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"InfinityExpansion", "[", 
   RowBox[{
   "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
    "F2expr_", ",", " ", "r_"}], "]"}], " ", ":=", " ", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "F1", ",", " ", "F2"}], "}"}], ",", "\n", "\t ", 
    RowBox[{
     RowBox[{"F1", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F1expr"}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{"F2", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F2expr"}], "]"}]}], ";", "\n", 
     "\t", "\n", "\t ", 
     RowBox[{"F1coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficientinfinity", "[", 
         RowBox[{"F1", ",", " ", "r", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", 
     RowBox[{"F2coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficientinfinity", "[", 
         RowBox[{"F2", ",", " ", "r", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", "\n", "     ", 
     RowBox[{"f10", " ", "=", " ", 
      RowBox[{"F1coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"f11", " ", "=", " ", 
      RowBox[{"F1coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"f20", " ", "=", " ", 
      RowBox[{"F2coeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"f21", " ", "=", " ", 
      RowBox[{"F2coeffs", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"\[Lambda]1", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], "*", "f10"}], " ", "+", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "4"], "\[Times]", 
           SuperscriptBox[
            RowBox[{"(", "f10", ")"}], "2"]}], "-", "f20"}], ")"}], 
        FractionBox["1", "2"]]}]}], ";", "\n", "\t", 
     RowBox[{"\[Lambda]2", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], "*", "f10"}], " ", "-", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "4"], "\[Times]", 
           SuperscriptBox[
            RowBox[{"(", "f10", ")"}], "2"]}], "-", "f20"}], ")"}], 
        FractionBox["1", "2"]]}]}], ";", "\n", "\t", 
     RowBox[{"\[Mu]1", " ", "=", " ", 
      FractionBox[
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f11", "*", "\[Lambda]1"}], "+", "f21"}], ")"}]}], 
       RowBox[{"f10", "+", 
        RowBox[{"2", "\[Lambda]1"}]}]]}], ";", "\n", "\t", 
     RowBox[{"\[Mu]2", " ", "=", " ", 
      FractionBox[
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f11", "*", "\[Lambda]2"}], "+", "f21"}], ")"}]}], 
       RowBox[{"f10", "+", 
        RowBox[{"2", "\[Lambda]2"}]}]]}], ";", "\n", "   ", "\n", "     ", 
     "\n", "\t ", 
     RowBox[{"A1", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"A1", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"array", " ", "of", " ", "coeffs", " ", 
       RowBox[{"for", " ", "\\", "lambda"}], " ", "1"}], "*)"}], "\n", 
     "     ", "\n", "     ", 
     RowBox[{"A2", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"A2", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"array", " ", "of", " ", "coeffs", " ", 
       RowBox[{"for", " ", "\\", "lambda"}], " ", "2"}], "*)"}], "\n", "\n", 
     "\t", 
     RowBox[{"(*", 
      RowBox[{"Recursively", " ", "compute", " ", "coefficients", " ", 
       RowBox[{"with", " ", "\\", "lambda"}], " ", "1"}], "*)"}], "\n", "\t", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{"A1", "[", 
          RowBox[{"[", 
           RowBox[{"k", "+", "2"}], "]"}], "]"}], " ", "=", "\n", "\t\t", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", " ", "-", " ", "\[Mu]1"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]1"}], 
              ")"}], "*", 
             RowBox[{"A1", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", "\n", "\t\t", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[Lambda]1", "*", 
                  RowBox[{"F1coeffs", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}]}], "+", 
                 RowBox[{"F2coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}], "+", 
                 RowBox[{"\[Mu]1", "*", 
                  RowBox[{"F1coeffs", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1", "-", "i"}], "]"}], "]"}]}]}], 
                ")"}], "*", 
               RowBox[{"A1", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", " ", "\n", 
              "\t\t", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "1", ",", " ", 
                RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", "\t\t", 
             "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"k", "*", 
            RowBox[{"(", 
             RowBox[{"f10", " ", "+", " ", 
              RowBox[{"2", "\[Times]", "\[Lambda]1"}]}], ")"}]}], ")"}]}]}], 
        ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{"Recursively", " ", "compute", " ", "coefficients", " ", 
       RowBox[{"with", " ", "\\", "lambda"}], " ", "2"}], "*)"}], "\n", "\t", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{"A2", "[", 
          RowBox[{"[", 
           RowBox[{"k", "+", "2"}], "]"}], "]"}], " ", "=", "\n", "\t\t", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", " ", "-", " ", "\[Mu]2"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]2"}], 
              ")"}], "*", 
             RowBox[{"A2", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", "\n", "\t\t", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[Lambda]2", "*", 
                  RowBox[{"F1coeffs", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}]}], "+", 
                 RowBox[{"F2coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "+", "2", "-", "i"}], "]"}], "]"}], "+", 
                 RowBox[{"\[Mu]2", "*", 
                  RowBox[{"F1coeffs", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1", "-", "i"}], "]"}], "]"}]}]}], 
                ")"}], "*", 
               RowBox[{"A2", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", " ", "\n", 
              "\t\t", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "1", ",", " ", 
                RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", "\t\t", 
             "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"k", "*", 
            RowBox[{"(", 
             RowBox[{"f10", " ", "+", " ", 
              RowBox[{"2", "\[Times]", "\[Lambda]2"}]}], ")"}]}], ")"}]}]}], 
        ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"return", " ", "nested", " ", "structure"}], "*)"}], "\n", 
     "    ", 

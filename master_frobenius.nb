Cell[CellGroupData[{

Cell["Expansion (with absolute values):", "Subsection",
 CellChangeTimes->{{3.9808296869814053`*^9, 3.980829689106268*^9}, {
  3.9852378575649223`*^9, 3.985237874401991*^9}, {3.985239260677223*^9, 

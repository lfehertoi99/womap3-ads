Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "Delta", ",", " ", "f10", ",", " ", "f20", ",", " ", "\[Kappa]", ",", " ", 
   "\[Chi]", ",", " ", "F1", ",", " ", "F2", ",", " ", "F1HorExpr", ",", " ", 
   "F2HorExpr"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Delta", "[", 
    RowBox[{"r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       SuperscriptBox["a", "2"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       FractionBox[
        SuperscriptBox["r", "2"], 
        SuperscriptBox["L", "2"]]}], ")"}]}], "-", 
    RowBox[{"2", "M", "*", "r"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f10", "=", 
   RowBox[{"(", 
    RowBox[{"1", "+", "s"}], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f20", "=", 
    FractionBox["\[Chi]", "\[Kappa]"]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Radial", " ", "ODE", " ", 
      RowBox[{"is", " ", "\\", 
       RowBox[{"alpha", "''"}]}], 
      RowBox[{"(", "r", ")"}]}], "+", 
     RowBox[{"F1", 
      RowBox[{
       RowBox[{"(", "r", ")"}], "\\", 
       RowBox[{"alpha", "'"}]}], 
      RowBox[{"(", "r", ")"}]}], "+", 
     RowBox[{"F2", 
      RowBox[{
       RowBox[{"(", "r", ")"}], "\\", "alpha"}], 
      RowBox[{"(", "r", ")"}]}]}], "=", "0"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", 
    RowBox[{
    "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", "s_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "s"}], ")"}], "*", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Delta", "[", 
        RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], ",",
        "r"}], "]"}], "/", 
     RowBox[{"Delta", "[", 
      RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}]}]}]}],
   " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F2", "[", 
     RowBox[{
     "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", 
      "\[Omega]_", ",", " ", "m_", ",", " ", "s_", ",", " ", "\[Lambda]_"}], 
     "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            SuperscriptBox["a", "2"], 
            SuperscriptBox["L", "2"]]}], ")"}], "2"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Omega]", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["r", "2"], "+", 
              SuperscriptBox["a", "2"]}], ")"}]}], "-", 
           RowBox[{"a", "*", "m"}]}], ")"}], "^", "2"}]}], "-", 
       RowBox[{"\[ImaginaryI]", "*", "s", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           SuperscriptBox["a", "2"], 
           SuperscriptBox["L", "2"]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Omega]", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["r", "2"], "+", 
             SuperscriptBox["a", "2"]}], ")"}]}], "-", 
          RowBox[{"a", "*", "m"}]}], ")"}], "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Delta", "[", 
           RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], 
          ",", "r"}], "]"}]}], " ", "+", " ", "\n", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Delta", "[", 
          RowBox[{"r", ",", "a", ",", "M", ",", "L"}], "]"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[ImaginaryI]", "*", "4", "*", "s", "*", "\[Omega]", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox[
              SuperscriptBox["a", "2"], 
              SuperscriptBox["L", "2"]]}], ")"}], "*", "r"}], "+", 
          RowBox[{
           FractionBox["2", 
            SuperscriptBox["L", "2"]], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"3", "s"}], "+", 
             RowBox[{"2", 
              SuperscriptBox["s", "2"]}]}], ")"}], 
           SuperscriptBox["r", "2"]}], "+", 
          RowBox[{"s", "*", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             FractionBox[
              SuperscriptBox["a", "2"], 
              SuperscriptBox["L", "2"]]}], ")"}]}], "-", "\[Lambda]", "+", 
          RowBox[{"2", "*", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               SuperscriptBox["a", "2"], 
               SuperscriptBox["L", "2"]]}], ")"}], "2"], "*", "a", "*", "m", "*",
            "\[Omega]"}], "-", 
          RowBox[{
           SuperscriptBox["a", "2"], "*", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               SuperscriptBox["a", "2"], 
               SuperscriptBox["L", "2"]]}], ")"}], "2"], "*", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}], "/", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Delta", "[", 
        RowBox[{"r", ",", " ", "a", ",", " ", "M", ",", " ", "L"}], "]"}], 
       ")"}], "2"]}]}], ";"}], " ", "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "functions", " ", "analytic", " ", "at", " ", "event", " ", "horizon"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F1Hor", "[", 
    RowBox[{
    "r_", ",", " ", "a_", ",", " ", "M_", ",", " ", "L_", ",", " ", "s_"}], 

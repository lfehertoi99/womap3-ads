Cell[CellGroupData[{

Cell["\<\
Computing the roots of the indicial equation and generating the coefficients \
of the Frobenius expansion to given order\
\>", "Subsection",
 CellChangeTimes->{{3.9785855301061897`*^9, 
  3.97858554610602*^9}},ExpressionUUID->"4aff421d-a0f0-9f40-ad1f-\
58736248239b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "HorizonExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HorizonExpansion", "[", 
   RowBox[{
   "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
    "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", " ", "\n",
   "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "F1", ",", " ", "F2", ",", " ", "indicial"}], 
     "}"}], ",", "\n", "\t ", 
    RowBox[{
     RowBox[{"F1", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F1expr"}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{"F2", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", " ", "F2expr"}], "]"}]}], ";", "\n", 
     "\t", "\n", "\t ", 
     RowBox[{"F1coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficient", "[", 
         RowBox[{"F1", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", 
     RowBox[{"F2coeffs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"kthCoefficient", "[", 
         RowBox[{"F2", ",", " ", "r", ",", " ", "r0", ",", " ", "n"}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0", ",", " ", "maxOrder"}], "}"}]}], "]"}]}],
      ";", "\n", "     ", "\n", "     ", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F2coeffs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"F1coeffs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", " ", "1"}], 
       "}"}]}], ";", "\n", "     ", 
     RowBox[{"polyVar", " ", "=", " ", 
      RowBox[{"Unique", "[", "x", "]"}]}], ";", "\n", "\t", 
     RowBox[{"poly", " ", "=", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"coeffs", "[", 
          RowBox[{"[", 
           RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
         RowBox[{"polyVar", "^", "k"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"root1", " ", "=", " ", 
      RowBox[{"polyVar", " ", "/.", " ", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], "]"}],
         "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", "\t", 
     RowBox[{"root2", " ", "=", " ", 
      RowBox[{"polyVar", " ", "/.", " ", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"poly", " ", "==", " ", "0"}], ",", " ", "polyVar"}], "]"}],
         "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "\t", 
     RowBox[{"indicial", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"poly", " ", "/.", " ", 
          RowBox[{"polyVar", " ", "->", " ", "n"}]}], "]"}]}], "]"}]}], ";", 
     "\n", "   ", "\n", "     ", "\n", "\t ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "A0"}], ";", "  ", "\n",
      "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"Recursively", " ", "compute", " ", "coefficients"}], " ", 
      "*)"}], "\n", "  ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
       RowBox[{"k", " ", "<=", " ", 
        RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"k", "++"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sum", "[", "\n", "       ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"root2", " ", "+", " ", "i"}], ")"}], " ", 
                 RowBox[{"F2coeffs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], " ", "+",
                 " ", 
                RowBox[{"F1coeffs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ")"}], "*", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", "\n", 
             "       ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"k", " ", "-", " ", "2"}]}], "}"}]}], "\n", "    ", 
            "]"}]}], " ", "/", " ", 
          RowBox[{"indicial", "[", 
           RowBox[{"root2", " ", "+", " ", "k", " ", "-", " ", "1"}], 
           "]"}]}]}], ";"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"root1", ",", " ", "root2", ",", " ", "A"}], "}"}]}]}], "\n", 
   "  ", "]"}]}]}], "Code",
 CellChangeTimes->{{3.9730613418171597`*^9, 3.973061369298456*^9}, {
   3.97306141844766*^9, 3.973061571334193*^9}, {3.973061796171379*^9, 
   3.973061928246966*^9}, {3.97306204178098*^9, 3.973062195663329*^9}, {
   3.973062285386634*^9, 3.973062285790934*^9}, {3.9730624556748047`*^9, 
   3.973062564352455*^9}, {3.973062607720257*^9, 3.973062632051242*^9}, {
   3.973062676457376*^9, 3.973062697280695*^9}, {3.9730627643177137`*^9, 
   3.9730627782532587`*^9}, {3.9730630023542223`*^9, 3.973063006915163*^9}, {
   3.9730630780164843`*^9, 3.973063135147931*^9}, {3.973063200158554*^9, 
   3.973063200282399*^9}, {3.973063291452414*^9, 3.9730633207446947`*^9}, {
   3.9730634266846523`*^9, 3.9730634673033133`*^9}, {3.9730635135675077`*^9, 
   3.9730636605520287`*^9}, {3.973063863943048*^9, 3.973063869873054*^9}, {
   3.9730639890382557`*^9, 3.973063996950776*^9}, {3.973064034364341*^9, 
   3.973064040072591*^9}, {3.97306759679358*^9, 3.9730676490828037`*^9}, {
   3.97307341292843*^9, 3.9730734145498333`*^9}, {3.973073473460248*^9, 
   3.973073480561533*^9}, {3.973073535596262*^9, 3.973073537225281*^9}, 
   3.9735864010633793`*^9, {3.97361252353915*^9, 3.973612526510652*^9}, {
   3.9742740787679653`*^9, 3.974274084951743*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"773b2af9-ce82-4821-b93a-c35c91393bf5"]
}, Open  ]]

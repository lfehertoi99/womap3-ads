Cell[CellGroupData[{

Cell["Initialisation of functions and parameters", "Subsection",
 CellChangeTimes->{{3.979114336437563*^9, 
  3.979114341375292*^9}},ExpressionUUID->"40bc0d5d-e970-be4e-b5fd-\
d43149e805f6"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "\[CapitalDelta]", ",", " ", "f0", ",", " ", "g0", ",", " ", "\[Xi]", ",", 
   " ", "F", ",", " ", "G", ",", " ", "FHorExpr", ",", " ", "GHorExpr"}], 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]", "[", "r_", "]"}], ":=", " ", 
    RowBox[{
     SuperscriptBox["k", "2"], "*", 
     RowBox[{"(", 
      RowBox[{"r", "-", "rp"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["r", "3"], "+", 
       RowBox[{"rp", "*", 
        SuperscriptBox["r", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["a", "2"], "+", 
          FractionBox["1", 
           SuperscriptBox["k", "2"]], "+", 
          SuperscriptBox["rp", "2"]}], ")"}], "*", "r"}], "+", 
       SuperscriptBox["rp", "3"], "+", 
       RowBox[{"rp", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["a", "2"], "+", 
          FractionBox["1", 
           SuperscriptBox["k", "2"]]}], ")"}]}], "-", 
       RowBox[{"2", "*", "M", "*", 
        FractionBox["1", 
         SuperscriptBox["k", "2"]]}]}], ")"}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[CapitalXi]", ":=", 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["a", "2"], "*", 
       SuperscriptBox["k", "2"]}]}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]", "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "*", 
      FractionBox["\[CapitalXi]", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}]], "*", 
      
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Omega]", "*", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           SuperscriptBox["a", "2"]}], ")"}]}], "-", 
        RowBox[{"a", "*", "m"}]}], ")"}]}]}], ";"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "symbols", " ", "for", " ", "f0", " ", "and", " ", "g0", " ", "to", " ", 
    "check", " ", "that", " ", "indicial", " ", "roots", " ", "are", " ", 
    "correct"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"f0", "=", 
   RowBox[{"(", 
    RowBox[{"1", "+", "s"}], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g0", "=", 
    RowBox[{"\[Xi]", 
     RowBox[{"(", 
      RowBox[{"s", "-", "\[Xi]"}], ")"}]}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Radial", " ", "ODE", " ", 
      RowBox[{"is", " ", "\\", 
       RowBox[{"alpha", "''"}]}], 
      RowBox[{"(", "r", ")"}]}], "+", 
     RowBox[{"F", 
      RowBox[{
       RowBox[{"(", "r", ")"}], "\\", 

                "\t\t\t", "]"}]}], " ", "/", " ", 
              RowBox[{"ExplicitIndicial", "[", 
               RowBox[{
               "root1Explicit", " ", "+", " ", "k", " ", "-", " ", "1"}], 
               "]"}]}]}], ";"}]}], "\n", "\t\t", "]"}], ";", "\n", "\t\t", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<symbolic root\>\"", " ", "->", " ", "root1Symbolic"}],
            ",", " ", 
           RowBox[{"\"\<explicit root\>\"", " ", "->", " ", "root1Explicit"}],
            " ", ",", " ", "A1"}], "}"}]}], "  ", "\n", "\t", "]"}]}], ";", 
      "\n", "\t", "\n", "\t", 
      RowBox[{"(*", " ", 

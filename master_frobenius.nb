   RowBox[{"{", 
    RowBox[{"\<\"Algorithm fails for root1: division by zero at k=2\"\>", ",", 
     RowBox[{"\<\"symbolic root\"\>", "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s"}], "-", 
         RowBox[{"\[Sqrt]", 

 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"G", "[", "r_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ",", "r"}], "]"}], 
          ")"}], "2"], "*", 
        RowBox[{"\[Xi]", "[", "r", "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], ")"}], "2"]], "*", 
      RowBox[{"(", 

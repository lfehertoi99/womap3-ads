Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "A1$", ",", "A2$", ",", "F1$", ",", "F2$", ",", "F1coeffs$", ",", 
     "F2coeffs$", ",", "indicial$", ",", "coeffs$", ",", "polyVar$", ",", 
     RowBox[{"poly", " ", "root1"}], ",", "root2$"}], "}"}], ",", 
   RowBox[{
    RowBox[{"F1$", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", "r", "}"}], ",", "F1exp"}], "]"}]}], ";", 
    RowBox[{"F2$", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", "r", "}"}], ",", "F2exp"}], "]"}]}], ";", 
    RowBox[{"F1coeffs$", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"kthCoefficient", "[", 
        RowBox[{"F1$", ",", "r", ",", "rp", ",", "n"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"F2coeffs$", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"kthCoefficient", "[", 
        RowBox[{"F2$", ",", "r", ",", "rp", ",", "n"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"coeffs$", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
       "F2coeffs$", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
       RowBox[{
        RowBox[{
        "F1coeffs$", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-",
         "1"}], ",", "1"}], "}"}]}], ";", 
    RowBox[{"polyVar$", "=", 
     RowBox[{"Unique", "[", "x", "]"}]}], ";", 
    RowBox[{"poly", "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], "2"], 
      RowBox[{
       RowBox[{"coeffs$", "\[LeftDoubleBracket]", 
        RowBox[{"k", "+", "1"}], "\[RightDoubleBracket]"}], " ", 
       SuperscriptBox["polyVar$", "k"]}]}]}], ";", 
    RowBox[{"root1", "=", 
     RowBox[{"polyVar$", "/.", "\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"poly", "\[Equal]", "0"}], ",", "polyVar$"}], "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}]}]}], ";", 
    RowBox[{"root2$", "=", 
     RowBox[{"polyVar$", "/.", "\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"poly", "\[Equal]", "0"}], ",", "polyVar$"}], "]"}], "\[LeftDoubleBracket]",
        "2", "\[RightDoubleBracket]"}]}]}], ";", 
    RowBox[{"indicial$", "=", 
     RowBox[{"Function", "[", 
      RowBox[{"n$", ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"poly", "/.", "\[VeryThinSpace]", 
         RowBox[{"polyVar$", "\[Rule]", "n$"}]}], "]"}]}], "]"}]}], ";", 
    RowBox[{"A1$", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"3", "+", "1"}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"A1$", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=",
      "A0"}], ";", 
    RowBox[{"A2$", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"3", "+", "1"}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"A2$", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=",
      "A0"}], ";", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "2"}], ",", 
      RowBox[{"k", "\[LessEqual]", 
       RowBox[{"3", "+", "1"}]}], ",", 
      RowBox[{"k", "++"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"A1$", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}],
         "=", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "0"}], 
            RowBox[{"k", "-", "2"}]], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"root1", "+", "i"}], ")"}], " ", 
               RowBox[{"F2coeffs$", "\[LeftDoubleBracket]", 
                RowBox[{"k", "-", "i"}], "\[RightDoubleBracket]"}]}], "+", 
              RowBox[{"F1coeffs$", "\[LeftDoubleBracket]", 
               RowBox[{"k", "-", "i"}], "\[RightDoubleBracket]"}]}], ")"}], " ", 
            RowBox[{"A1$", "\[LeftDoubleBracket]", 
             RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}]}], 
          RowBox[{"indicial$", "[", 
           RowBox[{"root1", "+", "k", "-", "1"}], "]"}]]}]}], ";"}]}], "]"}], 
    ";", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "2"}], ",", 
      RowBox[{"k", "\[LessEqual]", 
       RowBox[{"3", "+", "1"}]}], ",", 
      RowBox[{"k", "++"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"A2$", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}],
         "=", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "0"}], 
            RowBox[{"k", "-", "2"}]], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"root2$", "+", "i"}], ")"}], " ", 
               RowBox[{"F2coeffs$", "\[LeftDoubleBracket]", 
                RowBox[{"k", "-", "i"}], "\[RightDoubleBracket]"}]}], "+", 
              RowBox[{"F1coeffs$", "\[LeftDoubleBracket]", 
               RowBox[{"k", "-", "i"}], "\[RightDoubleBracket]"}]}], ")"}], " ", 
            RowBox[{"A2$", "\[LeftDoubleBracket]", 
             RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}]}], 
          RowBox[{"indicial$", "[", 
           RowBox[{"root2$", "+", "k", "-", "1"}], "]"}]]}]}], ";"}]}], "]"}],
     ";", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"root1", ",", "A1$"}], "}"}], ",", 

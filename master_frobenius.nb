              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", 
        "2"}]}], ";", "\n", "\t", 
      RowBox[{"root2", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], "^",
              "2"}], " ", "-", " ", 
            RowBox[{"4", " ", 
             RowBox[{"F2coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", 
        "2"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"A1", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root1", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "F1coeffs", ",",
          " ", "F2coeffs"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"A2", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root2", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "F1coeffs", ",",
          " ", "F2coeffs"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"sol1", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{"A1", ",", " ", "root1", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"sol2", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{"A2", ",", " ", "root2", ",", " ", "r", ",", " ", "r0"}], 

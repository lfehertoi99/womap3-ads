          RowBox[{"k", "++"}], ",", "\n", "\t\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"A2", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "=", " ", "\n", 
            "\t\t\t\t", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "\[Mu]2"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]2"}], 
                 ")"}], "*", 
                RowBox[{"A2", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], " ", "+", "\n", "\t\t\t\t", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Lambda]2", "*", 
                    RowBox[{"F1coeffs", "[", 

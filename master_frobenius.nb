Cell["\<\
The code for the recursive formula used to determine coefficients used to \
look like this:\
\>", "Text",
 CellChangeTimes->{{3.978683126632349*^9, 
  3.978683144298769*^9}},ExpressionUUID->"da6c9684-1b20-ac4c-88ae-\
4d3a52bf7cef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
    RowBox[{"k", " ", "<=", " ", 
     RowBox[{"maxOrder", " ", "+", " ", "1"}]}], ",", " ", 
    RowBox[{"k", "++"}], ",", "\n", "\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{"A2", "[", 
       RowBox[{"[", "k", "]"}], "]"}], " ", "=", "\n", "\t\t", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", " ", "-", " ", "\[Mu]2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"k", " ", "-", " ", "1", " ", "-", " ", "\[Mu]2"}], ")"}], 
          "*", 
          RowBox[{"A2", "[", 
           RowBox[{"[", 
            RowBox[{"k", " ", "-", " ", "1"}], "]"}], "]"}]}], " ", "+", "\n",
          "\t\t", 
         RowBox[{"Sum", "[", "\n", "\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Lambda]2", "*", 
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], " ", "+", " ", 
              RowBox[{"F2coeffs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"k", " ", "-", " ", "i", " ", "-", " ", "\[Mu]2"}], 
                ")"}], "*", 
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", 
                 RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}]}]}], ")"}], "*", 
            RowBox[{"A2", "[", 
             RowBox[{"[", 
              RowBox[{"k", " ", "-", " ", "i"}], "]"}], "]"}]}], ",", " ", 
           "\n", "\t\t", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"k", " ", "-", " ", "1"}]}], "}"}]}], "\n", "\t\t", 
          "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"k", "*", 
         RowBox[{"(", 
          RowBox[{"f10", " ", "+", " ", 
           RowBox[{"2", "\[Times]", "\[Lambda]2"}]}], ")"}]}], ")"}]}]}], 
     ";"}]}], "\n", "\t\t", "]"}], ";"}]], "Code",
 CellChangeTimes->{3.978683119845772*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"a359cce0-8a98-9c40-a6da-ffe67c4b5c9a"],

Cell["\<\
I believe that this piece of code was imprecise for the following reason:
- We start from k=2 because objects in the array A[[k]] have positions \
starting from 1. However, the recursive formula (according to Olver) \
features, on the left hand side, the quantity (f_{10}+2\\lambda)k \\cdot a_k, \
so when determining the k-th coefficient we have to divide by k. This is not \
correctly implemented because we determine the (k+1)-th coefficient A[[k]] \
but divide by k.
- I cannot definitively say that there was an imprecision inside the sum as \
well, but I chose to invert the order of indices because I think it resembles \
the formula I wrote in the overleaf and it makes it easier for me to see that \
it is correct. \
\>", "Text",
 CellChangeTimes->{{3.978683153808571*^9, 3.978683392465233*^9}, {
   3.9786834835567913`*^9, 3.9786835120467205`*^9}, {3.9786836110366135`*^9, 
   3.978683628064333*^9}, {3.9786836873400707`*^9, 3.978683687652956*^9}, {
   3.978683902746151*^9, 3.9786839503336926`*^9}, {3.978684023162918*^9, 
   3.978684106779051*^9}, 3.978684317998394*^9, {3.978684498934452*^9, 
   3.9786845847308216`*^9}, {3.9787482268924236`*^9, 
   3.978748236439892*^9}},ExpressionUUID->"9bf303c4-809c-0e48-86f1-\
39e5463e2af5"]
}, Open  ]]
}, Open  ]],


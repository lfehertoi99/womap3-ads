Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "AngularExpansion", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AngularExpansion", "[", 
    RowBox[{
    "A0_", ",", " ", "maxOrder_Integer", ",", " ", "F1expr_", ",", " ", 
     "F2expr_", ",", " ", "r_", ",", " ", "r0_"}], "]"}], " ", ":=", "\n", 
   "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "A1", ",", " ", "A2", ",", " ", "F1coeffs", ",", " ", "F2coeffs", ",", 
       " ", "indicial", ",", " ", "roots", ",", " ", "root1", ",", " ", 
       "root2", ",", " ", "result1", ",", " ", "result2", ",", " ", "k", ",", 
       " ", "sol1", ",", " ", "sol2"}], "}"}], ",", "\n", "\t", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "twice", " ", "the", " ", "amount", " ", "of", " ", 
       "coefficients", " ", "for", " ", "safety"}], " ", "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"F1coeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"F1expr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"F2coeffs", " ", "=", " ", 
       RowBox[{"SeriesCoefficientList", "[", 
        RowBox[{"F2expr", ",", " ", "r", ",", " ", "r0", ",", " ", 
         RowBox[{"2", "*", "maxOrder"}]}], "]"}]}], ";", "\n", "\t", "\n", 
      "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "use", " ", "quadratic", " ", "formula", " ", "instead", " ", "of", " ",
         "Solve", " ", "because", " ", "cheaper"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"root1", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], "^",
              "2"}], " ", "-", " ", 
            RowBox[{"4", " ", 
             RowBox[{"F2coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", 
        "2"}]}], ";", "\n", "\t", 
      RowBox[{"root2", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"F1coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"F1coeffs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], "^",
              "2"}], " ", "-", " ", 
            RowBox[{"4", " ", 
             RowBox[{"F2coeffs", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ")"}], "/", 
        "2"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"A1", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root1", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "F1coeffs", ",",
          " ", "F2coeffs"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"A2", " ", "=", " ", 
       RowBox[{"ComputeFrobeniusCoeffs", "[", 
        RowBox[{
        "root2", ",", " ", "A0", ",", " ", "maxOrder", ",", " ", "F1coeffs", ",",
          " ", "F2coeffs"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"sol1", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{"A1", ",", " ", "root1", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"sol2", " ", "=", " ", 
       RowBox[{"FrobeniusSolution", "[", 
        RowBox[{"A2", ",", " ", "root2", ",", " ", "r", ",", " ", "r0"}], 
        "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<root\>\"", " ", "->", " ", "root1"}], ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A1"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol1"}]}], "|>"}], ",", 
        "\n", "\t", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<root\>\"", " ", "->", " ", "root2"}], ",", " ", 
          RowBox[{"\"\<coeffs\>\"", " ", "->", " ", "A2"}], ",", " ", 
          RowBox[{"\"\<sol\>\"", " ", "->", " ", "sol2"}]}], "|>"}]}], 
       "}"}]}]}], "\n", "]"}]}], ";"}]}], "Code",

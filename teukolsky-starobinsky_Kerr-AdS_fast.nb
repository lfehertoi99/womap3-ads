         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], ",", 
        RowBox[{"rr1", "=", 
         RowBox[{"r1", "[", "x", "]"}]}], ",", "r0", ",", "wt"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"2", "*", "Sp"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"r0", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"S", ">", "0"}], ",", 
          RowBox[{"r0POS", "[", 
           RowBox[{"x", ",", "Sp"}], "]"}], ",", 
          RowBox[{"r0NEG", "[", 
           RowBox[{"x", ",", "Sp"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"first", " ", "2"}], "|", "S", "|", "applications"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"pair", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"S", ">", "0"}], ",", 
            RowBox[{"Step", "[", 
             
             RowBox[{"\"\<L0\>\"", ",", "pair", ",", "Sp", ",", "r0", ",", 
              "rr1"}], "]"}], ",", 
            RowBox[{"Step", "[", 
             
             RowBox[{"\"\<L0dag\>\"", ",", "pair", ",", "Sp", ",", "r0", ",", 
              "rr1"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"wt", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sq", "[", "x", "]"}], "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[CapitalDelta]\[Theta]", "[", "x", "]"}], "]"}]}], 
          ")"}], "^", "n"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pair", "=", 
        RowBox[{"smulp", "[", 
         RowBox[{"wt", ",", "pair"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"second", " ", "2"}], "|", "S", "|", "applications"}], 
        "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"pair", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"S", ">", "0"}], ",", 
            RowBox[{"Step", "[", 
             
             RowBox[{"\"\<L0dag\>\"", ",", "pair", ",", "Sp", ",", "r0", ",", 
              "rr1"}], "]"}], ",", 
            RowBox[{"Step", "[", 
             
             RowBox[{"\"\<L0\>\"", ",", "pair", ",", "Sp", ",", "r0", ",", 
              "rr1"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"pair", "=", 
        RowBox[{"smulp", "[", 
         RowBox[{"wt", ",", "pair"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Cancel", "@", 
        RowBox[{"Together", "@", 
         RowBox[{"pairToExpr", "[", "pair", "]"}]}]}]}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"TSang", "[", "S_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"output", "=", "NULL"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TS", "=", 
      RowBox[{"TSangPrep", "[", "S", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"zerothOrder", " ", "=", " ", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"TS", ",", 
        RowBox[{"AA", "[", "x", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"firstOrder", "=", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"TS", ",", 
        RowBox[{
         RowBox[{"AA", "'"}], "[", "x", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"firstOrder", "==", "0"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"zerothOrder", ",", "x"}], "]"}], "==", "0"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"output", "=", "zerothOrder"}], ";"}]}], " ", 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "output"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Code",

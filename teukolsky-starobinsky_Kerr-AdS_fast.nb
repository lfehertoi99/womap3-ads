         RowBox[{"{", "n", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"wt", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sq", "[", "x", "]"}], "*", 

         RowBox[{"second", " ", "2"}], "|", "S", "|", "applications"}], 
        "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"pair", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"S", ">", "0"}], ",", 
            RowBox[{"Step", "[", 
             
             RowBox[{"\"\<L0dag\>\"", ",", "pair", ",", "Sp", ",", "r0", ",", 

    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sp", "=", 
         RowBox[{"Abs", "[", "S", "]"}]}], ",", "n", ",", 
        RowBox[{"pair", "=", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], ",", 
        RowBox[{"rr1", "=", 
         RowBox[{"r1", "[", "x", "]"}]}], ",", "r0", ",", "wt"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"2", "*", "Sp"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"r0", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"S", ">", "0"}], ",", 
          RowBox[{"r0POS", "[", 
           RowBox[{"x", ",", "Sp"}], "]"}], ",", 
          RowBox[{"r0NEG", "[", 
           RowBox[{"x", ",", "Sp"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"first", " ", "2"}], "|", "S", "|", "applications"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"pair", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"S", ">", "0"}], ",", 
            RowBox[{"Step", "[", 
             
             RowBox[{"\"\<L0\>\"", ",", "pair", ",", "Sp", ",", "r0", ",", 
